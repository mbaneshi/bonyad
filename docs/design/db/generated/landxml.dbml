Table landxml.chain {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value text[] [not null, note: 'A text value that is a space delimited list of CgPoint names that form a linear connected chain. example: represents a linear connection between CgPoint name 1, 23, 45 and 34. Space-delimited list of names.; source: XSD text content; type ChainType']
  name text [note: 'Chain name; the XSD gives no description.; source: XSD Chain/@name; type xs:string']
  "desc" text [note: 'Chain desc; the XSD gives no description.; source: XSD Chain/@desc; type xs:string']
  code text [note: 'Chain code; the XSD gives no description.; source: XSD Chain/@code; type xs:string']
  state text [note: 'Chain state; the XSD gives no description.; source: XSD Chain/@state; type stateType']
  point_geometry text [note: 'Chain pointGeometry; the XSD gives no description.; source: XSD Chain/@pointGeometry; type pointGeometryType']
  dtm_attribute text [note: 'Chain DTMAttribute; the XSD gives no description.; source: XSD Chain/@DTMAttribute; type DTMAttributeType']
  time_stamp timestamptz [note: 'Chain timeStamp; the XSD gives no description.; source: XSD Chain/@timeStamp; type xs:dateTime']
  role text [note: 'Chain role; the XSD gives no description.; source: XSD Chain/@role; type surveyRoleType']
  station float8 [note: 'Represents the actual measured distance along the geometry in numeric decimal form expressed in linear units. Also known as the internal station value where no station equations are applied. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations.; source: XSD Chain/@station; type station']
  zone text [note: 'Chain zone; the XSD gives no description.; source: XSD Chain/@zone; type xs:string']
  status text [note: 'Chain status; the XSD gives no description.; source: XSD Chain/@status; type observationStatusType']
  Note: 'Chain: A text value that is a space delimited list of CgPoint names that form a linear connected chain. example: represents a linear connection between CgPoint name 1, 23, 45 and 34.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.pipe {
