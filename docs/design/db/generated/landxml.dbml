  }
}

Table landxml.f {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value int[] [not null, note: 'A surface face. It contains a space delimited list of "id" references for 3 (TIN) or 4 (grid) surface "P" points. Space-delimited list in the source text.; source: XSD text content; type FaceType']
  i int [note: 'F i; the XSD gives no description.; source: XSD F/@i; type xs:integer']
  n int[] [note: 'F n; the XSD gives no description. Space-delimited list in the source text.; source: XSD F/@n; type FaceType']
  b int [note: 'F b; the XSD gives no description.; source: XSD F/@b; type xs:positiveInteger']
  Note: 'F: A surface face. It contains a space delimited list of "id" references for 3 (TIN) or 4 (grid) surface "P" points.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.feature {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.feature']
  owner uuid [note: 'The element this Feature is attached to (null for a top-level or nested Feature, see parent_feature).; ref to any; source: not in the XSD: linkage added because Feature is listed under nearly every element']
  parent_feature uuid [note: 'The Feature that contains this one when Features are nested.; ref to landxml.feature; source: not in the XSD: linkage for nested Feature elements']
  name text [note: 'Feature name; the XSD gives no description.; source: XSD Feature/@name; type xs:string']
  code text [note: 'Feature code; the XSD gives no description.; source: XSD Feature/@code; type xs:string']
  source text [note: 'Feature source; the XSD gives no description.; source: XSD Feature/@source; type xs:anySimpleType']
  Note: 'Feature: Used to include additional information that is not explicitly defined by the LandXML schema, Feature may contain one or more Property, DocFileRef or nested Feature elements. NOTE: to allow any valid content, the explicit definitions for Property, DocFileRef and Feature have been commented out, but are still expected in common use.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

