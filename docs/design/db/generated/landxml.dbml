  survey_horizontal_order text [note: 'CgPoint surveyHorizontalOrder; the XSD gives no description.; source: XSD CgPoint/@surveyHorizontalOrder; type xs:string']
  survey_vertical_order text [note: 'CgPoint surveyVerticalOrder; the XSD gives no description.; source: XSD CgPoint/@surveyVerticalOrder; type xs:string']
