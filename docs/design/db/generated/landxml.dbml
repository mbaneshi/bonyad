  coordinates_y float8 [note: 'The element\'s coordinate text "northing easting [elevation]" stored as point3 with x = easting (second value), y = northing (first value), z = elevation (null when absent); null when only a pntRef is given. Lengths stay in the file\'s declared unit. (y); source: text content (Point2dReq)']
  coordinates_z float8 [note: 'The element\'s coordinate text "northing easting [elevation]" stored as point3 with x = easting (second value), y = northing (first value), z = elevation (null when absent); null when only a pntRef is given. Lengths stay in the file\'s declared unit. (z); source: text content (Point2dReq)']
