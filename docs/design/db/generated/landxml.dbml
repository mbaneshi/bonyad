  dir_start float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Curve/@dirStart; type direction']
  external float8 [note: 'Curve external; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Curve/@external; type xs:double']
  length float8 [note: 'Curve length; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Curve/@length; type xs:double']
  mid_ord float8 [note: 'Curve midOrd; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Curve/@midOrd; type xs:double']
  name text [note: 'Curve name; the XSD gives no description.; source: XSD Curve/@name; type xs:string']
  radius float8 [note: 'Curve radius; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Curve/@radius; type xs:double']
  sta_start float8 [note: 'Curve staStart; the XSD gives no description.; source: XSD Curve/@staStart; type xs:double']
  state text [note: 'Curve state; the XSD gives no description.; source: XSD Curve/@state; type stateType']
  tangent float8 [note: 'Curve tangent; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Curve/@tangent; type xs:double']
  o_id text [note: 'Curve oID; the XSD gives no description.; source: XSD Curve/@oID; type xs:string']
  note text [note: 'Curve note; the XSD gives no description.; source: XSD Curve/@note; type xs:string']
  start_x float8 [note: 'Represents a 2D or 3D Starting or beginning Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only start_pnt_ref is given). (x); source: Curve/Start text content (Point3dOpt)']
  start_y float8 [note: 'Represents a 2D or 3D Starting or beginning Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only start_pnt_ref is given). (y); source: Curve/Start text content (Point3dOpt)']
  start_z float8 [note: 'Represents a 2D or 3D Starting or beginning Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only start_pnt_ref is given). (z); source: Curve/Start text content (Point3dOpt)']
  start_name text [note: 'Start name; the XSD gives no description.; source: XSD Start/@name; type xs:string']
  start_desc text [note: 'Start desc; the XSD gives no description.; source: XSD Start/@desc; type xs:string']
  start_code text [note: 'Start code; the XSD gives no description.; source: XSD Start/@code; type xs:string']
  start_state text [note: 'Start state; the XSD gives no description.; source: XSD Start/@state; type stateType']
  start_pnt_ref uuid [note: 'A reference name value referring to a PointType derived name attribute. An attribute if this type contains the value of a PointType derived element "name" attribute that exists elsewhere the instance data. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.cg_point; source: XSD Start/@pntRef; type pointNameRef']
  start_feature_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.feature; source: XSD Start/@featureRef; type featureNameRef']
  start_point_geometry text [note: 'Start pointGeometry; the XSD gives no description.; source: XSD Start/@pointGeometry; type pointGeometryType']
  start_dtm_attribute text [note: 'Start DTMAttribute; the XSD gives no description.; source: XSD Start/@DTMAttribute; type DTMAttributeType']
  start_time_stamp timestamptz [note: 'Start timeStamp; the XSD gives no description.; source: XSD Start/@timeStamp; type xs:dateTime']
  start_role text [note: 'Start role; the XSD gives no description.; source: XSD Start/@role; type surveyRoleType']
  start_determined_time_stamp timestamptz [note: 'Start determinedTimeStamp; the XSD gives no description.; source: XSD Start/@determinedTimeStamp; type xs:dateTime']
  start_ellipsoid_height float8 [note: 'Represents the National Geodedic Survey ellipsiod height expressed in the unit height attribute value. Ellipsoid height in the unit given by Units elevationUnit; kept unconverted.; source: XSD Start/@ellipsoidHeight; type ellipsoidHeightType']
