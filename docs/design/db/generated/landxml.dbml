  crv_type text [note: 'Curve crvType; the XSD gives no description.; source: XSD Curve/@crvType; type curveType']
  delta float8 [note: 'Represents a normalized angular value in the specified Angular units. Assume 0 degrees = east. Stored in radians. The file value is expressed in Units angularUnit (default radians) and is converted at the import boundary. The XSD defines it as measured counter-clockwise from east (0 = east). Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Curve/@delta; type angle']
  "desc" text [note: 'Curve desc; the XSD gives no description.; source: XSD Curve/@desc; type xs:string']
