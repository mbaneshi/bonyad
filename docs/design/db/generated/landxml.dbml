Table landxml.spiral {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: landxml.conn_spiral, landxml.in_spiral, landxml.out_spiral, landxml.spiral']
  container uuid [note: 'The landxml.coord_geom row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.coord_geom; source: not in the XSD: linkage added because this type is stored as an object (it is the base of other types)']
  length float8 [not null, note: 'Spiral length; the XSD gives no description.; source: XSD Spiral/@length; type xs:double']
  radius_end float8 [not null, note: 'Spiral radiusEnd; the XSD gives no description.; source: XSD Spiral/@radiusEnd; type xs:double']
  radius_start float8 [not null, note: 'Spiral radiusStart; the XSD gives no description.; source: XSD Spiral/@radiusStart; type xs:double']
  rot text [not null, note: 'Spiral rot; the XSD gives no description.; source: XSD Spiral/@rot; type clockwise']
  spi_type text [not null, note: 'Spiral spiType; the XSD gives no description.; source: XSD Spiral/@spiType; type spiralType']
  chord float8 [note: 'Spiral chord; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@chord; type xs:double']
  constant float8 [note: 'Spiral constant; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@constant; type xs:double']
  "desc" text [note: 'Spiral desc; the XSD gives no description.; source: XSD Spiral/@desc; type xs:string']
  dir_end float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@dirEnd; type direction']
  dir_start float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@dirStart; type direction']
  name text [note: 'Spiral name; the XSD gives no description.; source: XSD Spiral/@name; type xs:string']
  theta float8 [note: 'Represents a normalized angular value in the specified Angular units. Assume 0 degrees = east. Stored in radians. The file value is expressed in Units angularUnit (default radians) and is converted at the import boundary. The XSD defines it as measured counter-clockwise from east (0 = east). Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@theta; type angle']
  total_y float8 [note: 'Spiral totalY; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@totalY; type xs:double']
  total_x float8 [note: 'Spiral totalX; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@totalX; type xs:double']
  sta_start float8 [note: 'Spiral staStart; the XSD gives no description.; source: XSD Spiral/@staStart; type xs:double']
  state text [note: 'Spiral state; the XSD gives no description.; source: XSD Spiral/@state; type stateType']
  tan_long float8 [note: 'Spiral tanLong; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@tanLong; type xs:double']
  tan_short float8 [note: 'Spiral tanShort; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Spiral/@tanShort; type xs:double']
  o_id text [note: 'Spiral oID; the XSD gives no description.; source: XSD Spiral/@oID; type xs:string']
  start_x float8 [note: 'Represents a 2D or 3D Starting or beginning Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only start_pnt_ref is given). (x); source: Spiral/Start text content (Point3dOpt)']
  start_y float8 [note: 'Represents a 2D or 3D Starting or beginning Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only start_pnt_ref is given). (y); source: Spiral/Start text content (Point3dOpt)']
  start_z float8 [note: 'Represents a 2D or 3D Starting or beginning Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only start_pnt_ref is given). (z); source: Spiral/Start text content (Point3dOpt)']
  start_name text [note: 'Start name; the XSD gives no description.; source: XSD Start/@name; type xs:string']
  start_desc text [note: 'Start desc; the XSD gives no description.; source: XSD Start/@desc; type xs:string']
  start_code text [note: 'Start code; the XSD gives no description.; source: XSD Start/@code; type xs:string']
  start_state text [note: 'Start state; the XSD gives no description.; source: XSD Start/@state; type stateType']
  start_pnt_ref uuid [note: 'A reference name value referring to a PointType derived name attribute. An attribute if this type contains the value of a PointType derived element "name" attribute that exists elsewhere the instance data. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.cg_point; source: XSD Start/@pntRef; type pointNameRef']
  start_feature_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.feature; source: XSD Start/@featureRef; type featureNameRef']
  start_point_geometry text [note: 'Start pointGeometry; the XSD gives no description.; source: XSD Start/@pointGeometry; type pointGeometryType']
  start_dtm_attribute text [note: 'Start DTMAttribute; the XSD gives no description.; source: XSD Start/@DTMAttribute; type DTMAttributeType']
  start_time_stamp timestamptz [note: 'Start timeStamp; the XSD gives no description.; source: XSD Start/@timeStamp; type xs:dateTime']
  start_role text [note: 'Start role; the XSD gives no description.; source: XSD Start/@role; type surveyRoleType']
  start_determined_time_stamp timestamptz [note: 'Start determinedTimeStamp; the XSD gives no description.; source: XSD Start/@determinedTimeStamp; type xs:dateTime']
  start_ellipsoid_height float8 [note: 'Represents the National Geodedic Survey ellipsiod height expressed in the unit height attribute value. Ellipsoid height in the unit given by Units elevationUnit; kept unconverted.; source: XSD Start/@ellipsoidHeight; type ellipsoidHeightType']
  start_latitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD Start/@latitude; type latLongAngle']
  start_longitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD Start/@longitude; type latLongAngle']
  start_zone text [note: 'Start zone; the XSD gives no description.; source: XSD Start/@zone; type xs:string']
  start_northing_std_error float8 [note: 'Start northingStdError; the XSD gives no description.; source: XSD Start/@northingStdError; type xs:double']
  start_easting_std_error float8 [note: 'Start eastingStdError; the XSD gives no description.; source: XSD Start/@eastingStdError; type xs:double']
  start_elevation_std_error float8 [note: 'Start elevationStdError; the XSD gives no description.; source: XSD Start/@elevationStdError; type xs:double']
  pi_x float8 [note: 'Represents a 2D or 3D Point of Intersection. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only pi_pnt_ref is given). (x); source: Spiral/PI text content (Point3dOpt)']
  pi_y float8 [note: 'Represents a 2D or 3D Point of Intersection. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only pi_pnt_ref is given). (y); source: Spiral/PI text content (Point3dOpt)']
  pi_z float8 [note: 'Represents a 2D or 3D Point of Intersection. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only pi_pnt_ref is given). (z); source: Spiral/PI text content (Point3dOpt)']
  pi_name text [note: 'PI name; the XSD gives no description.; source: XSD PI/@name; type xs:string']
