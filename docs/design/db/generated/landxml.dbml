  purpose text [note: 'Used by many of the Survey elements.; source: XSD RawObservationType/@purpose; type purposeType']
  target_height float8 [note: 'RawObservationType targetHeight; the XSD gives no description.; source: XSD RawObservationType/@targetHeight; type xs:double']
  horiz_angle float8 [note: 'Represents a normalized angular value in the specified Angular units. Assume 0 degrees = east. Stored in radians. The file value is expressed in Units angularUnit (default radians) and is converted at the import boundary. The XSD defines it as measured counter-clockwise from east (0 = east).; source: XSD RawObservationType/@horizAngle; type angle']
  slope_distance float8 [note: 'RawObservationType slopeDistance; the XSD gives no description.; source: XSD RawObservationType/@slopeDistance; type xs:double']
  zenith_angle float8 [note: 'Represents zenith angles with the 0 origin as straight up and measured in a clockwise direction in the specified Angular units. Stored in radians. The file value is expressed in the Units angular unit and is converted at the import boundary. The XSD defines it with 0 = straight up, measured clockwise.; source: XSD RawObservationType/@zenithAngle; type zenithAngle']
  horiz_distance float8 [note: 'RawObservationType horizDistance; the XSD gives no description.; source: XSD RawObservationType/@horizDistance; type xs:double']
  vert_distance float8 [note: 'RawObservationType vertDistance; the XSD gives no description.; source: XSD RawObservationType/@vertDistance; type xs:double']
  azimuth float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them.; source: XSD RawObservationType/@azimuth; type direction']
  unused boolean [note: 'RawObservationType unused; the XSD gives no description.; source: XSD RawObservationType/@unused; type xs:boolean']
  direct_face boolean [note: 'RawObservationType directFace; the XSD gives no description.; source: XSD RawObservationType/@directFace; type xs:boolean']
  coord_geom_refs text[] [note: 'name attributes. Space-delimited list of element names (name-based references).; source: XSD RawObservationType/@coordGeomRefs; type coordGeomNameRefs']
  time_stamp timestamptz [note: 'RawObservationType timeStamp; the XSD gives no description.; source: XSD RawObservationType/@timeStamp; type xs:dateTime']
  align_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.alignment; source: XSD RawObservationType/@alignRef; type alignmentNameRef']
  align_station_name text [note: 'RawObservationType alignStationName; the XSD gives no description.; source: XSD RawObservationType/@alignStationName; type xs:string']
  align_offset float8 [note: 'Represents a linear offset distance. When associated with horizontal (planametric) road or coordinate geometry, the offset is a 2D distance measured perpendicular to the road centerline or coordinate geometry used as... In the file\'s declared linear unit; kept unconverted.; source: XSD RawObservationType/@alignOffset; type offsetDistance']
  upper_stadia float8 [note: 'RawObservationType upperStadia; the XSD gives no description.; source: XSD RawObservationType/@upperStadia; type xs:double']
  rod float8 [note: 'RawObservationType rod; the XSD gives no description.; source: XSD RawObservationType/@rod; type xs:double']
  lower_stadia float8 [note: 'RawObservationType lowerStadia; the XSD gives no description.; source: XSD RawObservationType/@lowerStadia; type xs:double']
  circle_position_set float8 [note: 'RawObservationType circlePositionSet; the XSD gives no description.; source: XSD RawObservationType/@circlePositionSet; type xs:double']
  status text [note: 'RawObservationType status; the XSD gives no description.; source: XSD RawObservationType/@status; type observationStatusType']
  Note: 'RawObservationType: LandXML 1.2 `RawObservationType`; the XSD gives no description.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

