  land_xml_id int [note: 'LandXML LandXMLId; the XSD gives no description.; source: XSD LandXML/@LandXMLId; type xs:int']
  crc int [note: 'LandXML crc; the XSD gives no description.; source: XSD LandXML/@crc; type xs:integer']
  project_name text [note: 'Project name; the XSD gives no description.; source: XSD Project/@name; type xs:string']
  project_desc text [note: 'Project desc; the XSD gives no description.; source: XSD Project/@desc; type xs:string']
  project_state text [note: 'Project state; the XSD gives no description.; source: XSD Project/@state; type stateType']
  Note: 'LandXML: LandXML 1.2 `LandXML`; the XSD gives no description.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

