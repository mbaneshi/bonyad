Table landxml.annotation {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  type text [not null, note: 'An Annotation will be a specific type within a jurisdiction.; source: XSD Annotation/@type; type annotationType']
  name text [note: 'Annotation name; the XSD gives no description.; source: XSD Annotation/@name; type xs:string']
  "desc" text [note: 'Annotation desc; the XSD gives no description.; source: XSD Annotation/@desc; type xs:string']
  pcl_ref text[] [note: 'name attributes. Space-delimited list of element names (name-based references).; source: XSD Annotation/@pclRef; type parcelNameRefs']
  Note: 'Annotation: Annotation is a descriptive string use to describe an action on survey'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.application {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.application']
  container uuid [note: 'The landxml.landxml row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.landxml; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  name text [not null, note: 'Application name; the XSD gives no description.; source: XSD Application/@name; type xs:string']
  "desc" text [note: 'Application desc; the XSD gives no description.; source: XSD Application/@desc; type xs:string']
  manufacturer text [note: 'Application manufacturer; the XSD gives no description.; source: XSD Application/@manufacturer; type xs:string']
  version text [note: 'Application version; the XSD gives no description.; source: XSD Application/@version; type xs:string']
  manufacturer_url text [note: 'Application manufacturerURL; the XSD gives no description.; source: XSD Application/@manufacturerURL; type xs:string']
  time_stamp timestamptz [note: 'Application timeStamp; the XSD gives no description.; source: XSD Application/@timeStamp; type xs:dateTime']
  Note: 'Application: Optional element to identify the software that was used to create the file.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table landxml.author {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value text [not null, note: 'Optional element to identify the source of the file.; source: XSD text content; type xs:string']
  created_by text [note: 'Author createdBy; the XSD gives no description.; source: XSD Author/@createdBy; type xs:string']
  created_by_email text [note: 'Author createdByEmail; the XSD gives no description.; source: XSD Author/@createdByEmail; type xs:string']
  company text [note: 'Author company; the XSD gives no description.; source: XSD Author/@company; type xs:string']
  company_url text [note: 'Author companyURL; the XSD gives no description.; source: XSD Author/@companyURL; type xs:string']
  time_stamp timestamptz [note: 'Author timeStamp; the XSD gives no description.; source: XSD Author/@timeStamp; type xs:dateTime']
  Note: 'Author: Optional element to identify the source of the file.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.instrument_setup {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.instrument_setup']
  container uuid [note: 'The landxml.survey row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.survey; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  id text [not null, note: 'InstrumentSetup id; the XSD gives no description.; source: XSD InstrumentSetup/@id; type xs:ID']
  instrument_details_id uuid [note: 'InstrumentSetup instrumentDetailsID; the XSD gives no description. xs:IDREF: names the xs:ID `id` of another element in the same file.; ref to any; source: XSD InstrumentSetup/@instrumentDetailsID; type xs:IDREF']
  station_name text [not null, note: 'InstrumentSetup stationName; the XSD gives no description.; source: XSD InstrumentSetup/@stationName; type xs:string']
  instrument_height float8 [not null, note: 'InstrumentSetup instrumentHeight; the XSD gives no description.; source: XSD InstrumentSetup/@instrumentHeight; type xs:double']
  orientation_azimuth float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them.; source: XSD InstrumentSetup/@orientationAzimuth; type direction']
  circle_azimuth float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them.; source: XSD InstrumentSetup/@circleAzimuth; type direction']
  status text [note: 'InstrumentSetup status; the XSD gives no description.; source: XSD InstrumentSetup/@status; type observationStatusType']
  instrument_point_x float8 [note: 'Represents a 2D or 3D Point location for Survey instrument location. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only instrument_point_pnt_ref is given). (x); source: InstrumentSetup/InstrumentPoint text content (Point3dOpt)']
  instrument_point_y float8 [note: 'Represents a 2D or 3D Point location for Survey instrument location. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only instrument_point_pnt_ref is given). (y); source: InstrumentSetup/InstrumentPoint text content (Point3dOpt)']
  instrument_point_z float8 [note: 'Represents a 2D or 3D Point location for Survey instrument location. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only instrument_point_pnt_ref is given). (z); source: InstrumentSetup/InstrumentPoint text content (Point3dOpt)']
  instrument_point_name text [note: 'InstrumentPoint name; the XSD gives no description.; source: XSD InstrumentPoint/@name; type xs:string']
  instrument_point_desc text [note: 'InstrumentPoint desc; the XSD gives no description.; source: XSD InstrumentPoint/@desc; type xs:string']
  instrument_point_code text [note: 'InstrumentPoint code; the XSD gives no description.; source: XSD InstrumentPoint/@code; type xs:string']
  instrument_point_state text [note: 'InstrumentPoint state; the XSD gives no description.; source: XSD InstrumentPoint/@state; type stateType']
  instrument_point_pnt_ref uuid [note: 'A reference name value referring to a PointType derived name attribute. An attribute if this type contains the value of a PointType derived element "name" attribute that exists elsewhere the instance data. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.cg_point; source: XSD InstrumentPoint/@pntRef; type pointNameRef']
  instrument_point_feature_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.feature; source: XSD InstrumentPoint/@featureRef; type featureNameRef']
  instrument_point_point_geometry text [note: 'InstrumentPoint pointGeometry; the XSD gives no description.; source: XSD InstrumentPoint/@pointGeometry; type pointGeometryType']
  instrument_point_dtm_attribute text [note: 'InstrumentPoint DTMAttribute; the XSD gives no description.; source: XSD InstrumentPoint/@DTMAttribute; type DTMAttributeType']
  instrument_point_time_stamp timestamptz [note: 'InstrumentPoint timeStamp; the XSD gives no description.; source: XSD InstrumentPoint/@timeStamp; type xs:dateTime']
  instrument_point_role text [note: 'InstrumentPoint role; the XSD gives no description.; source: XSD InstrumentPoint/@role; type surveyRoleType']
  instrument_point_determined_time_stamp timestamptz [note: 'InstrumentPoint determinedTimeStamp; the XSD gives no description.; source: XSD InstrumentPoint/@determinedTimeStamp; type xs:dateTime']
  instrument_point_ellipsoid_height float8 [note: 'Represents the National Geodedic Survey ellipsiod height expressed in the unit height attribute value. Ellipsoid height in the unit given by Units elevationUnit; kept unconverted.; source: XSD InstrumentPoint/@ellipsoidHeight; type ellipsoidHeightType']
  instrument_point_latitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD InstrumentPoint/@latitude; type latLongAngle']
  instrument_point_longitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD InstrumentPoint/@longitude; type latLongAngle']
  instrument_point_zone text [note: 'InstrumentPoint zone; the XSD gives no description.; source: XSD InstrumentPoint/@zone; type xs:string']
  instrument_point_northing_std_error float8 [note: 'InstrumentPoint northingStdError; the XSD gives no description.; source: XSD InstrumentPoint/@northingStdError; type xs:double']
  instrument_point_easting_std_error float8 [note: 'InstrumentPoint eastingStdError; the XSD gives no description.; source: XSD InstrumentPoint/@eastingStdError; type xs:double']
  instrument_point_elevation_std_error float8 [note: 'InstrumentPoint elevationStdError; the XSD gives no description.; source: XSD InstrumentPoint/@elevationStdError; type xs:double']
  field_note text[] [note: 'Place the note as a text value between the FieldNote element tags. You may also place any valid XML structure inside this tag. Repeated element, stored as an ordered array.; source: XSD FieldNote (element); type xs:string']
  Note: 'InstrumentSetup: The Instrument setup location is defined by either a coordinate text value ("north east" or "north east elev") or a CgPoint number reference "pntRef" attribute.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table landxml.backsight {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  id text [note: 'Backsight id; the XSD gives no description.; source: XSD Backsight/@id; type xs:ID']
  azimuth float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them.; source: XSD Backsight/@azimuth; type direction']
  target_height float8 [note: 'Backsight targetHeight; the XSD gives no description.; source: XSD Backsight/@targetHeight; type xs:double']
  circle float8 [not null, note: 'Represents a normalized angular value in the specified Angular units. Assume 0 degrees = east. Stored in radians. The file value is expressed in Units angularUnit (default radians) and is converted at the import boundary. The XSD defines it as measured counter-clockwise from east (0 = east).; source: XSD Backsight/@circle; type angle']
  setup_id uuid [note: 'Backsight setupID; the XSD gives no description. xs:IDREF: names the xs:ID `id` of another element in the same file.; ref to any; source: XSD Backsight/@setupID; type xs:IDREF']
  backsight_point_x float8 [note: 'Represents a 2D or 3D location for the backsight. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only backsight_point_pnt_ref is given). (x); source: Backsight/BacksightPoint text content (Point3dOpt)']
  backsight_point_y float8 [note: 'Represents a 2D or 3D location for the backsight. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only backsight_point_pnt_ref is given). (y); source: Backsight/BacksightPoint text content (Point3dOpt)']
  backsight_point_z float8 [note: 'Represents a 2D or 3D location for the backsight. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only backsight_point_pnt_ref is given). (z); source: Backsight/BacksightPoint text content (Point3dOpt)']
  backsight_point_name text [note: 'BacksightPoint name; the XSD gives no description.; source: XSD BacksightPoint/@name; type xs:string']
  backsight_point_desc text [note: 'BacksightPoint desc; the XSD gives no description.; source: XSD BacksightPoint/@desc; type xs:string']
  backsight_point_code text [note: 'BacksightPoint code; the XSD gives no description.; source: XSD BacksightPoint/@code; type xs:string']
  backsight_point_state text [note: 'BacksightPoint state; the XSD gives no description.; source: XSD BacksightPoint/@state; type stateType']
  backsight_point_pnt_ref uuid [note: 'A reference name value referring to a PointType derived name attribute. An attribute if this type contains the value of a PointType derived element "name" attribute that exists elsewhere the instance data. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.cg_point; source: XSD BacksightPoint/@pntRef; type pointNameRef']
  backsight_point_feature_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.feature; source: XSD BacksightPoint/@featureRef; type featureNameRef']
  backsight_point_point_geometry text [note: 'BacksightPoint pointGeometry; the XSD gives no description.; source: XSD BacksightPoint/@pointGeometry; type pointGeometryType']
  backsight_point_dtm_attribute text [note: 'BacksightPoint DTMAttribute; the XSD gives no description.; source: XSD BacksightPoint/@DTMAttribute; type DTMAttributeType']
  backsight_point_time_stamp timestamptz [note: 'BacksightPoint timeStamp; the XSD gives no description.; source: XSD BacksightPoint/@timeStamp; type xs:dateTime']
  backsight_point_role text [note: 'BacksightPoint role; the XSD gives no description.; source: XSD BacksightPoint/@role; type surveyRoleType']
  backsight_point_determined_time_stamp timestamptz [note: 'BacksightPoint determinedTimeStamp; the XSD gives no description.; source: XSD BacksightPoint/@determinedTimeStamp; type xs:dateTime']
  backsight_point_ellipsoid_height float8 [note: 'Represents the National Geodedic Survey ellipsiod height expressed in the unit height attribute value. Ellipsoid height in the unit given by Units elevationUnit; kept unconverted.; source: XSD BacksightPoint/@ellipsoidHeight; type ellipsoidHeightType']
  backsight_point_latitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD BacksightPoint/@latitude; type latLongAngle']
  backsight_point_longitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD BacksightPoint/@longitude; type latLongAngle']
  backsight_point_zone text [note: 'BacksightPoint zone; the XSD gives no description.; source: XSD BacksightPoint/@zone; type xs:string']
  backsight_point_northing_std_error float8 [note: 'BacksightPoint northingStdError; the XSD gives no description.; source: XSD BacksightPoint/@northingStdError; type xs:double']
  backsight_point_easting_std_error float8 [note: 'BacksightPoint eastingStdError; the XSD gives no description.; source: XSD BacksightPoint/@eastingStdError; type xs:double']
  backsight_point_elevation_std_error float8 [note: 'BacksightPoint elevationStdError; the XSD gives no description.; source: XSD BacksightPoint/@elevationStdError; type xs:double']
  field_note text[] [note: 'Place the note as a text value between the FieldNote element tags. You may also place any valid XML structure inside this tag. Repeated element, stored as an ordered array.; source: XSD FieldNote (element); type xs:string']
  Note: 'Backsight: LandXML 1.2 `Backsight`; the XSD gives no description.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.roadway {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.roadway']
  container uuid [note: 'The landxml.roadways row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.roadways; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  name text [not null, note: 'Roadway name; the XSD gives no description.; source: XSD Roadway/@name; type xs:string']
  alignment_refs text[] [not null, note: 'name attributes. Space-delimited list of element names (name-based references).; source: XSD Roadway/@alignmentRefs; type alignmentNameRefs']
  surface_refs text[] [note: 'name attributes. Space-delimited list of element names (name-based references).; source: XSD Roadway/@surfaceRefs; type surfaceNameRefs']
  grade_model_refs text[] [note: 'name attributes. Space-delimited list of element names (name-based references).; source: XSD Roadway/@gradeModelRefs; type gradeModelNameRefs']
  sta_start float8 [note: 'Represents the actual measured distance along the geometry in numeric decimal form expressed in linear units. Also known as the internal station value where no station equations are applied. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations.; source: XSD Roadway/@staStart; type station']
  sta_end float8 [note: 'Represents the actual measured distance along the geometry in numeric decimal form expressed in linear units. Also known as the internal station value where no station equations are applied. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations.; source: XSD Roadway/@staEnd; type station']
  "desc" text [note: 'Roadway desc; the XSD gives no description.; source: XSD Roadway/@desc; type xs:string']
  road_terrain text [note: 'Roadway roadTerrain; the XSD gives no description.; source: XSD Roadway/@roadTerrain; type roadTerrainType']
  state text [note: 'Roadway state; the XSD gives no description.; source: XSD Roadway/@state; type stateType']
  Note: 'Roadway: LandXML 1.2 `Roadway`; the XSD gives no description.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

