}

Table landxml.cant {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.cant']
  container uuid [note: 'The landxml.alignment row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.alignment; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  name text [not null, note: 'Cant name; the XSD gives no description.; source: XSD Cant/@name; type xs:string']
  "desc" text [note: 'Cant desc; the XSD gives no description.; source: XSD Cant/@desc; type xs:string']
  state text [note: 'Cant state; the XSD gives no description.; source: XSD Cant/@state; type stateType']
  equilibrium_constant float8 [note: 'Cant equilibriumConstant; the XSD gives no description.; source: XSD Cant/@equilibriumConstant; type xs:double']
  applied_cant_constant float8 [note: 'Cant appliedCantConstant; the XSD gives no description.; source: XSD Cant/@appliedCantConstant; type xs:double']
  gauge float8 [not null, note: 'Cant gauge; the XSD gives no description.; source: XSD Cant/@gauge; type xs:double']
  rotation_point text [note: 'Cant rotationPoint; the XSD gives no description.; source: XSD Cant/@rotationPoint; type xs:string']
  Note: 'Cant: The "Cant" element will typically represent a proposed railway cant / superelevation alignment. It is defined by a sequential series of any combination of the cant stations and speed-only stations.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table landxml.cant_station {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  station float8 [not null, note: 'CantStation station; the XSD gives no description.; source: XSD CantStation/@station; type xs:double']
  equilibrium_cant float8 [note: 'CantStation equilibriumCant; the XSD gives no description.; source: XSD CantStation/@equilibriumCant; type xs:double']
  applied_cant float8 [not null, note: 'CantStation appliedCant; the XSD gives no description.; source: XSD CantStation/@appliedCant; type xs:double']
  cant_deficiency float8 [note: 'CantStation cantDeficiency; the XSD gives no description.; source: XSD CantStation/@cantDeficiency; type xs:double']
  cant_excess float8 [note: 'CantStation cantExcess; the XSD gives no description.; source: XSD CantStation/@cantExcess; type xs:double']
