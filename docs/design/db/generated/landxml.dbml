Table landxml.parcel {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.parcel']
  container uuid [note: 'The landxml.parcels row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.parcels; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  name text [not null, note: 'Parcel name; the XSD gives no description.; source: XSD Parcel/@name; type xs:string']
  o_id text [note: 'Parcel oID; the XSD gives no description.; source: XSD Parcel/@oID; type xs:string']
  area float8 [note: 'Parcel area; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Parcel/@area; type xs:double']
  "desc" text [note: 'Parcel desc; the XSD gives no description.; source: XSD Parcel/@desc; type xs:string']
  dir_closure float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Parcel/@dirClosure; type direction']
  dist_closure float8 [note: 'Parcel distClosure; the XSD gives no description. Redundant in the source: derivable from the geometry, so a claim to verify rather than authority.; source: XSD Parcel/@distClosure; type xs:double']
  owner text [note: 'Parcel owner; the XSD gives no description.; source: XSD Parcel/@owner; type xs:string']
  parcel_type text [note: 'Parcel parcelType; the XSD gives no description.; source: XSD Parcel/@parcelType; type xs:string']
  setback_front float8 [note: 'Parcel setbackFront; the XSD gives no description.; source: XSD Parcel/@setbackFront; type xs:double']
  setback_rear float8 [note: 'Parcel setbackRear; the XSD gives no description.; source: XSD Parcel/@setbackRear; type xs:double']
  setback_side float8 [note: 'Parcel setbackSide; the XSD gives no description.; source: XSD Parcel/@setbackSide; type xs:double']
  state text [note: 'This is an extension of the LandXML state type, but is specific to parcels.; source: XSD Parcel/@state; type parcelStateType']
  tax_id text [note: 'Parcel taxId; the XSD gives no description.; source: XSD Parcel/@taxId; type xs:string']
  class text [note: 'This is a list of parcel classes which may be jurisdictionally specific defined by regulation and legislation.; source: XSD Parcel/@class; type parcelClass']
  use_of_parcel text [note: 'Describes what the parcel is used for. This would be a jurisdictionally specific list.; source: XSD Parcel/@useOfParcel; type useOfParcelType']
  parcel_format text [note: 'Parcel Format describes how the parcel is described , ie Standard (2D), Volumertric (3D).; source: XSD Parcel/@parcelFormat; type parcelFormat']
  building_no text [note: 'Parcel buildingNo; the XSD gives no description.; source: XSD Parcel/@buildingNo; type xs:string']
  building_level_no text [note: 'Parcel buildingLevelNo; the XSD gives no description.; source: XSD Parcel/@buildingLevelNo; type xs:string']
  volume text [note: 'Parcel volume; the XSD gives no description.; source: XSD Parcel/@volume; type xs:string']
  pcl_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.parcel; source: XSD Parcel/@pclRef; type parcelNameRef']
  lot_entitlements text [note: 'Parcel lotEntitlements; the XSD gives no description.; source: XSD Parcel/@lotEntitlements; type xs:string']
  liability_apportionment text [note: 'Parcel liabilityApportionment; the XSD gives no description.; source: XSD Parcel/@liabilityApportionment; type xs:string']
  center_x float8 [note: 'Represents a 2D or 3D Center Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only center_pnt_ref is given). (x); source: Parcel/Center text content (Point3dOpt)']
  center_y float8 [note: 'Represents a 2D or 3D Center Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only center_pnt_ref is given). (y); source: Parcel/Center text content (Point3dOpt)']
  center_z float8 [note: 'Represents a 2D or 3D Center Point. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only center_pnt_ref is given). (z); source: Parcel/Center text content (Point3dOpt)']
  center_name text [note: 'Center name; the XSD gives no description.; source: XSD Center/@name; type xs:string']
  center_desc text [note: 'Center desc; the XSD gives no description.; source: XSD Center/@desc; type xs:string']
  center_code text [note: 'Center code; the XSD gives no description.; source: XSD Center/@code; type xs:string']
  center_state text [note: 'Center state; the XSD gives no description.; source: XSD Center/@state; type stateType']
  center_pnt_ref uuid [note: 'A reference name value referring to a PointType derived name attribute. An attribute if this type contains the value of a PointType derived element "name" attribute that exists elsewhere the instance data. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.cg_point; source: XSD Center/@pntRef; type pointNameRef']
  center_feature_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.feature; source: XSD Center/@featureRef; type featureNameRef']
  center_point_geometry text [note: 'Center pointGeometry; the XSD gives no description.; source: XSD Center/@pointGeometry; type pointGeometryType']
  center_dtm_attribute text [note: 'Center DTMAttribute; the XSD gives no description.; source: XSD Center/@DTMAttribute; type DTMAttributeType']
  center_time_stamp timestamptz [note: 'Center timeStamp; the XSD gives no description.; source: XSD Center/@timeStamp; type xs:dateTime']
  center_role text [note: 'Center role; the XSD gives no description.; source: XSD Center/@role; type surveyRoleType']
  center_determined_time_stamp timestamptz [note: 'Center determinedTimeStamp; the XSD gives no description.; source: XSD Center/@determinedTimeStamp; type xs:dateTime']
  center_ellipsoid_height float8 [note: 'Represents the National Geodedic Survey ellipsiod height expressed in the unit height attribute value. Ellipsoid height in the unit given by Units elevationUnit; kept unconverted.; source: XSD Center/@ellipsoidHeight; type ellipsoidHeightType']
  center_latitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD Center/@latitude; type latLongAngle']
  center_longitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD Center/@longitude; type latLongAngle']
  center_zone text [note: 'Center zone; the XSD gives no description.; source: XSD Center/@zone; type xs:string']
  center_northing_std_error float8 [note: 'Center northingStdError; the XSD gives no description.; source: XSD Center/@northingStdError; type xs:double']
  center_easting_std_error float8 [note: 'Center eastingStdError; the XSD gives no description.; source: XSD Center/@eastingStdError; type xs:double']
  center_elevation_std_error float8 [note: 'Center elevationStdError; the XSD gives no description.; source: XSD Center/@elevationStdError; type xs:double']
  Note: 'Parcel: Modified to include parcel class and an official ID'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table landxml.exclusions {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  exclusion_type text [not null, note: 'This is a jurisdictionally based list of exclusions for a Title example would be exclusions for Road, Track, Esplanade etc.; source: XSD Exclusions/@exclusionType; type exclusType']
  area float8 [not null, note: 'Exclusions area; the XSD gives no description.; source: XSD Exclusions/@area; type xs:double']
  Note: 'Exclusions: An Exclusion is an area which has been reserved from a tenure for a specific purpose but may have no defined spatial extent for example 10ha for road. A single parcel could have more than one eclusion for different purposes.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.faces {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.faces']
  container uuid [note: 'The landxml.definition row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.definition; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  "desc" text [note: 'Faces desc; the XSD gives no description.; source: XSD Faces/@desc; type xs:string']
  name text [note: 'Faces name; the XSD gives no description.; source: XSD Faces/@name; type xs:string']
  state text [note: 'Faces state; the XSD gives no description.; source: XSD Faces/@state; type stateType']
  Note: 'Faces: The collection of faces that defined the surface. The faces are defined by either 3 (TIN) or 4 (grid) points, as indicated by the "surfType" attribute For the north/east/elev values, each point of the face references a "P"point element point in the SurfPnts collection.'
