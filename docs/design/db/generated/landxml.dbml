  target_point_y float8 [note: 'Represents a 2D or 3D location for the target. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only target_point_pnt_ref is given). (y); source: PointResults/TargetPoint text content (Point3dOpt)']
  target_point_z float8 [note: 'Represents a 2D or 3D location for the target. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only target_point_pnt_ref is given). (z); source: PointResults/TargetPoint text content (Point3dOpt)']
