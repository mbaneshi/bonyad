Table landxml.monument {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  name text [not null, note: 'Monument name; the XSD gives no description.; source: XSD Monument/@name; type xs:string']
  pnt_ref uuid [note: 'A reference name value referring to a PointType derived name attribute. An attribute if this type contains the value of a PointType derived element "name" attribute that exists elsewhere the instance data. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.cg_point; source: XSD Monument/@pntRef; type pointNameRef']
  feature_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.feature; source: XSD Monument/@featureRef; type featureNameRef']
  "desc" text [note: 'Monument desc; the XSD gives no description.; source: XSD Monument/@desc; type xs:string']
  state text [note: 'This is a list of states for a monument each jurisdiction may haqve a list defined by regulation.; source: XSD Monument/@state; type monumentState']
  type text [note: 'This is a list of allowable monument types that can be used or identified for a survey, ie peg, spike, pillar etc. Local custom will define this list.; source: XSD Monument/@type; type monumentType']
  condition text [note: 'This gives a list of allowable local conditions defined by regulation can be defined by the jurisdiction.; source: XSD Monument/@condition; type monumentCondition']
  category text [note: 'This indicates the category of a geodetic Monument.; source: XSD Monument/@category; type monumentCategory']
  beacon text [note: 'Indicates whether there is any physical structure for the monument - helps location, these enumerations may need expanding.; source: XSD Monument/@beacon; type beaconType']
  beacon_protection text [note: 'Indicates any structure that protects the monument, these enumerations may need expanding.; source: XSD Monument/@beaconProtection; type beaconProtectionType']
  o_id text [note: 'Monument oID; the XSD gives no description.; source: XSD Monument/@oID; type xs:string']
  reference text [note: 'Monument reference; the XSD gives no description.; source: XSD Monument/@reference; type xs:string']
  origin_survey text [note: 'Monument originSurvey; the XSD gives no description.; source: XSD Monument/@originSurvey; type xs:string']
  Note: 'Monument: This is a new element that represents a physical monument placed to mark a CgPoint within a survey'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.no_passing_zone {
