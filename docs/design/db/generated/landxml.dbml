Table landxml.location {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  coordinates_x float8 [note: 'The element\'s coordinate text "northing easting [elevation]" stored as point3 with x = easting (second value), y = northing (first value), z = elevation (null when absent); null when only a pntRef is given. Lengths stay in the file\'s declared unit. (x); source: text content (Point3dOpt)']
  coordinates_y float8 [note: 'The element\'s coordinate text "northing easting [elevation]" stored as point3 with x = easting (second value), y = northing (first value), z = elevation (null when absent); null when only a pntRef is given. Lengths stay in the file\'s declared unit. (y); source: text content (Point3dOpt)']
  coordinates_z float8 [note: 'The element\'s coordinate text "northing easting [elevation]" stored as point3 with x = easting (second value), y = northing (first value), z = elevation (null when absent); null when only a pntRef is given. Lengths stay in the file\'s declared unit. (z); source: text content (Point3dOpt)']
  name text [note: 'Location name; the XSD gives no description.; source: XSD Location/@name; type xs:string']
  "desc" text [note: 'Location desc; the XSD gives no description.; source: XSD Location/@desc; type xs:string']
  code text [note: 'Location code; the XSD gives no description.; source: XSD Location/@code; type xs:string']
  state text [note: 'Location state; the XSD gives no description.; source: XSD Location/@state; type stateType']
  pnt_ref uuid [note: 'A reference name value referring to a PointType derived name attribute. An attribute if this type contains the value of a PointType derived element "name" attribute that exists elsewhere the instance data. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.cg_point; source: XSD Location/@pntRef; type pointNameRef']
  feature_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.feature; source: XSD Location/@featureRef; type featureNameRef']
  point_geometry text [note: 'Location pointGeometry; the XSD gives no description.; source: XSD Location/@pointGeometry; type pointGeometryType']
  dtm_attribute text [note: 'Location DTMAttribute; the XSD gives no description.; source: XSD Location/@DTMAttribute; type DTMAttributeType']
  time_stamp timestamptz [note: 'Location timeStamp; the XSD gives no description.; source: XSD Location/@timeStamp; type xs:dateTime']
  role text [note: 'Location role; the XSD gives no description.; source: XSD Location/@role; type surveyRoleType']
  determined_time_stamp timestamptz [note: 'Location determinedTimeStamp; the XSD gives no description.; source: XSD Location/@determinedTimeStamp; type xs:dateTime']
  ellipsoid_height float8 [note: 'Represents the National Geodedic Survey ellipsiod height expressed in the unit height attribute value. Ellipsoid height in the unit given by Units elevationUnit; kept unconverted.; source: XSD Location/@ellipsoidHeight; type ellipsoidHeightType']
  latitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD Location/@latitude; type latLongAngle']
  longitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD Location/@longitude; type latLongAngle']
  zone text [note: 'Location zone; the XSD gives no description.; source: XSD Location/@zone; type xs:string']
  northing_std_error float8 [note: 'Location northingStdError; the XSD gives no description.; source: XSD Location/@northingStdError; type xs:double']
  easting_std_error float8 [note: 'Location eastingStdError; the XSD gives no description.; source: XSD Location/@eastingStdError; type xs:double']
  elevation_std_error float8 [note: 'Location elevationStdError; the XSD gives no description.; source: XSD Location/@elevationStdError; type xs:double']
  Note: 'Location: Represents a 2D or 3D Point location for a PlanFeature. Defined by either a coordinate text value ("north east" or "north east elev") or a CgPoint number reference "pntRef" attribute.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

