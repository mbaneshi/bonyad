  target_point_time_stamp timestamptz [note: 'TargetPoint timeStamp; the XSD gives no description.; source: XSD TargetPoint/@timeStamp; type xs:dateTime']
  target_point_role text [note: 'TargetPoint role; the XSD gives no description.; source: XSD TargetPoint/@role; type surveyRoleType']
  target_point_determined_time_stamp timestamptz [note: 'TargetPoint determinedTimeStamp; the XSD gives no description.; source: XSD TargetPoint/@determinedTimeStamp; type xs:dateTime']
  target_point_ellipsoid_height float8 [note: 'Represents the National Geodedic Survey ellipsiod height expressed in the unit height attribute value. Ellipsoid height in the unit given by Units elevationUnit; kept unconverted.; source: XSD TargetPoint/@ellipsoidHeight; type ellipsoidHeightType']
  target_point_latitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD TargetPoint/@latitude; type latLongAngle']
  target_point_longitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD TargetPoint/@longitude; type latLongAngle']
  target_point_zone text [note: 'TargetPoint zone; the XSD gives no description.; source: XSD TargetPoint/@zone; type xs:string']
  target_point_northing_std_error float8 [note: 'TargetPoint northingStdError; the XSD gives no description.; source: XSD TargetPoint/@northingStdError; type xs:double']
  target_point_easting_std_error float8 [note: 'TargetPoint eastingStdError; the XSD gives no description.; source: XSD TargetPoint/@eastingStdError; type xs:double']
  target_point_elevation_std_error float8 [note: 'TargetPoint elevationStdError; the XSD gives no description.; source: XSD TargetPoint/@elevationStdError; type xs:double']
  offset_vals_offset_in_out float8 [note: 'OffsetVals offsetInOut; the XSD gives no description.; source: XSD OffsetVals/@offsetInOut; type xs:double']
  offset_vals_offset_left_right float8 [note: 'OffsetVals offsetLeftRight; the XSD gives no description.; source: XSD OffsetVals/@offsetLeftRight; type xs:double']
  offset_vals_offset_up_down float8 [note: 'OffsetVals offsetUpDown; the XSD gives no description.; source: XSD OffsetVals/@offsetUpDown; type xs:double']
  field_note text[] [note: 'Place the note as a text value between the FieldNote element tags. You may also place any valid XML structure inside this tag. Repeated element, stored as an ordered array.; source: XSD FieldNote (element); type xs:string']
  Note: 'ReducedArcObservation: As we discussed this element is used to provide measured information for calculating boundary arcs. The definition information required is quite different to the curve element'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.reduced_observation {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  purpose text [note: 'Used by many of the Survey elements.; source: XSD ReducedObservation/@purpose; type purposeType']
  setup_id uuid [note: 'ReducedObservation setupID; the XSD gives no description. xs:IDREF: names the xs:ID `id` of another element in the same file.; ref to any; source: XSD ReducedObservation/@setupID; type xs:IDREF']
  target_setup_id uuid [note: 'ReducedObservation targetSetupID; the XSD gives no description. xs:IDREF: names the xs:ID `id` of another element in the same file.; ref to any; source: XSD ReducedObservation/@targetSetupID; type xs:IDREF']
  target_setup2id uuid [note: 'ReducedObservation targetSetup2ID; the XSD gives no description. xs:IDREF: names the xs:ID `id` of another element in the same file.; ref to any; source: XSD ReducedObservation/@targetSetup2ID; type xs:IDREF']
  set_id text [note: 'ReducedObservation setID; the XSD gives no description.; source: XSD ReducedObservation/@setID; type xs:anySimpleType']
  target_height float8 [note: 'ReducedObservation targetHeight; the XSD gives no description.; source: XSD ReducedObservation/@targetHeight; type xs:double']
  azimuth float8 [note: 'Represents a normalized angular value that indicates a horizontal direction, expressed in the specified Direction units. Assume 0 degrees = north. Stored in radians. The file value is expressed in Units directionUnit (default radians) and is converted at the import boundary. The XSD defines a horizontal direction as measured counter-clockwise from north (0 = north); only the unit is converted, the reference axis and sense are kept as the source defines them.; source: XSD ReducedObservation/@azimuth; type direction']
  horiz_distance float8 [note: 'ReducedObservation horizDistance; the XSD gives no description.; source: XSD ReducedObservation/@horizDistance; type xs:double']
  vert_distance float8 [note: 'ReducedObservation vertDistance; the XSD gives no description.; source: XSD ReducedObservation/@vertDistance; type xs:double']
  horiz_angle float8 [note: 'Represents a normalized angular value in the specified Angular units. Assume 0 degrees = east. Stored in radians. The file value is expressed in Units angularUnit (default radians) and is converted at the import boundary. The XSD defines it as measured counter-clockwise from east (0 = east).; source: XSD ReducedObservation/@horizAngle; type angle']
  slope_distance float8 [note: 'ReducedObservation slopeDistance; the XSD gives no description.; source: XSD ReducedObservation/@slopeDistance; type xs:double']
  zenith_angle float8 [note: 'Represents zenith angles with the 0 origin as straight up and measured in a clockwise direction in the specified Angular units. Stored in radians. The file value is expressed in the Units angular unit and is converted at the import boundary. The XSD defines it with 0 = straight up, measured clockwise.; source: XSD ReducedObservation/@zenithAngle; type zenithAngle']
  equipment_used text [note: 'This gives a list of equipment used for the observation this list of equipment is used to estimate the accuracy of the observation..; source: XSD ReducedObservation/@equipmentUsed; type equipmentType']
  azimuth_accuracy float8 [note: 'ReducedObservation azimuthAccuracy; the XSD gives no description.; source: XSD ReducedObservation/@azimuthAccuracy; type xs:double']
  distance_accuracy float8 [note: 'ReducedObservation distanceAccuracy; the XSD gives no description.; source: XSD ReducedObservation/@distanceAccuracy; type xs:double']
  angle_accuracy float8 [note: 'ReducedObservation angleAccuracy; the XSD gives no description.; source: XSD ReducedObservation/@angleAccuracy; type xs:double']
  date date [note: 'ReducedObservation date; the XSD gives no description.; source: XSD ReducedObservation/@date; type xs:date']
  distance_type text [note: 'This is a list of defined observation types, different jurisdictions may have a list defined by regulation can be defined by the jurisdiction.; source: XSD ReducedObservation/@distanceType; type observationType']
  azimuth_type text [note: 'This is a list of defined observation types, different jurisdictions may have a list defined by regulation can be defined by the jurisdiction.; source: XSD ReducedObservation/@azimuthType; type observationType']
  angle_type text [note: 'This is a list of defined observation types, different jurisdictions may have a list defined by regulation can be defined by the jurisdiction.; source: XSD ReducedObservation/@angleType; type observationType']
  adopted_azimuth_survey text [note: 'ReducedObservation adoptedAzimuthSurvey; the XSD gives no description.; source: XSD ReducedObservation/@adoptedAzimuthSurvey; type xs:string']
  adopted_distance_survey text [note: 'ReducedObservation adoptedDistanceSurvey; the XSD gives no description.; source: XSD ReducedObservation/@adoptedDistanceSurvey; type xs:string']
  adopted_angle_survey text [note: 'ReducedObservation adoptedAngleSurvey; the XSD gives no description.; source: XSD ReducedObservation/@adoptedAngleSurvey; type xs:string']
  distance_acc_class text [note: 'ReducedObservation distanceAccClass; the XSD gives no description.; source: XSD ReducedObservation/@distanceAccClass; type xs:string']
  azimuth_acc_class text [note: 'ReducedObservation azimuthAccClass; the XSD gives no description.; source: XSD ReducedObservation/@azimuthAccClass; type xs:string']
  angle_acc_class text [note: 'ReducedObservation angleAccClass; the XSD gives no description.; source: XSD ReducedObservation/@angleAccClass; type xs:string']
  azimuth_adoption_factor float8 [note: 'ReducedObservation azimuthAdoptionFactor; the XSD gives no description.; source: XSD ReducedObservation/@azimuthAdoptionFactor; type xs:double']
  distance_adoption_factor float8 [note: 'ReducedObservation distanceAdoptionFactor; the XSD gives no description.; source: XSD ReducedObservation/@distanceAdoptionFactor; type xs:double']
  name text [note: 'ReducedObservation name; the XSD gives no description.; source: XSD ReducedObservation/@name; type xs:string']
  "desc" text [note: 'ReducedObservation desc; the XSD gives no description.; source: XSD ReducedObservation/@desc; type xs:string']
  state text [note: 'ReducedObservation state; the XSD gives no description.; source: XSD ReducedObservation/@state; type stateType']
  o_id text [note: 'ReducedObservation oID; the XSD gives no description.; source: XSD ReducedObservation/@oID; type xs:string']
  msl_distance text [note: 'ReducedObservation MSLDistance; the XSD gives no description.; source: XSD ReducedObservation/@MSLDistance; type xs:string']
  spher_distance text [note: 'ReducedObservation spherDistance; the XSD gives no description.; source: XSD ReducedObservation/@spherDistance; type xs:string']
  coord_geom_refs text[] [note: 'name attributes. Space-delimited list of element names (name-based references).; source: XSD ReducedObservation/@coordGeomRefs; type coordGeomNameRefs']
  align_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.alignment; source: XSD ReducedObservation/@alignRef; type alignmentNameRef']
  align_station_name text [note: 'ReducedObservation alignStationName; the XSD gives no description.; source: XSD ReducedObservation/@alignStationName; type xs:string']
  align_offset float8 [note: 'Represents a linear offset distance. When associated with horizontal (planametric) road or coordinate geometry, the offset is a 2D distance measured perpendicular to the road centerline or coordinate geometry used as... In the file\'s declared linear unit; kept unconverted.; source: XSD ReducedObservation/@alignOffset; type offsetDistance']
  target_point_x float8 [note: 'Represents a 2D or 3D location for the target. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only target_point_pnt_ref is given). (x); source: ReducedObservation/TargetPoint text content (Point3dOpt)']
  target_point_y float8 [note: 'Represents a 2D or 3D location for the target. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only target_point_pnt_ref is given). (y); source: ReducedObservation/TargetPoint text content (Point3dOpt)']
  target_point_z float8 [note: 'Represents a 2D or 3D location for the target. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only target_point_pnt_ref is given). (z); source: ReducedObservation/TargetPoint text content (Point3dOpt)']
  target_point_name text [note: 'TargetPoint name; the XSD gives no description.; source: XSD TargetPoint/@name; type xs:string']
  target_point_desc text [note: 'TargetPoint desc; the XSD gives no description.; source: XSD TargetPoint/@desc; type xs:string']
  target_point_code text [note: 'TargetPoint code; the XSD gives no description.; source: XSD TargetPoint/@code; type xs:string']
  target_point_state text [note: 'TargetPoint state; the XSD gives no description.; source: XSD TargetPoint/@state; type stateType']
  target_point_pnt_ref uuid [note: 'A reference name value referring to a PointType derived name attribute. An attribute if this type contains the value of a PointType derived element "name" attribute that exists elsewhere the instance data. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.cg_point; source: XSD TargetPoint/@pntRef; type pointNameRef']
  target_point_feature_ref uuid [note: 'name attribute. Holds the `name` attribute of the referenced element (a name-based reference, resolved when the file is imported).; ref to landxml.feature; source: XSD TargetPoint/@featureRef; type featureNameRef']
  target_point_point_geometry text [note: 'TargetPoint pointGeometry; the XSD gives no description.; source: XSD TargetPoint/@pointGeometry; type pointGeometryType']
  target_point_dtm_attribute text [note: 'TargetPoint DTMAttribute; the XSD gives no description.; source: XSD TargetPoint/@DTMAttribute; type DTMAttributeType']
  target_point_time_stamp timestamptz [note: 'TargetPoint timeStamp; the XSD gives no description.; source: XSD TargetPoint/@timeStamp; type xs:dateTime']
  target_point_role text [note: 'TargetPoint role; the XSD gives no description.; source: XSD TargetPoint/@role; type surveyRoleType']
  target_point_determined_time_stamp timestamptz [note: 'TargetPoint determinedTimeStamp; the XSD gives no description.; source: XSD TargetPoint/@determinedTimeStamp; type xs:dateTime']
  target_point_ellipsoid_height float8 [note: 'Represents the National Geodedic Survey ellipsiod height expressed in the unit height attribute value. Ellipsoid height in the unit given by Units elevationUnit; kept unconverted.; source: XSD TargetPoint/@ellipsoidHeight; type ellipsoidHeightType']
  target_point_latitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD TargetPoint/@latitude; type latLongAngle']
  target_point_longitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD TargetPoint/@longitude; type latLongAngle']
  target_point_zone text [note: 'TargetPoint zone; the XSD gives no description.; source: XSD TargetPoint/@zone; type xs:string']
  target_point_northing_std_error float8 [note: 'TargetPoint northingStdError; the XSD gives no description.; source: XSD TargetPoint/@northingStdError; type xs:double']
  target_point_easting_std_error float8 [note: 'TargetPoint eastingStdError; the XSD gives no description.; source: XSD TargetPoint/@eastingStdError; type xs:double']
  target_point_elevation_std_error float8 [note: 'TargetPoint elevationStdError; the XSD gives no description.; source: XSD TargetPoint/@elevationStdError; type xs:double']
  offset_vals_offset_in_out float8 [note: 'OffsetVals offsetInOut; the XSD gives no description.; source: XSD OffsetVals/@offsetInOut; type xs:double']
  offset_vals_offset_left_right float8 [note: 'OffsetVals offsetLeftRight; the XSD gives no description.; source: XSD OffsetVals/@offsetLeftRight; type xs:double']
  offset_vals_offset_up_down float8 [note: 'OffsetVals offsetUpDown; the XSD gives no description.; source: XSD OffsetVals/@offsetUpDown; type xs:double']
  field_note text[] [note: 'Place the note as a text value between the FieldNote element tags. You may also place any valid XML structure inside this tag. Repeated element, stored as an ordered array.; source: XSD FieldNote (element); type xs:string']
  Note: 'ReducedObservation: This has been modified to include new fields such as accuracy, date, class and adoption. I\'ve added in bearing (azimuth is in terms of true north whereas bearing is the projection north) - maybe this doesn\'t matter, may need to discuss'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.ret_wall {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.ret_wall']
  container uuid [note: 'The landxml.surface row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.surface; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  "desc" text [note: 'RetWall desc; the XSD gives no description.; source: XSD RetWall/@desc; type xs:string']
  name text [note: 'RetWall name; the XSD gives no description.; source: XSD RetWall/@name; type xs:string']
  state text [note: 'RetWall state; the XSD gives no description.; source: XSD RetWall/@state; type stateType']
  Note: 'RetWall: The retaining wall is defined by a sequential collection of points along the wall. Each point has a location (northing/easting/elevation), height of wall and offset to the wall point.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table landxml.ret_wall_pnt {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.ret_wall_pnt']
  container uuid [note: 'The landxml.ret_wall row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.ret_wall; source: not in the XSD: linkage added because this type is stored as an object (it derives from a base type)']
  height float8 [not null, note: 'RetWallPnt height; the XSD gives no description.; source: XSD RetWallPnt/@height; type xs:double']
  "offset" float8 [not null, note: 'RetWallPnt offset; the XSD gives no description.; source: XSD RetWallPnt/@offset; type xs:double']
  Note: 'RetWallPnt: A retaining wall point defined by a space delimited "northing easting elevation" text value with height and offset attributes to define the wall point The height value is positive if the northing/easting/elevation point is at the bottom of the wall, negative if the point is at the top of the wall. The offset value is negative for left and positive for right.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table landxml.road_name {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  road_name_type text [note: 'to define a jurisdictionally specific list of Road name types such a street, road, avenue etc.; source: XSD RoadName/@roadNameType; type roadNameTypeType']
  road_name text [note: 'RoadName roadName; the XSD gives no description.; source: XSD RoadName/@roadName; type xs:string']
  road_name_suffix text [note: 'to Allow a list of specific road suffixes to be specified, ie east, upper etc (ie Fred Street East).; source: XSD RoadName/@roadNameSuffix; type roadNameSuffixType']
  road_type text [note: 'To define if the road is a public or private road.; source: XSD RoadName/@roadType; type roadTypeType']
  pcl_ref text[] [note: 'name attributes. Space-delimited list of element names (name-based references).; source: XSD RoadName/@pclRef; type parcelNameRefs']
  Note: 'RoadName: LandXML 1.2 `RoadName`; the XSD gives no description.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.road_sign {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  mutcd_code text [note: 'RoadSign MUTCDCode; the XSD gives no description.; source: XSD RoadSign/@MUTCDCode; type xs:string']
  station float8 [note: 'Represents the actual measured distance along the geometry in numeric decimal form expressed in linear units. Also known as the internal station value where no station equations are applied. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations.; source: XSD RoadSign/@station; type station']
  "offset" float8 [note: 'Represents a linear offset distance. When associated with horizontal (planametric) road or coordinate geometry, the offset is a 2D distance measured perpendicular to the road centerline or coordinate geometry used as... In the file\'s declared linear unit; kept unconverted.; source: XSD RoadSign/@offset; type offsetDistance']
  sideof_road text [note: 'RoadSign sideofRoad; the XSD gives no description.; source: XSD RoadSign/@sideofRoad; type sideofRoadType']
  type text [note: 'RoadSign type; the XSD gives no description.; source: XSD RoadSign/@type; type roadSignType']
  mount_height float8 [note: 'RoadSign mountHeight; the XSD gives no description.; source: XSD RoadSign/@mountHeight; type xs:double']
  width float8 [note: 'RoadSign width; the XSD gives no description.; source: XSD RoadSign/@width; type xs:double']
  height float8 [note: 'RoadSign height; the XSD gives no description.; source: XSD RoadSign/@height; type xs:double']
  Note: 'RoadSign: LandXML 1.2 `RoadSign`; the XSD gives no description.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.roadways {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.roadways']
  container uuid [note: 'The landxml.landxml row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.landxml; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  name text [note: 'Roadways name; the XSD gives no description.; source: XSD Roadways/@name; type xs:string']
  "desc" text [note: 'Roadways desc; the XSD gives no description.; source: XSD Roadways/@desc; type xs:string']
  state text [note: 'Roadways state; the XSD gives no description.; source: XSD Roadways/@state; type stateType']
  Note: 'Roadways: Proposed Road model elements for FHWA IHSDM project'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table landxml.speed_station {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  station float8 [not null, note: 'SpeedStation station; the XSD gives no description.; source: XSD SpeedStation/@station; type xs:double']
  speed float8 [not null, note: 'SpeedStation speed; the XSD gives no description.; source: XSD SpeedStation/@speed; type xs:double']
  Note: 'SpeedStation: A cant speed-only station. The “station” is a required double that is internal station value.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.sta_equation {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  sta_ahead float8 [not null, note: 'StaEquation staAhead; the XSD gives no description.; source: XSD StaEquation/@staAhead; type xs:double']
  sta_back float8 [note: 'StaEquation staBack; the XSD gives no description.; source: XSD StaEquation/@staBack; type xs:double']
  sta_internal float8 [not null, note: 'StaEquation staInternal; the XSD gives no description.; source: XSD StaEquation/@staInternal; type xs:double']
  sta_increment text [note: 'StaEquation staIncrement; the XSD gives no description.; source: XSD StaEquation/@staIncrement; type stationIncrementDirectionType']
  "desc" text [note: 'StaEquation desc; the XSD gives no description.; source: XSD StaEquation/@desc; type xs:string']
  Note: 'StaEquation: The "staInternal" value identifies the location of the station equation. It is the station value with no equations applied (staStart + dist).'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.struct_flow {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  loss_in float8 [not null, note: 'StructFlow lossIn; the XSD gives no description.; source: XSD StructFlow/@lossIn; type xs:double']
  loss_out float8 [not null, note: 'StructFlow lossOut; the XSD gives no description.; source: XSD StructFlow/@lossOut; type xs:double']
  "desc" text [note: 'StructFlow desc; the XSD gives no description.; source: XSD StructFlow/@desc; type xs:string']
  hgl_in float8 [note: 'StructFlow hglIn; the XSD gives no description.; source: XSD StructFlow/@hglIn; type xs:double']
  hgl_out float8 [note: 'StructFlow hglOut; the XSD gives no description.; source: XSD StructFlow/@hglOut; type xs:double']
  local_depression float8 [note: 'StructFlow localDepression; the XSD gives no description.; source: XSD StructFlow/@localDepression; type xs:double']
  slope_surf float8 [note: 'StructFlow slopeSurf; the XSD gives no description.; source: XSD StructFlow/@slopeSurf; type xs:double']
  slope_gutter float8 [note: 'StructFlow slopeGutter; the XSD gives no description.; source: XSD StructFlow/@slopeGutter; type xs:double']
  width_gutter float8 [note: 'StructFlow widthGutter; the XSD gives no description.; source: XSD StructFlow/@widthGutter; type xs:double']
  Note: 'StructFlow: LandXML 1.2 `StructFlow`; the XSD gives no description.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.superelevation {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  sta_start float8 [note: 'Represents the actual measured distance along the geometry in numeric decimal form expressed in linear units. Also known as the internal station value where no station equations are applied. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations.; source: XSD Superelevation/@staStart; type station']
  sta_end float8 [note: 'Represents the actual measured distance along the geometry in numeric decimal form expressed in linear units. Also known as the internal station value where no station equations are applied. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations.; source: XSD Superelevation/@staEnd; type station']
  begin_runout_sta float8[] [note: 'BeginRunoutSta (NORMAL CROWN) - Entry Curve Beginning Runout Location - Unit of measure: STATION. Entry Curve Beginning Runout Location - This item is the station of entry curve beginning of runout. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations. Repeated element, stored as an ordered array.; source: XSD BeginRunoutSta (element); type station']
  begin_runoff_sta float8[] [note: 'BeginRunoffSta (HALF CROWN) - Entry Curve Beginning Runoff Location - Unit of measure: STATION. Entry Curve Beginning Runoff Location - This item is the station of entry curve beginning of runoff location. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations. Repeated element, stored as an ordered array.; source: XSD BeginRunoffSta (element); type station']
  full_super_sta float8[] [note: 'FullSuperSta - Full Superelevation Location - Unit of measure: STATION. Full Superelevation Location - This item is the station location at which full superelevation begins. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations. Repeated element, stored as an ordered array.; source: XSD FullSuperSta (element); type station']
  full_superelev float8[] [note: 'FullSuperelev - Full Superelevation - Unit of measure: PERCENT. Full Superelevation - This item is the full superelevation rate on horizontal curve. Repeated element, stored as an ordered array.; source: XSD FullSuperelev (element); type slope']
  runoff_sta float8[] [note: 'RunoffSta - Runoff Location - Exiting Curve - Unit of measure: STATION. Runoff Location - Exiting Curve - This item is the location (station) of start of curve exit runoff. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations. Repeated element, stored as an ordered array.; source: XSD RunoffSta (element); type station']
  startof_runout_sta float8[] [note: 'StartofRunoutSta (HALF CROWN) - Start of Tangent Runout - Exiting Curve - Unit of measure: STATION. Start of Tangent Runout - Exiting Curve - This item is the location of start of tangent runout when exiting curve. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations. Repeated element, stored as an ordered array.; source: XSD StartofRunoutSta (element); type station']
  endof_runout_sta float8[] [note: 'EndofRunoutSta (FULL CROWN) - Exiting End of Tangent Runout - Unit of measure: STATION. Exiting End of Tangent Runout - This item is the location of end of tangent runout on exiting curve. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations. Repeated element, stored as an ordered array.; source: XSD EndofRunoutSta (element); type station']
  adverse_se text[] [note: 'AdverseSE - Adverse SE - This item determines if superelevation is adverse. The enumeration values are: non-adverse and adverse. Repeated element, stored as an ordered array. Allowed values: non-adverse, adverse.; source: XSD AdverseSE (element); type adverseSEType']
  Note: 'Superelevation: Superelevation - The superelevation rate should be steep enough to provide adequate drainage of the roadway surface, but not so steep as to cause vehicles to slide down the cross slope. To prevent vehicles from leaving the roadway as they travel around curve, curves are banked, or superelevated.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

