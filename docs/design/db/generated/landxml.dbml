  end_full_width_sta float8 [note: 'Represents the actual measured distance along the geometry in numeric decimal form expressed in linear units. Also known as the internal station value where no station equations are applied. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations.; source: XSD ClimbLane/@endFullWidthSta; type station']
  width float8 [note: 'ClimbLane width; the XSD gives no description.; source: XSD ClimbLane/@width; type xs:double']
  sideof_road text [note: 'ClimbLane sideofRoad; the XSD gives no description.; source: XSD ClimbLane/@sideofRoad; type sideofRoadType']
  Note: 'ClimbLane: LandXML 1.2 `ClimbLane`; the XSD gives no description.'
