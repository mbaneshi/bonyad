  end_longitude float8 [note: 'Latitude/Longitude coordinate angular values expressed in latLongAngularUnit. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern. Stored in radians. The file value is expressed in Units latLongAngularUnit (default decimal degrees) and is converted at the import boundary.; source: XSD End/@longitude; type latLongAngle']
  end_zone text [note: 'End zone; the XSD gives no description.; source: XSD End/@zone; type xs:string']
  end_northing_std_error float8 [note: 'End northingStdError; the XSD gives no description.; source: XSD End/@northingStdError; type xs:double']
  end_easting_std_error float8 [note: 'End eastingStdError; the XSD gives no description.; source: XSD End/@eastingStdError; type xs:double']
  end_elevation_std_error float8 [note: 'End elevationStdError; the XSD gives no description.; source: XSD End/@elevationStdError; type xs:double']
  Note: 'Line: Modified to include official ID, as with all CoordGeom elements'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

