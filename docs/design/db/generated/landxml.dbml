  align_offset float8 [note: 'Represents a linear offset distance. When associated with horizontal (planametric) road or coordinate geometry, the offset is a 2D distance measured perpendicular to the road centerline or coordinate geometry used as... In the file\'s declared linear unit; kept unconverted.; source: XSD ObservationGroup/@alignOffset; type offsetDistance']
  target_point_x float8 [note: 'Represents a 2D or 3D location for the target. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only target_point_pnt_ref is given). (x); source: ObservationGroup/TargetPoint text content (Point3dOpt)']
  target_point_y float8 [note: 'Represents a 2D or 3D location for the target. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only target_point_pnt_ref is given). (y); source: ObservationGroup/TargetPoint text content (Point3dOpt)']
  target_point_z float8 [note: 'Represents a 2D or 3D location for the target. Coordinate text "northing easting [elevation]" stored with x = easting, y = northing, z = elevation (null when absent or when only target_point_pnt_ref is given). (z); source: ObservationGroup/TargetPoint text content (Point3dOpt)']
