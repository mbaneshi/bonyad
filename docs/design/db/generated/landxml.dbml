Table landxml.surface {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'landxml.surface']
  container uuid [note: 'The landxml.surfaces row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.surfaces; source: not in the XSD: linkage added because this type is stored as an object (it contains other types)']
  name text [not null, note: 'Surface name; the XSD gives no description.; source: XSD Surface/@name; type xs:string']
  "desc" text [note: 'Surface desc; the XSD gives no description.; source: XSD Surface/@desc; type xs:string']
  oid text [note: 'Surface OID; the XSD gives no description.; source: XSD Surface/@OID; type xs:string']
  state text [note: 'Surface state; the XSD gives no description.; source: XSD Surface/@state; type stateType']
  Note: 'Surface: SourceData is an optional collection of the points, contours, breaklines and boundaries that were used to create the surface. Definition is a collection of points and faces that define the surface.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table landxml.boundary {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  bnd_type text [not null, note: 'Surface boundaries can be one of three types: outer, void, island.; source: XSD Boundary/@bndType; type surfBndType']
  edge_trim boolean [not null, note: 'Boundary edgeTrim; the XSD gives no description.; source: XSD Boundary/@edgeTrim; type xs:boolean']
  area float8 [note: 'Boundary area; the XSD gives no description.; source: XSD Boundary/@area; type xs:double']
  "desc" text [note: 'Boundary desc; the XSD gives no description.; source: XSD Boundary/@desc; type xs:string']
  name text [note: 'Boundary name; the XSD gives no description.; source: XSD Boundary/@name; type xs:string']
  state text [note: 'Boundary state; the XSD gives no description.; source: XSD Boundary/@state; type stateType']
  pnt_list2d float8[] [note: 'A sequential space delimited list of 2D coordinates with a minimum of 2 points (4 values). Space-delimited list of doubles; consecutive values are the coordinates of successive points in the order the schema states.; source: XSD PntList2D (element); type Point']
  pnt_list3d float8[] [note: 'A sequential space delimited list of 3D coordinates with a minimum of 2 points (6 values). Space-delimited list of doubles; consecutive values are the coordinates of successive points in the order the schema states.; source: XSD PntList3D (element); type Point']
  Note: 'Boundary: The boundary region contains a 2D north/east or 3D north/east/elev list of points that define the geometry. is identified by the "name" attribute.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.breakline {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  brk_type text [note: 'Breakline brkType; the XSD gives no description.; source: XSD Breakline/@brkType; type breakLineType']
  "desc" text [note: 'Breakline desc; the XSD gives no description.; source: XSD Breakline/@desc; type xs:string']
  name text [note: 'Breakline name; the XSD gives no description.; source: XSD Breakline/@name; type xs:string']
  state text [note: 'Breakline state; the XSD gives no description.; source: XSD Breakline/@state; type stateType']
  pnt_list2d float8[] [note: 'A sequential space delimited list of 2D coordinates with a minimum of 2 points (4 values). Space-delimited list of doubles; consecutive values are the coordinates of successive points in the order the schema states.; source: XSD PntList2D (element); type Point']
  pnt_list3d float8[] [note: 'A sequential space delimited list of 3D coordinates with a minimum of 2 points (6 values). Space-delimited list of doubles; consecutive values are the coordinates of successive points in the order the schema states.; source: XSD PntList3D (element); type Point']
  Note: 'Breakline: The breakline is defined by a 2D north/east or 3D north/east/elev list of points that define the geometry. is identified by the "name" attribute.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.bridge_element {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  sta_start float8 [note: 'Represents the actual measured distance along the geometry in numeric decimal form expressed in linear units. Also known as the internal station value where no station equations are applied. Distance along the geometry in the file\'s declared linear unit; kept unconverted. Not corrected for station equations.; source: XSD BridgeElement/@staStart; type station']
