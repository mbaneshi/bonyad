  volume_unit text [not null, note: 'Metric volumeUnit; the XSD gives no description.; source: XSD Metric/@volumeUnit; type metVolume']
  temperature_unit text [not null, note: 'Metric temperatureUnit; the XSD gives no description.; source: XSD Metric/@temperatureUnit; type metTemperature']
  pressure_unit text [not null, note: 'Metric pressureUnit; the XSD gives no description.; source: XSD Metric/@pressureUnit; type metPressure']
  diameter_unit text [note: 'Metric diameterUnit; the XSD gives no description.; source: XSD Metric/@diameterUnit; type metDiameter']
  width_unit text [note: 'Metric widthUnit; the XSD gives no description.; source: XSD Metric/@widthUnit; type metWidth']
  height_unit text [note: 'Metric heightUnit; the XSD gives no description.; source: XSD Metric/@heightUnit; type metHeight']
  velocity_unit text [note: 'Metric velocityUnit; the XSD gives no description.; source: XSD Metric/@velocityUnit; type metVelocity']
  flow_unit text [note: 'Metric flowUnit; the XSD gives no description.; source: XSD Metric/@flowUnit; type metFlow']
  angular_unit text [default: 'radians', note: '3025" representing 45 degrees 30 minutes and 25 seconds. Both the minutes and seconds must be two characters with a numeric range between 00 to 60.; source: XSD Metric/@angularUnit; type angularType']
  direction_unit text [default: 'radians', note: '3025" representing 45 degrees 30 minutes and 25 seconds. Both the minutes and seconds must be two characters with a numeric range between 00 to 60.; source: XSD Metric/@directionUnit; type angularType']
  lat_long_angular_unit text [default: 'decimal degrees', note: 'Latitude/Longitude coordinate angular values. Latitude (range -90 to +90) positive values for the northern hemispher, negative indicate the southern.; source: XSD Metric/@latLongAngularUnit; type latLongAngularType']
  elevation_unit text [default: 'meter', note: 'Represents the elevation unit for elevation attribute values, such as ellipsoidHeight.; source: XSD Metric/@elevationUnit; type elevationType']
