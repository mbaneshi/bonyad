Table landxml.contour {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  elev float8 [not null, note: 'Contour elev; the XSD gives no description.; source: XSD Contour/@elev; type xs:double']
  pnt_list2d float8[] [not null, note: 'A sequential space delimited list of 2D coordinates with a minimum of 2 points (4 values). Space-delimited list of doubles; consecutive values are the coordinates of successive points in the order the schema states.; source: XSD PntList2D (element); type Point']
  Note: 'Contour: The contour is defined by an elevation attribute and a 2D north/east list of points that define the geometry. is identified by the "name" attribute.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table landxml.landxml {
