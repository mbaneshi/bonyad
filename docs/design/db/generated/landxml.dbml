Table landxml.raw_observation_type {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: landxml.raw_observation, landxml.test_observation']
  setup_id uuid [note: 'RawObservationType setupID; the XSD gives no description. xs:IDREF: names the xs:ID `id` of another element in the same file.; ref to any; source: XSD RawObservationType/@setupID; type xs:IDREF']
