  offset_mode text [default: 'zone', note: 'ZoneCrossSectStructure offsetMode; the XSD gives no description.; source: XSD ZoneCrossSectStructure/@offsetMode; type zoneOffsetType']
  start_offset float8 [default: 0, note: 'Represents a linear offset distance. When associated with horizontal (planametric) road or coordinate geometry, the offset is a 2D distance measured perpendicular to the road centerline or coordinate geometry used as... In the file\'s declared linear unit; kept unconverted.; source: XSD ZoneCrossSectStructure/@startOffset; type offsetDistance']
  start_offset_elev float8 [default: 0, note: 'Represents a vertical offset distance or elevational shift. In all cases a positive value indicates a vertical elevational shift above the origin and negative values indicate a vertical elevational shift below the... In the file\'s declared linear unit; kept unconverted.; source: XSD ZoneCrossSectStructure/@startOffsetElev; type offsetElevation']
  end_offset float8 [default: 0, note: 'Represents a linear offset distance. When associated with horizontal (planametric) road or coordinate geometry, the offset is a 2D distance measured perpendicular to the road centerline or coordinate geometry used as... In the file\'s declared linear unit; kept unconverted.; source: XSD ZoneCrossSectStructure/@endOffset; type offsetDistance']
  end_offset_elev float8 [default: 0, note: 'Represents a vertical offset distance or elevational shift. In all cases a positive value indicates a vertical elevational shift above the origin and negative values indicate a vertical elevational shift below the... In the file\'s declared linear unit; kept unconverted.; source: XSD ZoneCrossSectStructure/@endOffsetElev; type offsetElevation']
  transition text [default: 'parallel', note: 'ZoneCrossSectStructure transition; the XSD gives no description.; source: XSD ZoneCrossSectStructure/@transition; type zoneTransitionType']
  placement text [default: 'dependent', note: 'ZoneCrossSectStructure placement; the XSD gives no description.; source: XSD ZoneCrossSectStructure/@placement; type zonePlacementType']
  catalog_reference text [note: 'ZoneCrossSectStructure catalogReference; the XSD gives no description.; source: XSD ZoneCrossSectStructure/@catalogReference; type xs:anyURI']
  pnt_list2d float8[] [not null, note: 'A sequential space delimited list of 2D coordinates with a minimum of 2 points (4 values). Space-delimited list of doubles; consecutive values are the coordinates of successive points in the order the schema states.; source: XSD PntList2D (element); type Point']
  Note: 'ZoneCrossSectStructure: LandXML 1.2 `ZoneCrossSectStructure`; the XSD gives no description.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

