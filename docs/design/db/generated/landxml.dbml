  revision_id bigint [not null]
  type_code text [not null, note: 'one of: landxml.curve, landxml.curve1, landxml.curve2']
  container uuid [note: 'The landxml.coord_geom row that contains this one in the XSD (null for a stand-alone fragment).; ref to landxml.coord_geom; source: not in the XSD: linkage added because this type is stored as an object (it is the base of other types)']
