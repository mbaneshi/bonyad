  duration_type text [note: 'Enables to specify the type of duration values for ScheduleDuration, ActualDuration and RemainingTime.; source: IfcTaskTime attribute 1: OPTIONAL IfcTaskDurationEnum; enumeration IfcTaskDurationEnum']
  schedule_duration text [note: 'The amount of time which is scheduled for completion of a task.; source: IfcTaskTime attribute 2: OPTIONAL IfcDuration']
  schedule_start timestamptz [note: 'The date on which a task is scheduled to be started.; source: IfcTaskTime attribute 3: OPTIONAL IfcDateTime']
  schedule_finish timestamptz [note: 'The date on which a task is scheduled to be finished.; source: IfcTaskTime attribute 4: OPTIONAL IfcDateTime']
  early_start timestamptz [note: 'The earliest date on which a task can be started.; source: IfcTaskTime attribute 5: OPTIONAL IfcDateTime']
  early_finish timestamptz [note: 'The earliest date on which a task can be finished.; source: IfcTaskTime attribute 6: OPTIONAL IfcDateTime']
  late_start timestamptz [note: 'The latest date on which a task can be started.; source: IfcTaskTime attribute 7: OPTIONAL IfcDateTime']
  late_finish timestamptz [note: 'The latest date on which a task can be finished.; source: IfcTaskTime attribute 8: OPTIONAL IfcDateTime']
  free_float text [note: 'The amount of time during which the start or finish of a task may be varied without any effect on the overall programme of work.; source: IfcTaskTime attribute 9: OPTIONAL IfcDuration']
  total_float text [note: 'The difference between the duration available to carry out a task and the scheduled duration of the task.; source: IfcTaskTime attribute 10: OPTIONAL IfcDuration']
  is_critical boolean [note: 'A flag which identifies whether a scheduled task is a critical item within the programme.; source: IfcTaskTime attribute 11: OPTIONAL IfcBoolean']
  status_time timestamptz [note: 'The date or time at which the status of the tasks within the schedule is analyzed.; source: IfcTaskTime attribute 12: OPTIONAL IfcDateTime']
  actual_duration text [note: 'The actual duration of the task.; source: IfcTaskTime attribute 13: OPTIONAL IfcDuration']
  actual_start timestamptz [note: 'The date on which a task is actually started.; source: IfcTaskTime attribute 14: OPTIONAL IfcDateTime']
  actual_finish timestamptz [note: 'The date on which a task is actually finished.; source: IfcTaskTime attribute 15: OPTIONAL IfcDateTime']
  remaining_time text [note: 'The amount of time remaining to complete a task.; source: IfcTaskTime attribute 16: OPTIONAL IfcDuration']
  completion float8 [note: 'The extent of completion expressed as a ratio or percentage.; source: IfcTaskTime attribute 17: OPTIONAL IfcPositiveRatioMeasure']
  Note: 'IfcTaskTime: IfcTaskTime captures the time-related information about a task including the different types (actual or scheduled) of starting and ending times.'
