  displacement_y float8 [note: 'Displacement in y-direction.; source: IfcStructuralLoadSingleDisplacement attribute 2: OPTIONAL IfcLengthMeasure']
  displacement_z float8 [note: 'Displacement in z-direction.; source: IfcStructuralLoadSingleDisplacement attribute 3: OPTIONAL IfcLengthMeasure']
  rotational_displacement_rx float8 [note: 'Rotation about the x-axis. Radians; converted from the project plane-angle unit at the source boundary.; source: IfcStructuralLoadSingleDisplacement attribute 4: OPTIONAL IfcPlaneAngleMeasure']
  rotational_displacement_ry float8 [note: 'Rotation about the y-axis. Radians; converted from the project plane-angle unit at the source boundary.; source: IfcStructuralLoadSingleDisplacement attribute 5: OPTIONAL IfcPlaneAngleMeasure']
  rotational_displacement_rz float8 [note: 'Rotation about the z-axis. Radians; converted from the project plane-angle unit at the source boundary.; source: IfcStructuralLoadSingleDisplacement attribute 6: OPTIONAL IfcPlaneAngleMeasure']
