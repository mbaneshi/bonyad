  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.structural_curve_action, ifc.structural_linear_action']
  projected_or_true text [note: 'Defines whether load values are given per true length of the curve on which they act, or per length of the projection of the curve in load direction.; source: IfcStructuralCurveAction attribute 1: OPTIONAL IfcProjectedOrTrueLengthEnum; enumeration IfcProjectedOrTrueLengthEnum']
  predefined_type text [not null, note: 'Type of action according to its distribution of load values.; source: IfcStructuralCurveAction attribute 2: IfcStructuralCurveActivityTypeEnum; enumeration IfcStructuralCurveActivityTypeEnum']
  Note: 'IfcStructuralCurveAction: A structural curve action defines an action which is distributed over a curve. A curve action may be connected with a curve member or curve connection, or surface member or surface connection.'
