  Note: 'IfcRelAssociates.RelatedObjects: Rows of the RelatedObjects list of IfcRelAssociates. Set of object or property definitions to which the external references or information is associated.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table ifc.rel_connects_elements {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.rel_connects_elements, ifc.rel_connects_path_elements, ifc.rel_connects_with_realizing_elements']
  connection_geometry uuid [note: 'The geometric shape representation of the connection geometry that is provided in the object coordinate system of the RelatingElement (mandatory) and in the object coordinate system of the RelatedElement (optionally).; ref to ifc.connection_geometry; source: IfcRelConnectsElements attribute 1: OPTIONAL IfcConnectionGeometry']
  relating_element uuid [not null, note: 'Reference to a subtype of IfcElement that is connected by the connection relationship in the role of RelatingElement.; ref to ifc.element; source: IfcRelConnectsElements attribute 2: IfcElement']
  related_element uuid [not null, note: 'Reference to a subtype of IfcElement that is connected by the connection relationship in the role of RelatedElement.; ref to ifc.element; source: IfcRelConnectsElements attribute 3: IfcElement']
  Note: 'IfcRelConnectsElements: The IfcRelConnectsElements objectified relationship provides the generalization of the connectivity between elements. It is a 1 to 1 relationship.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table ifc.rel_connects_path_elements {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_connects_path_elements']
  relating_priorities int[] [not null, note: 'Overriding priorities at this connection.; source: IfcRelConnectsPathElements attribute 1: LIST [0:?] OF IfcInteger']
  related_priorities int[] [not null, note: 'Overriding priorities at this connection.; source: IfcRelConnectsPathElements attribute 2: LIST [0:?] OF IfcInteger']
  related_connection_type text [not null, note: 'Indication of the connection type in relation to the path of the RelatedObject.; source: IfcRelConnectsPathElements attribute 3: IfcConnectionTypeEnum; enumeration IfcConnectionTypeEnum']
  relating_connection_type text [not null, note: 'Indication of the connection type in relation to the path of the RelatingObject.; source: IfcRelConnectsPathElements attribute 4: IfcConnectionTypeEnum; enumeration IfcConnectionTypeEnum']
  Note: 'IfcRelConnectsPathElements: The IfcRelConnectsPathElements relationship provides the connectivity information between two elements, which have path information.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_connects_port_to_element {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_connects_port_to_element']
  relating_port uuid [not null, note: 'Reference to an Port that is connected by the objectified relationship.; ref to ifc.port; source: IfcRelConnectsPortToElement attribute 1: IfcPort']
  related_element uuid [not null, note: 'Reference to an IfcDistributionElement that has ports assigned.; ref to ifc.distribution_element; source: IfcRelConnectsPortToElement attribute 2: IfcDistributionElement']
  Note: 'IfcRelConnectsPortToElement: IfcRelConnectsPortToElement is a relationship between a distribution element and dynamically connected ports where connections are realised to other distribution elements.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_connects_ports {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_connects_ports']
  relating_port uuid [not null, note: 'Reference to the first port that is connected by the objectified relationship.; ref to ifc.port; source: IfcRelConnectsPorts attribute 1: IfcPort']
  related_port uuid [not null, note: 'Reference to the second port that is connected by the objectified relationship.; ref to ifc.port; source: IfcRelConnectsPorts attribute 2: IfcPort']
  realizing_element uuid [note: 'Defines the element that realizes a port connection relationship.; ref to ifc.element; source: IfcRelConnectsPorts attribute 3: OPTIONAL IfcElement']
  Note: 'IfcRelConnectsPorts: An IfcRelConnectsPorts relationship defines the relationship that is made between two ports at their point of connection. It may include the connection geometry between two ports.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_connects_structural_activity {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_connects_structural_activity']
  relating_element uuid [not null, note: 'Reference to a structural item or element to which the specified activity is applied.; ref to ifc.product; source: IfcRelConnectsStructuralActivity attribute 1: IfcStructuralActivityAssignmentSelect; via select IfcStructuralActivityAssignmentSelect']
  related_structural_activity uuid [not null, note: 'Reference to a structural activity which is acting upon the specified structural item or element.; ref to ifc.structural_activity; source: IfcRelConnectsStructuralActivity attribute 2: IfcStructuralActivity']
  Note: 'IfcRelConnectsStructuralActivity: The IfcRelConnectsStructuralActivity relationship connects a structural activity (either an action or reaction) to a structural member, structural connection, or element.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_connects_structural_member {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.rel_connects_structural_member, ifc.rel_connects_with_eccentricity']
  relating_structural_member uuid [not null, note: 'Reference to an instance of IfcStructuralMember (or its subclasses) which is connected to the specified structural connection.; ref to ifc.structural_member; source: IfcRelConnectsStructuralMember attribute 1: IfcStructuralMember']
  related_structural_connection uuid [not null, note: 'Reference to an instance of IfcStructuralConnection (or its subclasses) which is connected to the specified structural member.; ref to ifc.structural_connection; source: IfcRelConnectsStructuralMember attribute 2: IfcStructuralConnection']
  applied_condition uuid [note: 'Conditions which define the connections properties.; ref to ifc.boundary_condition; source: IfcRelConnectsStructuralMember attribute 3: OPTIONAL IfcBoundaryCondition']
  additional_conditions uuid [note: 'Describes additional connection properties.; ref to ifc.structural_connection_condition; source: IfcRelConnectsStructuralMember attribute 4: OPTIONAL IfcStructuralConnectionCondition']
  supported_length float8 [note: 'Defines the \'supported length\' of this structural connection.; source: IfcRelConnectsStructuralMember attribute 5: OPTIONAL IfcLengthMeasure']
  condition_coordinate_system uuid [note: 'Defines a coordinate system used for the description of the connection properties in ConnectionCondition relative to the local coordinate system of RelatingStructuralMember.; ref to ifc.axis2_placement3d; source: IfcRelConnectsStructuralMember attribute 6: OPTIONAL IfcAxis2Placement3D']
  Note: 'IfcRelConnectsStructuralMember: The entity IfcRelConnectsStructuralMember defines all needed properties describing the connection between structural members and structural connection objects (nodes or supports).'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table ifc.rel_connects_with_eccentricity {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_connects_with_eccentricity']
  connection_constraint uuid [not null, note: 'The connection constraint explicitly states the eccentricity between a structural member and a structural connection by means of two topological objects (vertex and vertex, or edge and edge, or face and face).; ref to ifc.connection_geometry; source: IfcRelConnectsWithEccentricity attribute 1: IfcConnectionGeometry']
  Note: 'IfcRelConnectsWithEccentricity: The entity IfcRelConnectsWithEccentricity adds the definition of eccentricity to the connection between a structural member and a structural connection (representing either a node or support).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_connects_with_realizing_elements {
  entity_id uuid [not null]
  revision_id bigint [not null]
