Table ifc.control {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.action_request, ifc.cost_item, ifc.cost_schedule, ifc.performance_history, ifc.permit, ifc.project_order, ifc.work_calendar, ifc.work_plan, ifc.work_schedule']
  identification text [note: 'An identifying designation given to a control It is the identifier at the occurrence level.; source: IfcControl attribute 1: OPTIONAL IfcIdentifier']
  Note: 'IfcControl: IfcControl is the abstract generalization of all concepts that control or constrain the utilization of products, processes, or resources in general. It can be seen as a regulation, cost schedule, request or order, or other requirements applied to a product, process or resource whose requirements and provisions must be fulfilled.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table ifc.action_request {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.action_request']
  predefined_type text [note: 'Identifies the predefined type of sources through which a request can be made.; source: IfcActionRequest attribute 1: OPTIONAL IfcActionRequestTypeEnum; enumeration IfcActionRequestTypeEnum']
  status text [note: 'The status currently assigned to the request.; source: IfcActionRequest attribute 2: OPTIONAL IfcLabel']
  long_description text [note: 'Detailed description of the permit.; source: IfcActionRequest attribute 3: OPTIONAL IfcText']
  Note: 'IfcActionRequest: A request is the act or instance of asking for something, such as a request for information, bid submission, or performance of work.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.actor {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.actor, ifc.occupant']
  the_actor uuid [not null, note: 'Information about the actor.; ref to any; source: IfcActor attribute 1: IfcActorSelect; via select IfcActorSelect']
  Note: 'IfcActor: The IfcActor defines all actors or human agents involved in a project during its full life cycle. It facilitates the use of person and organization definitions in the resource part of the IFC object model.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table ifc.actor_role {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.actor_role']
  role text [not null, note: 'The name of the role played by an actor.; source: IfcActorRole attribute 1: IfcRoleEnum; enumeration IfcRoleEnum']
  user_defined_role text [note: 'Allows for specification of user defined roles beyond the enumeration values provided by Role attribute of type IfcRoleEnum.; source: IfcActorRole attribute 2: OPTIONAL IfcLabel']
  description text [note: 'A textual description relating the nature of the role played by an actor.; source: IfcActorRole attribute 3: OPTIONAL IfcText']
  Note: 'IfcActorRole: This entity indicates a role which is performed by an actor, either a person, an organization or a person related to an organization.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

