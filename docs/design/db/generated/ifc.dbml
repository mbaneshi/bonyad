  radius float8 [not null, note: 'The Radius of the circular disk to be swept along the directrix.; source: IfcSweptDiskSolid attribute 2: IfcPositiveLengthMeasure']
  inner_radius float8 [note: 'This attribute is optional, if present it defines the radius of a circular hole in the centre of the disk.; source: IfcSweptDiskSolid attribute 3: OPTIONAL IfcPositiveLengthMeasure']
