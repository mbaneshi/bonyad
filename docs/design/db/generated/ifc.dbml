    (entity_id, revision_id, type_code) [unique]
  }
}

Table ifc.window_lining_properties {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.window_lining_properties']
  lining_depth float8 [note: 'Depth of the window lining (dimension measured perpendicular to window elevation plane).; source: IfcWindowLiningProperties attribute 1: OPTIONAL IfcPositiveLengthMeasure']
  lining_thickness float8 [note: 'Thickness of the window lining as explained in the figure above.; source: IfcWindowLiningProperties attribute 2: OPTIONAL IfcNonNegativeLengthMeasure']
  transom_thickness float8 [note: 'Thickness of the transom (horizontal separator of window panels within a window), measured parallel to the window elevation plane.; source: IfcWindowLiningProperties attribute 3: OPTIONAL IfcNonNegativeLengthMeasure']
  mullion_thickness float8 [note: 'Thickness of the mullion (vertical separator of window panels within a window), measured parallel to the window elevation plane.; source: IfcWindowLiningProperties attribute 4: OPTIONAL IfcNonNegativeLengthMeasure']
  first_transom_offset float8 [note: 'Offset of the transom centerline, measured along the z-axis of the window placement coordinate system.; source: IfcWindowLiningProperties attribute 5: OPTIONAL IfcNormalisedRatioMeasure']
  second_transom_offset float8 [note: 'Offset of the transom centerline for the second transom, measured along the x-axis of the window placement coordinate system.; source: IfcWindowLiningProperties attribute 6: OPTIONAL IfcNormalisedRatioMeasure']
  first_mullion_offset float8 [note: 'Offset of the mullion centerline, measured along the x-axis of the window placement coordinate system.; source: IfcWindowLiningProperties attribute 7: OPTIONAL IfcNormalisedRatioMeasure']
  second_mullion_offset float8 [note: 'Offset of the mullion centerline for the second mullion, measured along the x-axis of the window placement coordinate system.; source: IfcWindowLiningProperties attribute 8: OPTIONAL IfcNormalisedRatioMeasure']
  shape_aspect_style uuid [note: 'Optional link to a shape aspect definition, which points to the part of the geometric representation of the window style, which is used to represent the lining.; ref to ifc.shape_aspect; source: IfcWindowLiningProperties attribute 9: OPTIONAL IfcShapeAspect']
  lining_offset float8 [note: 'Offset of the window lining.; source: IfcWindowLiningProperties attribute 10: OPTIONAL IfcLengthMeasure']
  lining_to_panel_offset_x float8 [note: 'Offset between the lining and the window panel measured along the x-axis of the local placement.; source: IfcWindowLiningProperties attribute 11: OPTIONAL IfcLengthMeasure']
  lining_to_panel_offset_y float8 [note: 'Offset between the lining and the window panel measured along the y-axis of the local placement.; source: IfcWindowLiningProperties attribute 12: OPTIONAL IfcLengthMeasure']
  Note: 'IfcWindowLiningProperties: The window lining is the outer frame which enables the window to be fixed in position. The window lining is used to hold the window panels or other casements.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.window_panel_properties {
  entity_id uuid [not null]
  revision_id bigint [not null]
