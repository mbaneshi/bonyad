  Note: 'IfcRelAdheresToElement.RelatedSurfaceFeatures: Rows of the RelatedSurfaceFeatures list of IfcRelAdheresToElement. The _IfcSurfaceFeature_(s) that adheres to the surface of the parent element.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table ifc.rel_aggregates {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_aggregates']
  relating_object uuid [not null, note: 'The object definition, either an object type or an object occurrence, that represents the aggregation.; ref to ifc.object_definition; source: IfcRelAggregates attribute 1: IfcObjectDefinition']
  Note: 'IfcRelAggregates: The aggregation relationship IfcRelAggregates is a special type of general composition/decomposition (or whole/part) relationship IfcRelDecomposes. The aggregation relationship can be applied to all subtypes of IfcObjectDefinition.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_aggregates_related_objects {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  item uuid [not null, note: 'Element of IfcRelAggregates.RelatedObjects.; ref to ifc.object_definition; source: IfcRelAggregates attribute 2: SET [1:?] OF IfcObjectDefinition']
  Note: 'IfcRelAggregates.RelatedObjects: Rows of the RelatedObjects list of IfcRelAggregates. The object definitions, either object occurrences or object types, that are being aggregated.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table ifc.rel_assigns {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.rel_assigns_to_actor, ifc.rel_assigns_to_control, ifc.rel_assigns_to_group, ifc.rel_assigns_to_group_by_factor, ifc.rel_assigns_to_process, ifc.rel_assigns_to_product, ifc.rel_assigns_to_resource']
  related_objects_type text [note: 'Particular type of the assignment relationship.; source: IfcRelAssigns attribute 2: OPTIONAL IfcObjectTypeEnum; enumeration IfcObjectTypeEnum']
  Note: 'IfcRelAssigns: The assignment relationship, IfcRelAssigns, is a generalization of "link" relationships among instances of IfcObject and its various 1st level subtypes. A link denotes the specific association through which one object (the client) applies the services of other objects (the suppliers), or through which one object may navigate to other objects.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table ifc.rel_assigns_related_objects {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  item uuid [not null, note: 'Element of IfcRelAssigns.RelatedObjects.; ref to ifc.object_definition; source: IfcRelAssigns attribute 1: SET [1:?] OF IfcObjectDefinition']
  Note: 'IfcRelAssigns.RelatedObjects: Rows of the RelatedObjects list of IfcRelAssigns. Related objects, which are assigned to a single object.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table ifc.rel_assigns_to_actor {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_assigns_to_actor']
  relating_actor uuid [not null, note: 'Reference to the information about the actor.; ref to ifc.actor; source: IfcRelAssignsToActor attribute 1: IfcActor']
  acting_role uuid [note: 'Role of the actor played within the context of the assignment to the object(s).; ref to ifc.actor_role; source: IfcRelAssignsToActor attribute 2: OPTIONAL IfcActorRole']
  Note: 'IfcRelAssignsToActor: The objectified relationship IfcRelAssignsToActor handles the assignment of objects (subtypes of IfcObject) to an actor (subtypes of IfcActor).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_assigns_to_control {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_assigns_to_control']
  relating_control uuid [not null, note: 'Reference to the IfcControl that applies a control upon objects.; ref to ifc.control; source: IfcRelAssignsToControl attribute 1: IfcControl']
  Note: 'IfcRelAssignsToControl: The objectified relationship IfcRelAssignsToControl handles the assignment of a control (represented by subtypes of IfcControl) to other objects (represented by subtypes of IfcObject, with the exception of controls).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_assigns_to_group {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.rel_assigns_to_group, ifc.rel_assigns_to_group_by_factor']
  relating_group uuid [not null, note: 'Reference to the group that contains all assigned group members.; ref to ifc.group; source: IfcRelAssignsToGroup attribute 1: IfcGroup']
  Note: 'IfcRelAssignsToGroup: The objectified relationship IfcRelAssignsToGroup handles the assignment of object definitions (individual object occurrences as subtypes of IfcObject, and object types as subtypes of IfcTypeObject) to a group (subtypes of IfcGroup).'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table ifc.rel_assigns_to_group_by_factor {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_assigns_to_group_by_factor']
  factor float8 [not null, note: 'Factor provided as a ratio measure that identifies the fraction or weighted factor that applies to the group assignment.; source: IfcRelAssignsToGroupByFactor attribute 1: IfcRatioMeasure']
  Note: 'IfcRelAssignsToGroupByFactor: The objectified relationship IfcRelAssignsToGroupByFactor is a specialization of the general grouping mechanism. It allows to add a factor to define the ratio that applies to the assignment of object definitions (individual object occurrences as subtypes of IfcObject and object types as subtypes of IfcTypeObject) to a group (subtypes of IfcGroup).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_assigns_to_process {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_assigns_to_process']
  relating_process uuid [not null, note: 'Reference to the process to which the objects are assigned.; ref to ifc.object_definition; source: IfcRelAssignsToProcess attribute 1: IfcProcessSelect; via select IfcProcessSelect']
  quantity_in_process uuid [note: 'Quantity of the object specific for the operation by this process.; ref to ifc.measure_with_unit; source: IfcRelAssignsToProcess attribute 2: OPTIONAL IfcMeasureWithUnit']
  Note: 'IfcRelAssignsToProcess: The objectified relationship IfcRelAssignsToProcess handles the assignment of one or many objects to a process or activity. An object can be a product on which the process operates.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_assigns_to_product {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_assigns_to_product']
  relating_product uuid [not null, note: 'Reference to the product or product type to which the objects are assigned.; ref to ifc.object_definition; source: IfcRelAssignsToProduct attribute 1: IfcProductSelect; via select IfcProductSelect']
  Note: 'IfcRelAssignsToProduct: The objectified relationship IfcRelAssignsToProduct handles the assignment of objects (subtypes of IfcObject) to a product (subtypes of IfcProduct). The Name attribute should be used to classify the usage of the IfcRelAssignsToProduct objectified relationship.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_assigns_to_resource {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_assigns_to_resource']
  relating_resource uuid [not null, note: 'Reference to the resource to which the objects are assigned.; ref to ifc.object_definition; source: IfcRelAssignsToResource attribute 1: IfcResourceSelect; via select IfcResourceSelect']
  Note: 'IfcRelAssignsToResource: The objectified relationship IfcRelAssignsToResource handles the assignment of objects (as subtypes of IfcObject), acting as a resource usage or consumption, to a resource (as subtypes of IfcResource).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_associates_approval {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_associates_approval']
