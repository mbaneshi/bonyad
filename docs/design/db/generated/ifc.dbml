  Note: 'IfcStructuralCurveConnection: Instances of IfcStructuralCurveConnection describe edge \'nodes\', i.e. edges where two or more surface members are joined, or edge supports. Edge curves may be straight or curved.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.structural_curve_member {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.structural_curve_member, ifc.structural_curve_member_varying']
  predefined_type text [not null, note: 'Type of member with respect to its load carrying behaviour in this analysis idealization.; source: IfcStructuralCurveMember attribute 1: IfcStructuralCurveMemberTypeEnum; enumeration IfcStructuralCurveMemberTypeEnum']
  axis uuid [not null, note: 'Direction which is used in the definition of the local z axis.; ref to ifc.direction; source: IfcStructuralCurveMember attribute 2: IfcDirection']
  Note: 'IfcStructuralCurveMember: Instances of IfcStructuralCurveMember describe edge members, i.e. structural analysis idealizations of beams, columns, rods etc.. Curve members may be straight or curved.'
