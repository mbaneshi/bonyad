Table ifc.recurrence_pattern {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.recurrence_pattern']
  recurrence_type text [not null, note: 'Defines the recurrence type that gives meaning to the used attributes and decides about possible attribute combinations, i.e. what attributes are needed to fully describe the pattern type.; source: IfcRecurrencePattern attribute 1: IfcRecurrenceTypeEnum; enumeration IfcRecurrenceTypeEnum']
  day_component int[] [note: 'The position of the specified day in a month. Unordered set.; source: IfcRecurrencePattern attribute 2: OPTIONAL SET [1:?] OF IfcDayInMonthNumber']
  weekday_component int[] [note: 'The weekday name of the specified day in a week. Unordered set.; source: IfcRecurrencePattern attribute 3: OPTIONAL SET [1:?] OF IfcDayInWeekNumber']
  month_component int[] [note: 'The position of the specified month in a year. Unordered set.; source: IfcRecurrencePattern attribute 4: OPTIONAL SET [1:?] OF IfcMonthInYearNumber']
  position int [note: 'The position of the specified component, e.g. the 3rd (position=3) Tuesday (weekday component) in a month.; source: IfcRecurrencePattern attribute 5: OPTIONAL IfcInteger']
  interval int [note: 'An interval can be given according to the pattern type.; source: IfcRecurrencePattern attribute 6: OPTIONAL IfcInteger']
  occurrences int [note: 'Defines the number of occurrences of this pattern, e.g. a weekly event might be defined to occur 5 times before it stops.; source: IfcRecurrencePattern attribute 7: OPTIONAL IfcInteger']
  Note: 'IfcRecurrencePattern: IfcRecurrencePattern defines repetitive time periods on the basis of regular recurrences such as each Monday in a week, or every third Tuesday in a month. The population of the remaining attributes such as DayComponent, Position, and Interval depend on the specified recurrence type.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

