  force_y float8 [note: 'Force value in y-direction.; source: IfcStructuralLoadSingleForce attribute 2: OPTIONAL IfcForceMeasure']
  force_z float8 [note: 'Force value in z-direction.; source: IfcStructuralLoadSingleForce attribute 3: OPTIONAL IfcForceMeasure']
