  panel_position text [not null, note: 'Position of this panel within the overall window style.; source: IfcWindowPanelProperties attribute 2: IfcWindowPanelPositionEnum; enumeration IfcWindowPanelPositionEnum']
  frame_depth float8 [note: 'Depth of panel frame, measured from front face to back face horizontally (i.e. perpendicular to the window (elevation) plane.; source: IfcWindowPanelProperties attribute 3: OPTIONAL IfcPositiveLengthMeasure']
  frame_thickness float8 [note: 'Width of panel frame, measured from inside of panel (at glazing) to outside of panel (at lining), i.e. parallel to the window (elevation) plane.; source: IfcWindowPanelProperties attribute 4: OPTIONAL IfcPositiveLengthMeasure']
  shape_aspect_style uuid [note: 'Optional link to a shape aspect definition, which points to the part of the geometric representation of the window style, which is used to represent the panel.; ref to ifc.shape_aspect; source: IfcWindowPanelProperties attribute 5: OPTIONAL IfcShapeAspect']
  Note: 'IfcWindowPanelProperties: A window panel is a casement, that is, a component, fixed or opening, consisting essentially of a frame and the infilling. The infilling of a window panel is normally glazing.'
