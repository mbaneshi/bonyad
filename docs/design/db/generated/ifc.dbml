  action_type text [not null, note: 'Type of actions in the group.; source: IfcStructuralLoadGroup attribute 2: IfcActionTypeEnum; enumeration IfcActionTypeEnum']
  action_source text [not null, note: 'Source of actions in the group.; source: IfcStructuralLoadGroup attribute 3: IfcActionSourceTypeEnum; enumeration IfcActionSourceTypeEnum']
  coefficient float8 [note: 'Load factor.; source: IfcStructuralLoadGroup attribute 4: OPTIONAL IfcRatioMeasure']
  purpose text [note: 'Description of the purpose of this instance.; source: IfcStructuralLoadGroup attribute 5: OPTIONAL IfcLabel']
  Note: 'IfcStructuralLoadGroup: The entity IfcStructuralLoadGroup is used to structure the physical impacts. By using the grouping features inherited from IfcGroup, instances of IfcStructuralAction (or its subclasses) and of IfcStructuralLoadGroup can be used to define load groups, load cases and load combinations.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

