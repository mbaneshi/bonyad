  moment_y float8 [note: 'Moment about the y-axis.; source: IfcStructuralLoadSingleForce attribute 5: OPTIONAL IfcTorqueMeasure']
  moment_z float8 [note: 'Moment about the z-axis.; source: IfcStructuralLoadSingleForce attribute 6: OPTIONAL IfcTorqueMeasure']
