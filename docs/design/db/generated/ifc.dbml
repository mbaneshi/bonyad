  predefined_type text [not null, note: 'Predefined type of the horizontal alignmnent segment.; source: IfcAlignmentHorizontalSegment attribute 7: IfcAlignmentHorizontalSegmentTypeEnum; enumeration IfcAlignmentHorizontalSegmentTypeEnum']
