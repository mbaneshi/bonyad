Table ifc."constraint" {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.metric, ifc.objective']
  name text [not null, note: 'A human-readable name to be used for the constraint.; source: IfcConstraint attribute 1: IfcLabel']
  description text [note: 'A human-readable description that may apply additional information about a constraint.; source: IfcConstraint attribute 2: OPTIONAL IfcText']
  constraint_grade text [not null, note: 'Enumeration that qualifies the type of constraint.; source: IfcConstraint attribute 3: IfcConstraintEnum; enumeration IfcConstraintEnum']
  constraint_source text [note: 'Any source material, such as a code or standard, from which the constraint originated.; source: IfcConstraint attribute 4: OPTIONAL IfcLabel']
  creating_actor uuid [note: 'Person and/or organization that has created the constraint.; ref to any; source: IfcConstraint attribute 5: OPTIONAL IfcActorSelect; via select IfcActorSelect']
  creation_time timestamptz [note: 'Time when information specifying the constraint instance was created.; source: IfcConstraint attribute 6: OPTIONAL IfcDateTime']
  user_defined_grade text [note: 'Allows for specification of user defined grade of the constraint beyond the enumeration values (hard, soft, advisory) provided by ConstraintGrade attribute of type IfcConstraintEnum.; source: IfcConstraint attribute 7: OPTIONAL IfcLabel']
  Note: 'IfcConstraint: An IfcConstraint is used to define a constraint or limiting value or boundary condition that may be applied to an object or to the value of a property.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

