  }
}

Table ifc.structural_load_temperature {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.structural_load_temperature']
  delta_t_constant float8 [note: 'Temperature change which affects the complete section of the structural member, or the uniform portion of a non-uniform temperature change.; source: IfcStructuralLoadTemperature attribute 1: OPTIONAL IfcThermodynamicTemperatureMeasure']
  delta_ty float8 [note: 'Non-uniform temperature change, specified as the difference of the temperature change at the outer fibre of the positive y direction minus the temperature change at the outer fibre of the negative y direction of the analysis member.; source: IfcStructuralLoadTemperature attribute 2: OPTIONAL IfcThermodynamicTemperatureMeasure']
  delta_tz float8 [note: 'Non-uniform temperature change, specified as the difference of the temperature change at the outer fibre of the positive z direction minus the temperature change at the outer fibre of the negative z direction of the analysis member.; source: IfcStructuralLoadTemperature attribute 3: OPTIONAL IfcThermodynamicTemperatureMeasure']
  Note: 'IfcStructuralLoadTemperature: An instance of the entity IfcStructuralLoadTemperature shall be used to define actions which are caused by a temperature change. As shown in Figure 1, the change of temperature is given with a constant value which is applied to the complete section and values for temperature differences between outer fibres of the section.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

