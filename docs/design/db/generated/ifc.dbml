  coordinate_space_dimension int [not null, note: 'The integer dimension count of the coordinate space modeled in a geometric representation context.; source: IfcGeometricRepresentationContext attribute 1: IfcDimensionCount']
  precision float8 [note: 'Value of the model precision for geometric models.; source: IfcGeometricRepresentationContext attribute 2: OPTIONAL IfcReal']
  world_coordinate_system uuid [not null, note: 'Establishment of the engineering coordinate system (often referred to as the world coordinate system in CAD) for all representation contexts used by the project.; ref to ifc.placement; source: IfcGeometricRepresentationContext attribute 3: IfcAxis2Placement; via select IfcAxis2Placement']
  true_north uuid [note: 'Direction of the true north, or geographic northing direction, relative to the underlying project coordinate system.; ref to ifc.direction; source: IfcGeometricRepresentationContext attribute 4: OPTIONAL IfcDirection']
  Note: 'IfcGeometricRepresentationContext: The IfcGeometricRepresentationContext defines the context that applies to several shape representations of products within a project. It defines the type of the context in which the shape representation is defined, and the numeric precision applicable to the geometric representation items defined in this context.'
