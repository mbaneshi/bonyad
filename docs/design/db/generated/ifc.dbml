  schedule_usage float8 [note: 'Indicates the amount of the resource used concurrently.; source: IfcResourceTime attribute 2: OPTIONAL IfcPositiveRatioMeasure']
  schedule_start timestamptz [note: 'Indicates the time when the resource is scheduled to start working.; source: IfcResourceTime attribute 3: OPTIONAL IfcDateTime']
  schedule_finish timestamptz [note: 'Indicates the time when the resource is scheduled to finish working.; source: IfcResourceTime attribute 4: OPTIONAL IfcDateTime']
  schedule_contour text [note: 'Indicates how a resource should be leveled over time by adjusting the resource usage according to a specified curve.; source: IfcResourceTime attribute 5: OPTIONAL IfcLabel']
  leveling_delay text [note: 'Indicates a delay in the ScheduleStart caused by leveling.; source: IfcResourceTime attribute 6: OPTIONAL IfcDuration']
  is_over_allocated boolean [note: 'Indicates that the resource is scheduled in excess of its capacity.; source: IfcResourceTime attribute 7: OPTIONAL IfcBoolean']
  status_time timestamptz [note: 'Indicates the date and time for which status values are applicable; particularly completion, actual, and remaining values.; source: IfcResourceTime attribute 8: OPTIONAL IfcDateTime']
  actual_work text [note: 'Indicates the actual work performed by the resource as of the StatusTime.; source: IfcResourceTime attribute 9: OPTIONAL IfcDuration']
  actual_usage float8 [note: 'Indicates the actual amount of the resource used concurrently.; source: IfcResourceTime attribute 10: OPTIONAL IfcPositiveRatioMeasure']
  actual_start timestamptz [note: 'Indicates the time when the resource actually started working.; source: IfcResourceTime attribute 11: OPTIONAL IfcDateTime']
  actual_finish timestamptz [note: 'Indicates the time when the resource actually finished working.; source: IfcResourceTime attribute 12: OPTIONAL IfcDateTime']
  remaining_work text [note: 'Indicates the work remaining to be completed by the resource.; source: IfcResourceTime attribute 13: OPTIONAL IfcDuration']
  remaining_usage float8 [note: 'RemainingUsage attribute of IfcResourceTime (not described in the source documentation).; source: IfcResourceTime attribute 14: OPTIONAL IfcPositiveRatioMeasure']
  completion float8 [note: 'Indicates the percent completion of this resource.; source: IfcResourceTime attribute 15: OPTIONAL IfcPositiveRatioMeasure']
