  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_associates_classification']
  relating_classification uuid [not null, note: 'Classification applied to the objects.; ref to any; source: IfcRelAssociatesClassification attribute 1: IfcClassificationSelect; via select IfcClassificationSelect']
  Note: 'IfcRelAssociatesClassification: The objectified relationship IfcRelAssociatesClassification handles the assignment of a classification item (items of the select IfcClassificationSelect) to object occurrences (subtypes of IfcObject) or object types (subtypes of IfcTypeObject).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_associates_constraint {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_associates_constraint']
  intent text [note: 'The intent of the constraint usage with regard to its related IfcConstraint and IfcObject, IfcPropertyDefinition or IfcRelationship entities.; source: IfcRelAssociatesConstraint attribute 1: OPTIONAL IfcLabel']
  relating_constraint uuid [not null, note: 'Reference to a constraint that is being applied using this relationship.; ref to ifc.constraint; source: IfcRelAssociatesConstraint attribute 2: IfcConstraint']
  Note: 'IfcRelAssociatesConstraint: The entity IfcRelAssociatesConstraint is used to apply constraint information defined by IfcConstraint, in the IfcConstraintResource schema, to subtypes of IfcRoot.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_associates_document {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_associates_document']
  relating_document uuid [not null, note: 'Document information or reference which is applied to the objects.; ref to any; source: IfcRelAssociatesDocument attribute 1: IfcDocumentSelect; via select IfcDocumentSelect']
  Note: 'IfcRelAssociatesDocument: The objectified relationship (IfcRelAssociatesDocument) handles the assignment of document information (items of the select IfcDocumentSelect) to object occurrences (subtypes of IfcObject) or object types (subtypes of IfcTypeObject).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_associates_library {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_associates_library']
  relating_library uuid [not null, note: 'Reference to a library, from which the definition of the property set is taken.; ref to any; source: IfcRelAssociatesLibrary attribute 1: IfcLibrarySelect; via select IfcLibrarySelect']
  Note: 'IfcRelAssociatesLibrary: The objectified relationship (IfcRelAssociatesLibrary) handles the assignment of a library item (items of the select IfcLibrarySelect) to subtypes of IfcObjectDefinition or IfcPropertyDefinition.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_associates_material {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_associates_material']
  relating_material uuid [not null, note: 'Material definition assigned to the elements or element types.; ref to any; source: IfcRelAssociatesMaterial attribute 1: IfcMaterialSelect; via select IfcMaterialSelect']
  Note: 'IfcRelAssociatesMaterial: IfcRelAssociatesMaterial is an objectified relationship between a material definition and elements or element types to which this material definition applies.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_associates_profile_def {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_associates_profile_def']
  relating_profile_def uuid [not null, note: 'The relating profile.; ref to ifc.profile_def; source: IfcRelAssociatesProfileDef attribute 1: IfcProfileDef']
  Note: 'IfcRelAssociatesProfileDef: Associates Objects with a profile definition.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_associates_related_objects {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
