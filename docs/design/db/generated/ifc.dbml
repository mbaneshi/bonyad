Table ifc."window" {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: ifc.window, ifc.window_standard_case']
  overall_height float8 [note: 'Overall measure of the height, it reflects the Z Dimension of a bounding box, enclosing the window opening.; source: IfcWindow attribute 1: OPTIONAL IfcPositiveLengthMeasure']
  overall_width float8 [note: 'Overall measure of the width, it reflects the X Dimension of a bounding box, enclosing the window opening.; source: IfcWindow attribute 2: OPTIONAL IfcPositiveLengthMeasure']
  predefined_type text [note: 'Predefined generic type for a window that is specified in an enumeration.; source: IfcWindow attribute 3: OPTIONAL IfcWindowTypeEnum; enumeration IfcWindowTypeEnum']
  partitioning_type text [note: 'Type defining the general layout of the window in terms of the partitioning of panels.; source: IfcWindow attribute 4: OPTIONAL IfcWindowTypePartitioningEnum; enumeration IfcWindowTypePartitioningEnum']
  user_defined_partitioning_type text [note: 'Designator for the user defined partitioning type, shall only be provided, if the value of PartitioningType is set to USERDEFINED.; source: IfcWindow attribute 5: OPTIONAL IfcLabel']
  Note: 'IfcWindow: The window is a building element that is predominately used to provide natural light and fresh air. It includes vertical opening but also horizontal opening such as skylights or light domes.'
