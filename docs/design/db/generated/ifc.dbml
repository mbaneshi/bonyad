  }
}

Table ifc.reinforcing_mesh {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.reinforcing_mesh']
  mesh_length float8 [note: 'Deprecated.; source: IfcReinforcingMesh attribute 1: OPTIONAL IfcPositiveLengthMeasure']
  mesh_width float8 [note: 'Deprecated.; source: IfcReinforcingMesh attribute 2: OPTIONAL IfcPositiveLengthMeasure']
  longitudinal_bar_nominal_diameter float8 [note: 'Deprecated.; source: IfcReinforcingMesh attribute 3: OPTIONAL IfcPositiveLengthMeasure']
  transverse_bar_nominal_diameter float8 [note: 'Deprecated.; source: IfcReinforcingMesh attribute 4: OPTIONAL IfcPositiveLengthMeasure']
  longitudinal_bar_cross_section_area float8 [note: 'Deprecated.; source: IfcReinforcingMesh attribute 5: OPTIONAL IfcAreaMeasure']
  transverse_bar_cross_section_area float8 [note: 'Deprecated.; source: IfcReinforcingMesh attribute 6: OPTIONAL IfcAreaMeasure']
  longitudinal_bar_spacing float8 [note: 'Deprecated.; source: IfcReinforcingMesh attribute 7: OPTIONAL IfcPositiveLengthMeasure']
  transverse_bar_spacing float8 [note: 'Deprecated.; source: IfcReinforcingMesh attribute 8: OPTIONAL IfcPositiveLengthMeasure']
  predefined_type text [note: 'Kind of mesh.; source: IfcReinforcingMesh attribute 9: OPTIONAL IfcReinforcingMeshTypeEnum; enumeration IfcReinforcingMeshTypeEnum']
  Note: 'IfcReinforcingMesh: A reinforcing mesh is a series of longitudinal and transverse wires or bars of various gauges, arranged at right angles to each other and welded at all points of intersection; usually used for concrete slab reinforcement. It is also known as welded wire fabric.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.reinforcing_mesh_type {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.reinforcing_mesh_type']
  predefined_type text [not null, note: 'Subtype of reinforcing mesh.; source: IfcReinforcingMeshType attribute 1: IfcReinforcingMeshTypeEnum; enumeration IfcReinforcingMeshTypeEnum']
  mesh_length float8 [note: 'The overall length of the mesh measured in its longitudinal direction.; source: IfcReinforcingMeshType attribute 2: OPTIONAL IfcPositiveLengthMeasure']
  mesh_width float8 [note: 'The overall width of the mesh measured in its transversal direction.; source: IfcReinforcingMeshType attribute 3: OPTIONAL IfcPositiveLengthMeasure']
  longitudinal_bar_nominal_diameter float8 [note: 'The nominal diameter denoting the cross-section size of the longitudinal bars.; source: IfcReinforcingMeshType attribute 4: OPTIONAL IfcPositiveLengthMeasure']
  transverse_bar_nominal_diameter float8 [note: 'The nominal diameter denoting the cross-section size of the transverse bars.; source: IfcReinforcingMeshType attribute 5: OPTIONAL IfcPositiveLengthMeasure']
  longitudinal_bar_cross_section_area float8 [note: 'The effective cross-section area of the longitudinal bars of the mesh.; source: IfcReinforcingMeshType attribute 6: OPTIONAL IfcAreaMeasure']
  transverse_bar_cross_section_area float8 [note: 'The effective cross-section area of the transverse bars of the mesh.; source: IfcReinforcingMeshType attribute 7: OPTIONAL IfcAreaMeasure']
  longitudinal_bar_spacing float8 [note: 'The spacing between the longitudinal bars.; source: IfcReinforcingMeshType attribute 8: OPTIONAL IfcPositiveLengthMeasure']
  transverse_bar_spacing float8 [note: 'The spacing between the transverse bars.; source: IfcReinforcingMeshType attribute 9: OPTIONAL IfcPositiveLengthMeasure']
  bending_shape_code text [note: 'If this mesh type is bent rather than planar, this attribute provides a shape code per a standard like ACI 315, ISO 3766, or a similar standard.; source: IfcReinforcingMeshType attribute 10: OPTIONAL IfcLabel']
  bending_parameters text[] [note: 'If this mesh type is bent rather than planar, this attribute provides bending shape parameters.; source: IfcReinforcingMeshType attribute 11: OPTIONAL LIST [1:?] OF IfcBendingParameterSelect; elements are SELECT IfcBendingParameterSelect of value types, stored as text (the member type tag is not kept)']
  Note: 'IfcReinforcingMeshType: The reinforcing element type IfcReinforcingMeshType defines commonly shared information for occurrences of reinforcing meshs.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table ifc.rel_adheres_to_element {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'ifc.rel_adheres_to_element']
  relating_element uuid [not null, note: 'Element to which the IfcSurfaceFeature is adhered to.; ref to ifc.element; source: IfcRelAdheresToElement attribute 1: IfcElement']
  Note: 'IfcRelAdheresToElement: The IfcRelAdheresToElement is an objectified relationship between an element and one to many surface feature elements that adhere to the surface of the element. The relationship is defined to be a 1 to many relationship.'
