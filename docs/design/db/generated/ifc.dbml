  start_radius_of_curvature float8 [not null, note: 'For a NONLINEAR horizontal segment type the radius of the curve at the start point (Placement of the segment).; source: IfcAlignmentHorizontalSegment attribute 3: IfcLengthMeasure']
  end_radius_of_curvature float8 [not null, note: 'For a NONLINEAR horizontal segment type the radius of the curve at the end point.; source: IfcAlignmentHorizontalSegment attribute 4: IfcLengthMeasure']
