Table usd.material_binding_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.material_binding_api']
  Note: 'MaterialBindingAPI: UsdShadeMaterialBindingAPI is an API schema that provides an interface for binding materials to prims or collections of prims (represented by UsdCollectionAPI objects). In the USD shading model, each renderable gprim computes a single resolved Material that will be used to shade the gprim (exceptions, of course, for gprims that possess UsdGeomSubsets, as each subset can be ...'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.material_x_config_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.material_x_config_api']
  config_mtlx_version text [not null, default: '1.38', note: 'MaterialX library version that the data has been authored against. Varying: may carry time samples (animatable).; source: string config:mtlx:version']
  Note: 'MaterialXConfigAPI: MaterialXConfigAPI is an API schema that provides an interface for storing information about the MaterialX environment. Initially, it only exposes an interface to record the MaterialX library version that data was authored against.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.mesh {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.mesh']
  face_vertex_indices int[] [note: 'Flat list of the index (into the points attribute) of each vertex of each face in the mesh. Varying: may carry time samples (animatable).; source: int[] faceVertexIndices']
  face_vertex_counts int[] [note: 'Provides the number of vertices in each face of the mesh, which is also the number of consecutive indices in faceVertexIndices that define the face. Varying: may carry time samples (animatable).; source: int[] faceVertexCounts']
  subdivision_scheme text [not null, default: 'catmullClark', note: 'The subdivision scheme to be applied to the surface. Uniform: one value, not time-sampled.; source: uniform token subdivisionScheme']
  interpolate_boundary text [not null, default: 'edgeAndCorner', note: 'Specifies how subdivision is applied for faces adjacent to boundary edges and boundary points. Varying: may carry time samples (animatable).; source: token interpolateBoundary']
  face_varying_linear_interpolation text [not null, default: 'cornersPlus1', note: 'Specifies how elements of a primvar of interpolation type "faceVarying" are interpolated for subdivision surfaces. Varying: may carry time samples (animatable).; source: token faceVaryingLinearInterpolation']
  triangle_subdivision_rule text [not null, default: 'catmullClark', note: 'Specifies an option to the subdivision rules for the Catmull-Clark scheme to try and improve undesirable artifacts when subdividing triangles. Varying: may carry time samples (animatable).; source: token triangleSubdivisionRule']
  hole_indices int[] [note: 'The indices of all faces that should be treated as holes, i.e. made invisible. Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: int[] holeIndices']
  corner_indices int[] [note: 'The indices of points for which a corresponding sharpness value is specified in cornerSharpnesses (so the size of this array must match that of cornerSharpnesses). Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: int[] cornerIndices']
  corner_sharpnesses float8[] [note: 'The sharpness values associated with a corresponding set of points specified in cornerIndices (so the size of this array must match that of cornerIndices). Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: float[] cornerSharpnesses']
  crease_indices int[] [note: 'The indices of points grouped into sets of successive pairs that identify edges to be creased. Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: int[] creaseIndices']
  crease_lengths int[] [note: 'The length of this array specifies the number of creases (sets of adjacent sharpened edges) on the mesh. Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: int[] creaseLengths']
  crease_sharpnesses float8[] [note: 'The per-crease or per-edge sharpness values for all creases. Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: float[] creaseSharpnesses']
  Note: 'Mesh: Encodes a mesh with optional subdivision properties and features. As a point-based primitive, meshes are defined in terms of points that are connected into edges and faces.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.mesh_light_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
