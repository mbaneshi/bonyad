Table usd.claims_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.claims_api']
  Note: 'ClaimsAPI: UsdClaimsAPI records a prim\'s profile compatibility claims and per-capability usage declarations. It provides two tiers of data, stored as sub-dictionaries within the prim\'s profilesInfo metadata dictionary (analogous to assetInfo): Capability Usage (DCC-authored) The capability usage tier records which USD capabilities this prim actually uses, together with a degradation ...'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.clips_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.clips_api']
  Note: 'ClipsAPI: UsdClipsAPI is an API schema that provides an interface to a prim\'s clip metadata. Clips are a "value resolution" feature that allows one to specify a sequence of usd files (clips) to be consulted, over time, as a source of varying overrides for the prims at and beneath this prim in namespace.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.collection_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.collection_api']
  expansion_rule text [not null, default: 'expandPrims', note: 'Specifies how the paths that are included in the collection must be expanded to determine its members. Uniform: one value, not time-sampled.; source: uniform token collection:<instanceName>:expansionRule']
  include_root boolean [note: 'Boolean attribute indicating whether the pseudo-root path </> should be counted as one of the included target paths. Uniform: one value, not time-sampled.; source: uniform bool collection:<instanceName>:includeRoot']
  includes uuid [note: 'Specifies a list of targets that are included in the collection. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel collection:<instanceName>:includes']
  excludes uuid [note: 'Specifies a list of targets that are excluded below the included paths in this collection. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel collection:<instanceName>:excludes']
  membership_expression text [note: 'Specifies a path expression that determines membership in this collection. Uniform: one value, not time-sampled.; source: uniform pathExpression collection:<instanceName>:membershipExpression']
  mode text [not null, default: 'automatic', note: 'Specifies which mode the collection uses to determine membership: automatic, relationship, or expression. Uniform: one value, not time-sampled.; source: uniform token collection:<instanceName>:mode']
  Note: 'CollectionAPI: A general purpose API schema used to describe a collection of prims and properties within a scene. This API schema can be applied to a prim multiple times with different instance names to define several collections on a single prim.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.color_space_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.color_space_api']
  color_space_name text [note: 'The color space that applies to attributes with unauthored color spaces on this prim and its descendents. Uniform: one value, not time-sampled.; source: uniform token colorSpace:name']
  Note: 'ColorSpaceAPI: UsdColorSpaceAPI is an API schema that introduces a colorSpace property for authoring scene referred color space opinions. It also provides a mechanism to determine the applicable color space within a scope through inheritance.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.color_space_definition_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.color_space_definition_api']
  name text [not null, default: 'custom', note: 'The name of the color space defined on this prim. Uniform: one value, not time-sampled.; source: uniform token colorSpaceDefinition:<instanceName>:name']
  red_chroma_x float8 [not null, default: 1, note: 'Red chromaticity coordinates Varying: may carry time samples (animatable). (x); source: float2 colorSpaceDefinition:<instanceName>:redChroma']
  red_chroma_y float8 [not null, default: 0, note: 'Red chromaticity coordinates Varying: may carry time samples (animatable). (y); source: float2 colorSpaceDefinition:<instanceName>:redChroma']
  green_chroma_x float8 [not null, default: 0, note: 'Green chromaticity coordinates Varying: may carry time samples (animatable). (x); source: float2 colorSpaceDefinition:<instanceName>:greenChroma']
  green_chroma_y float8 [not null, default: 1, note: 'Green chromaticity coordinates Varying: may carry time samples (animatable). (y); source: float2 colorSpaceDefinition:<instanceName>:greenChroma']
  blue_chroma_x float8 [not null, default: 0, note: 'Blue chromaticity coordinates Varying: may carry time samples (animatable). (x); source: float2 colorSpaceDefinition:<instanceName>:blueChroma']
  blue_chroma_y float8 [not null, default: 0, note: 'Blue chromaticity coordinates Varying: may carry time samples (animatable). (y); source: float2 colorSpaceDefinition:<instanceName>:blueChroma']
  white_point_x float8 [not null, default: 0.33333333, note: 'Whitepoint chromaticity coordinates Varying: may carry time samples (animatable). (x); source: float2 colorSpaceDefinition:<instanceName>:whitePoint']
  white_point_y float8 [not null, default: 0.33333333, note: 'Whitepoint chromaticity coordinates Varying: may carry time samples (animatable). (y); source: float2 colorSpaceDefinition:<instanceName>:whitePoint']
  gamma float8 [not null, default: 1, note: 'Gamma value of the log section Varying: may carry time samples (animatable).; source: float colorSpaceDefinition:<instanceName>:gamma']
  linear_bias float8 [not null, default: 0, note: 'Linear bias of the log section Varying: may carry time samples (animatable).; source: float colorSpaceDefinition:<instanceName>:linearBias']
  Note: 'ColorSpaceDefinitionAPI: UsdColorSpaceDefinitionAPI is an API schema for defining a custom color space. Custom color spaces become available for use on prims or for assignment to attributes via the colorSpace:name property on prims that have applied UsdColorSpaceAPI.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.cone {
