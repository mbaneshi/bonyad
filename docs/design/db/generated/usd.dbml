  value_z float8 [not null, note: 'Element value (half3). Varying: may carry time samples (animatable). (z); source: half3[] scalesh']
  Note: 'ParticleFieldScaleAttributeAPI.scalesh: One element of the ordered half3[] array scalesh of ParticleFieldScaleAttributeAPI. Affine linear scale factor applied to the kernel that is instantiated at each particle.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.particle_field_spherical_harmonics_attr_api {
