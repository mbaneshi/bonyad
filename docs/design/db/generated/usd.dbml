  value_y float8 [not null, note: 'Element value (float3). Varying: may carry time samples (animatable). (y); source: float3[] extent']
  value_z float8 [not null, note: 'Element value (float3). Varying: may carry time samples (animatable). (z); source: float3[] extent']
  Note: 'Sphere.extent: One element of the ordered float3[] array extent of Sphere. Extent is re-defined on Sphere only to provide a fallback value.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.sphere_light {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.sphere_light']
  light_shader_id text [not null, default: 'SphereLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  inputs_radius float8 [not null, default: 0.5, note: 'Radius of the sphere. Varying: may carry time samples (animatable).; source: float inputs:radius']
  treat_as_point boolean [not null, default: false, note: 'A hint that this light can be treated as a \'point\' light (effectively, a zero-radius sphere) by renderers that benefit from non-area lighting. Varying: may carry time samples (animatable).; source: bool treatAsPoint']
  Note: 'SphereLight: Light emitted outward from a sphere.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.statements_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.statements_api']
  Note: 'StatementsAPI: Container namespace schema for all renderman statements. The longer term goal is for clients to go directly to primvar or render-attribute API\'s, instead of using UsdRi StatementsAPI for inherited attributes.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.tet_mesh {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.tet_mesh']
  Note: 'TetMesh: Encodes a tetrahedral mesh. A tetrahedral mesh is defined as a set of tetrahedra.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.tet_mesh_surface_face_vertex_indices {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value int[] [not null, note: 'Element value (int3), fixed length 3. Varying: may carry time samples (animatable).; source: int3[] surfaceFaceVertexIndices']
  Note: 'TetMesh.surfaceFaceVertexIndices: One element of the ordered int3[] array surfaceFaceVertexIndices of TetMesh. surfaceFaceVertexIndices defines the triangle surface faces indices wrt.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.tet_mesh_tet_vertex_indices {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value int[] [not null, note: 'Element value (int4), fixed length 4. Varying: may carry time samples (animatable).; source: int4[] tetVertexIndices']
  Note: 'TetMesh.tetVertexIndices: One element of the ordered int4[] array tetVertexIndices of TetMesh. Flat list of the index (into the points attribute) of each vertex of each tetrahedron in the mesh.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.visibility_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.visibility_api']
  guide_visibility text [not null, default: 'invisible', note: 'This attribute controls visibility for geometry with purpose "guide". Uniform: one value, not time-sampled.; source: uniform token guideVisibility']
  proxy_visibility text [not null, default: 'inherited', note: 'This attribute controls visibility for geometry with purpose "proxy". Uniform: one value, not time-sampled.; source: uniform token proxyVisibility']
  render_visibility text [not null, default: 'inherited', note: 'This attribute controls visibility for geometry with purpose "render". Uniform: one value, not time-sampled.; source: uniform token renderVisibility']
  Note: 'VisibilityAPI: UsdGeomVisibilityAPI introduces properties that can be used to author visibility opinions. Currently, this schema only introduces the attributes that are used to control purpose visibility.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.volume {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.volume']
  Note: 'Volume: A renderable volume primitive. A volume is made up of any number of FieldBase primitives bound together in this volume.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.volume_light_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.volume_light_api']
  light_shader_id text [not null, default: 'VolumeLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  light_material_sync_mode text [not null, default: 'materialGlowTintsLight', note: 'Property light:materialSyncMode (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:materialSyncMode']
  Note: 'VolumeLightAPI: This is the preferred API schema to apply to Volume type prims when adding light behaviors to a volume. At its base, this API schema has the built-in behavior of applying LightAPI to the volume and overriding the default materialSyncMode to allow the emission/glow of the bound material to affect the color of the light.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.xform {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.xform']
  Note: 'Xform: Concrete prim schema for a transform, which implements Xformable'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.xform_common_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.xform_common_api']
  Note: 'XformCommonAPI: This class provides API for authoring and retrieving a standard set of component transformations which include a scale, a rotation, a scale-rotate pivot and a translation. The goal of the API is to enhance component-wise interchange.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

