  value_y float8 [not null, note: 'Element value (double2). Varying: may carry time samples (animatable). (y); source: double2[] ranges']
  Note: 'NurbsCurves.ranges: One element of the ordered double2[] array ranges of NurbsCurves. Provides the minimum and maximum parametric values (as defined by knots) over which the curve is actually defined.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.nurbs_patch {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.nurbs_patch']
  u_vertex_count int [note: 'Number of vertices in the U direction. Varying: may carry time samples (animatable).; source: int uVertexCount']
  v_vertex_count int [note: 'Number of vertices in the V direction. Varying: may carry time samples (animatable).; source: int vVertexCount']
  u_order int [note: 'Order in the U direction. Varying: may carry time samples (animatable).; source: int uOrder']
  v_order int [note: 'Order in the V direction. Varying: may carry time samples (animatable).; source: int vOrder']
  u_knots float8[] [note: 'Knot vector for U direction providing U parameterization. Varying: may carry time samples (animatable).; source: double[] uKnots']
  v_knots float8[] [note: 'Knot vector for V direction providing U parameterization. Varying: may carry time samples (animatable).; source: double[] vKnots']
  u_form text [not null, default: 'open', note: 'Interpret the control grid and knot vectors as representing an open, geometrically closed, or geometrically closed and C2 continuous surface along the U dimension. Uniform: one value, not time-sampled.; source: uniform token uForm']
  v_form text [not null, default: 'open', note: 'Interpret the control grid and knot vectors as representing an open, geometrically closed, or geometrically closed and C2 continuous surface along the V dimension. Uniform: one value, not time-sampled.; source: uniform token vForm']
  u_range_x float8 [note: 'Provides the minimum and maximum parametric values (as defined by uKnots) over which the surface is actually defined. Varying: may carry time samples (animatable). (x); source: double2 uRange']
  u_range_y float8 [note: 'Provides the minimum and maximum parametric values (as defined by uKnots) over which the surface is actually defined. Varying: may carry time samples (animatable). (y); source: double2 uRange']
  v_range_x float8 [note: 'Provides the minimum and maximum parametric values (as defined by vKnots) over which the surface is actually defined. Varying: may carry time samples (animatable). (x); source: double2 vRange']
  v_range_y float8 [note: 'Provides the minimum and maximum parametric values (as defined by vKnots) over which the surface is actually defined. Varying: may carry time samples (animatable). (y); source: double2 vRange']
  point_weights float8[] [note: 'Optionally provides "w" components for each control point, thus must be the same length as the points attribute. Varying: may carry time samples (animatable).; source: double[] pointWeights']
  trim_curve_counts int[] [note: 'Each element specifies how many curves are present in each "loop" of the trimCurve, and the length of the array determines how many loops the trimCurve contains. Varying: may carry time samples (animatable).; source: int[] trimCurve:counts']
  trim_curve_orders int[] [note: 'Flat list of orders for each of the nCurves curves. Varying: may carry time samples (animatable).; source: int[] trimCurve:orders']
  trim_curve_vertex_counts int[] [note: 'Flat list of number of vertices for each of the nCurves curves. Varying: may carry time samples (animatable).; source: int[] trimCurve:vertexCounts']
  trim_curve_knots float8[] [note: 'Flat list of parametric values for each of the nCurves curves. Varying: may carry time samples (animatable).; source: double[] trimCurve:knots']
  Note: 'NurbsPatch: Encodes a rational or polynomial non-uniform B-spline surface, with optional trim curves. html#rinupatch , with some minor renaming and coalescing for clarity.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

