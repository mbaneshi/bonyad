  physics_cone_angle0limit float8 [not null, default: -1, note: 'Cone limit from the primary joint axis in the local0 frame toward the next axis. Varying: may carry time samples (animatable).; source: float physics:coneAngle0Limit']
  physics_cone_angle1limit float8 [not null, default: -1, note: 'Cone limit from the primary joint axis in the local0 frame toward the second to next axis. Varying: may carry time samples (animatable).; source: float physics:coneAngle1Limit']
  Note: 'PhysicsSphericalJoint: ) It allows two limit values, which when equal create a circular, else an elliptic cone limit around the limit axis.'
