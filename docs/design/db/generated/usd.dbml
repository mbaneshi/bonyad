  horizontal_aperture_offset float8 [not null, default: 0, note: 'Horizontal aperture offset in the same units as horizontalAperture. Varying: may carry time samples (animatable).; source: float horizontalApertureOffset']
  vertical_aperture_offset float8 [not null, default: 0, note: 'Vertical aperture offset in the same units as verticalAperture. Varying: may carry time samples (animatable).; source: float verticalApertureOffset']
  focal_length float8 [not null, default: 50, note: 'Perspective focal length in tenths of a scene unit; see UsdGeom_CameraUnits . Varying: may carry time samples (animatable).; source: float focalLength']
  clipping_range_x float8 [not null, default: 1, note: 'Near and far clipping distances in scene units; see UsdGeom_CameraUnits . Varying: may carry time samples (animatable). (x); source: float2 clippingRange']
  clipping_range_y float8 [not null, default: 1000000, note: 'Near and far clipping distances in scene units; see UsdGeom_CameraUnits . Varying: may carry time samples (animatable). (y); source: float2 clippingRange']
  f_stop float8 [not null, default: 0, note: 'Lens aperture. Varying: may carry time samples (animatable).; source: float fStop']
  focus_distance float8 [not null, default: 0, note: 'Distance from the camera to the focus plane in scene units; see UsdGeom_CameraUnits . Varying: may carry time samples (animatable).; source: float focusDistance']
  stereo_role text [not null, default: 'mono', note: 'If different from mono, the camera is intended to be the left or right camera of a stereo setup. Uniform: one value, not time-sampled.; source: uniform token stereoRole']
  shutter_open float8 [not null, default: 0, note: 'Frame relative shutter open time in UsdTimeCode units (negative value indicates that the shutter opens before the current frame time). Varying: may carry time samples (animatable).; source: double shutter:open']
  shutter_close float8 [not null, default: 0, note: 'Frame relative shutter close time, analogous comments from shutter:open apply. Varying: may carry time samples (animatable).; source: double shutter:close']
  exposure float8 [not null, default: 0, note: 'Exposure compensation, as a log base-2 value. Varying: may carry time samples (animatable).; source: float exposure']
  exposure_iso float8 [not null, default: 100, note: 'The speed rating of the sensor or film when calculating exposure. Varying: may carry time samples (animatable).; source: float exposure:iso']
  exposure_time float8 [not null, default: 1, note: 'Time in seconds that the sensor is exposed to light when calculating exposure. Varying: may carry time samples (animatable).; source: float exposure:time']
  exposure_f_stop float8 [not null, default: 1, note: 'f-stop of the aperture when calculating exposure. Varying: may carry time samples (animatable).; source: float exposure:fStop']
  exposure_responsivity float8 [not null, default: 1, note: 'Scalar multiplier representing overall responsivity of the sensor system to light when calculating exposure. Varying: may carry time samples (animatable).; source: float exposure:responsivity']
  Note: 'Camera: Transformable camera. Describes optical properties of a camera via a common set of attributes that provide control over the camera\'s frustum as well as its depth of field.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.camera_clipping_planes {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
