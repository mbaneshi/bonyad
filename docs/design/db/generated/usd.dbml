Table usd.material {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.material']
  outputs_surface text [note: 'Represents the universal "surface" output terminal of a material. Varying: may carry time samples (animatable).; source: token outputs:surface']
  outputs_displacement text [note: 'Represents the universal "displacement" output terminal of a material. Varying: may carry time samples (animatable).; source: token outputs:displacement']
  outputs_volume text [note: 'Represents the universal "volume" output terminal of a material. Varying: may carry time samples (animatable).; source: token outputs:volume']
  Note: 'Material: A Material provides a container into which multiple "render contexts" can add data that defines a "shading material" for a renderer. Typically this consists of one or more UsdShadeOutput properties connected to outputs of nested Shader prims - though a context/client is free to add any data that is suitable.'
