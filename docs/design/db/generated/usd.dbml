  kind text [not null, default: 'usd.hydra_prim_api']
  hydra_expand_instances boolean [not null, default: false, note: 'This property can be used to de-instance the Hydra scene index representation of prims that were otherwise instanceable in the USD scenegraph. Uniform: one value, not time-sampled.; source: uniform bool hydra:expandInstances']
  Note: 'HydraPrimAPI: Provides Hydra-specific prim settings.'
