Table usd.physics_articulation_root_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_articulation_root_api']
  Note: 'PhysicsArticulationRootAPI: PhysicsArticulationRootAPI can be applied to a scene graph node, and marks the subtree rooted here for inclusion in one or more reduced coordinate articulations. For floating articulations, this should be on the root body.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.physics_collision_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_collision_api']
  physics_collision_enabled boolean [not null, default: true, note: 'Determines if the PhysicsCollisionAPI is enabled. Varying: may carry time samples (animatable).; source: bool physics:collisionEnabled']
  physics_simulation_owner uuid [note: 'Single PhysicsScene that will simulate this collider. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel physics:simulationOwner']
  Note: 'PhysicsCollisionAPI: Applies collision attributes to a UsdGeomXformable prim. If a simulation is running, this geometry will collide with other geometries that have PhysicsCollisionAPI applied.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.physics_collision_group {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_collision_group']
  physics_filtered_groups uuid [note: 'References a list of PhysicsCollisionGroups with which collisions should be ignored. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel physics:filteredGroups']
  physics_merge_group text [note: 'If non-empty, any collision groups in a stage with a matching mergeGroup should be considered to refer to the same collection. Varying: may carry time samples (animatable).; source: string physics:mergeGroup']
  physics_invert_filtered_groups boolean [note: 'Normally, the filter will disable collisions against the selected filter groups. Varying: may carry time samples (animatable).; source: bool physics:invertFilteredGroups']
  Note: 'PhysicsCollisionGroup: Defines a collision group for coarse filtering. When a collision occurs between two objects that have a PhysicsCollisionGroup assigned, they will collide with each other unless this PhysicsCollisionGroup pair is filtered.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.physics_joint {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: usd.physics_distance_joint, usd.physics_fixed_joint, usd.physics_joint, usd.physics_prismatic_joint, usd.physics_revolute_joint, usd.physics_spherical_joint']
  physics_body0 uuid [note: 'Relationship to any UsdGeomXformable. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel physics:body0']
  physics_body1 uuid [note: 'Relationship to any UsdGeomXformable. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel physics:body1']
  physics_local_pos0_x float8 [not null, default: 0, note: 'Relative position of the joint frame to body0\'s frame. Varying: may carry time samples (animatable). (x); source: point3f physics:localPos0']
  physics_local_pos0_y float8 [not null, default: 0, note: 'Relative position of the joint frame to body0\'s frame. Varying: may carry time samples (animatable). (y); source: point3f physics:localPos0']
  physics_local_pos0_z float8 [not null, default: 0, note: 'Relative position of the joint frame to body0\'s frame. Varying: may carry time samples (animatable). (z); source: point3f physics:localPos0']
  physics_local_rot0 float8[] [note: 'Relative orientation of the joint frame to body0\'s frame. (quaternion, four floats) Varying: may carry time samples (animatable). Fallback value in schema.usda: [1,0,0,0].; source: quatf physics:localRot0']
  physics_local_pos1_x float8 [not null, default: 0, note: 'Relative position of the joint frame to body1\'s frame. Varying: may carry time samples (animatable). (x); source: point3f physics:localPos1']
  physics_local_pos1_y float8 [not null, default: 0, note: 'Relative position of the joint frame to body1\'s frame. Varying: may carry time samples (animatable). (y); source: point3f physics:localPos1']
  physics_local_pos1_z float8 [not null, default: 0, note: 'Relative position of the joint frame to body1\'s frame. Varying: may carry time samples (animatable). (z); source: point3f physics:localPos1']
  physics_local_rot1 float8[] [note: 'Relative orientation of the joint frame to body1\'s frame. (quaternion, four floats) Varying: may carry time samples (animatable). Fallback value in schema.usda: [1,0,0,0].; source: quatf physics:localRot1']
  physics_joint_enabled boolean [not null, default: true, note: 'Determines if the joint is enabled. Varying: may carry time samples (animatable).; source: bool physics:jointEnabled']
  physics_collision_enabled boolean [not null, default: false, note: 'Determines if the jointed subtrees should collide or not. Varying: may carry time samples (animatable).; source: bool physics:collisionEnabled']
  physics_exclude_from_articulation boolean [not null, default: false, note: 'Determines if the joint can be included in an Articulation. Uniform: one value, not time-sampled.; source: uniform bool physics:excludeFromArticulation']
  physics_break_force float8 [note: 'Joint break force. Varying: may carry time samples (animatable). Fallback value is inf.; source: float physics:breakForce']
  physics_break_torque float8 [note: 'Joint break torque. Varying: may carry time samples (animatable). Fallback value is inf.; source: float physics:breakTorque']
  Note: 'PhysicsJoint: A joint constrains the movement of rigid bodies. Joint can be created between two rigid bodies or between one rigid body and world.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table usd.physics_distance_joint {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_distance_joint']
  physics_min_distance float8 [not null, default: -1, note: 'Minimum distance. Varying: may carry time samples (animatable).; source: float physics:minDistance']
  physics_max_distance float8 [not null, default: -1, note: 'Maximum distance. Varying: may carry time samples (animatable).; source: float physics:maxDistance']
  Note: 'PhysicsDistanceJoint: Predefined distance joint type (Distance between rigid bodies may be limited to given minimum or maximum distance.)'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.physics_drive_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_drive_api']
  physics_type text [not null, default: 'force', note: 'Drive spring is for the acceleration at the joint (rather than the force). Uniform: one value, not time-sampled.; source: uniform token drive:<instanceName>:physics:type']
  physics_max_force float8 [note: 'Maximum force that can be applied to drive. Varying: may carry time samples (animatable). Fallback value is inf.; source: float drive:<instanceName>:physics:maxForce']
  physics_target_position float8 [not null, default: 0, note: 'Target value for position. Varying: may carry time samples (animatable).; source: float drive:<instanceName>:physics:targetPosition']
  physics_target_velocity float8 [not null, default: 0, note: 'Target value for velocity. Varying: may carry time samples (animatable).; source: float drive:<instanceName>:physics:targetVelocity']
  physics_damping float8 [not null, default: 0, note: 'Damping of the drive. Varying: may carry time samples (animatable).; source: float drive:<instanceName>:physics:damping']
  physics_stiffness float8 [not null, default: 0, note: 'Stiffness of the drive. Varying: may carry time samples (animatable).; source: float drive:<instanceName>:physics:stiffness']
  Note: 'PhysicsDriveAPI: The PhysicsDriveAPI when applied to any joint primitive will drive the joint towards a given target. The PhysicsDriveAPI is a multipleApply schema: drive can be set per axis "transX", "transY", "transZ", "rotX", "rotY", "rotZ" or its "linear" for prismatic joint or "angular" for revolute joints.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.physics_filtered_pairs_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_filtered_pairs_api']
  physics_filtered_pairs uuid [note: 'Relationship to objects that should be filtered. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel physics:filteredPairs']
  Note: 'PhysicsFilteredPairsAPI: API to describe fine-grained filtering. If a collision between two objects occurs, this pair might be filtered if the pair is defined through this API.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.physics_fixed_joint {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_fixed_joint']
  Note: 'PhysicsFixedJoint: Predefined fixed joint type (All degrees of freedom are removed.)'
