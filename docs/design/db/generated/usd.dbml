  blend_shapes text[] [note: 'Array of tokens identifying which blend shapes this animation\'s data applies to. Uniform: one value, not time-sampled.; source: uniform token[] blendShapes']
  blend_shape_weights float8[] [note: 'Array of weight values for each blend shape. Varying: may carry time samples (animatable).; source: float[] blendShapeWeights']
  Note: 'SkelAnimation: Describes a skel animation, where joint animation is stored in a vectorized form. See the extended Skel Animation documentation for more information.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.skel_animation_rotations {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value float8[] [not null, note: 'Element value (quatf), quaternion, four floats. Varying: may carry time samples (animatable).; source: quatf[] rotations']
  Note: 'SkelAnimation.rotations: One element of the ordered quatf[] array rotations of SkelAnimation. Joint-local unit quaternion rotations of all affected joints, in 32-bit precision.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.skel_animation_scales {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (half3). Varying: may carry time samples (animatable). (x); source: half3[] scales']
  value_y float8 [not null, note: 'Element value (half3). Varying: may carry time samples (animatable). (y); source: half3[] scales']
  value_z float8 [not null, note: 'Element value (half3). Varying: may carry time samples (animatable). (z); source: half3[] scales']
  Note: 'SkelAnimation.scales: One element of the ordered half3[] array scales of SkelAnimation. Joint-local scales of all affected joints, in 16 bit precision.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

