Table usd.spatial_audio {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.spatial_audio']
  file_path text [note: 'Path to the audio file. Uniform: one value, not time-sampled. Holds an asset path.; source: uniform asset filePath']
  aural_mode text [not null, default: 'spatial', note: 'Determines how audio should be played. Uniform: one value, not time-sampled.; source: uniform token auralMode']
  playback_mode text [not null, default: 'onceFromStart', note: 'Along with startTime and endTime, determines when the audio playback should start and stop during the stage\'s animation playback and whether the audio should loop during its duration. Uniform: one value, not time-sampled.; source: uniform token playbackMode']
  start_time float8 [not null, default: 0, note: 'Expressed in the timeCodesPerSecond of the containing stage, startTime specifies when the audio stream will start playing during animation playback. Uniform: one value, not time-sampled. Holds a time code.; source: uniform timecode startTime']
  end_time float8 [not null, default: 0, note: 'Expressed in the timeCodesPerSecond of the containing stage, endTime specifies when the audio stream will cease playing during animation playback if the length of the referenced audio clip is longer than desired. Uniform: one value, not time-sampled. Holds a time code.; source: uniform timecode endTime']
  media_offset float8 [not null, default: 0, note: 'Expressed in seconds, mediaOffset specifies the offset from the referenced audio file\'s beginning at which we should begin playback when stage playback reaches the time that prim\'s audio should start. Uniform: one value, not time-sampled.; source: uniform double mediaOffset']
  gain float8 [not null, default: 1, note: 'Multiplier on the incoming audio signal. Varying: may carry time samples (animatable).; source: double gain']
  Note: 'SpatialAudio: The SpatialAudio primitive defines basic properties for encoding playback of an audio file or stream within a USD Stage. The SpatialAudio schema derives from UsdGeomXformable since it can support full spatial audio while also supporting non-spatial mono and stereo sounds.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.sphere {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.sphere']
  radius float8 [not null, default: 1, note: 'Indicates the sphere\'s radius. Varying: may carry time samples (animatable).; source: double radius']
  Note: 'Sphere: Defines a primitive sphere centered at the origin. The fallback values for Cube, Sphere, Cone, and Cylinder are set so that they all pack into the same volume/bounds.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.sphere_extent {
  entity_id uuid [not null]
  revision_id bigint [not null]
