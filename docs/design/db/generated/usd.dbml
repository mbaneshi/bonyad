Table usd.skel_binding_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.skel_binding_api']
  skel_animation_source uuid [note: 'Animation source to be bound to Skeleton primitives at or beneath the location at which this property is defined. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel skel:animationSource']
  skel_skeleton uuid [note: 'Skeleton to be bound to this prim and its descendents that possess a mapping and weighting to the joints of the identified Skeleton. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel skel:skeleton']
  primvars_skel_skinning_method text [not null, default: 'classicLinear', note: 'The skinningMethod specifies the skinning method for the prim. Uniform: one value, not time-sampled.; source: uniform token primvars:skel:skinningMethod']
  primvars_skel_geom_bind_transform_m00 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m00); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m01 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m01); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m02 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m02); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m03 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m03); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m10 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m10); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m11 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m11); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m12 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m12); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m13 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m13); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m20 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m20); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m21 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m21); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m22 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m22); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m23 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m23); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m30 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m30); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m31 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m31); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m32 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m32); source: matrix4d primvars:skel:geomBindTransform']
  primvars_skel_geom_bind_transform_m33 float8 [note: 'Encodes the bind-time world space transforms of the prim. Varying: may carry time samples (animatable). (m33); source: matrix4d primvars:skel:geomBindTransform']
  skel_joints text[] [note: 'An (optional) array of tokens defining the list of joints to which jointIndices apply. Uniform: one value, not time-sampled.; source: uniform token[] skel:joints']
  primvars_skel_joint_indices int[] [note: 'Indices into the *joints* attribute of the closest (in namespace) bound Skeleton that affect each point of a PointBased gprim. Varying: may carry time samples (animatable).; source: int[] primvars:skel:jointIndices']
  primvars_skel_joint_weights float8[] [note: 'Weights for the joints that affect each point of a PointBased gprim. Varying: may carry time samples (animatable).; source: float[] primvars:skel:jointWeights']
  skel_blend_shapes text[] [note: 'An array of tokens defining the order onto which blend shape weights from an animation source map onto the *skel:blendShapeTargets* rel of a binding site. Uniform: one value, not time-sampled.; source: uniform token[] skel:blendShapes']
  skel_blend_shape_targets uuid [note: 'Ordered list of all target blend shapes. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel skel:blendShapeTargets']
  Note: 'SkelBindingAPI: Provides API for authoring and extracting all the skinning-related data that lives in the "geometry hierarchy" of prims and models that want to be skeletally deformed. See the extended UsdSkelBindingAPI schema documentation for more about bindings and how they apply in a scene graph.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.skel_root {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.skel_root']
  Note: 'SkelRoot: Boundable prim type used to identify a scope beneath which skeletally-posed primitives are defined. A SkelRoot must be defined at or above a skinned primitive for any skinning behaviors in UsdSkel.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.skeleton {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.skeleton']
  joints text[] [note: 'An array of path tokens identifying the set of joints that make up the skeleton, and their order. Uniform: one value, not time-sampled.; source: uniform token[] joints']
  joint_names text[] [note: 'If authored, provides a unique name per joint. Uniform: one value, not time-sampled.; source: uniform token[] jointNames']
  Note: 'Skeleton: Describes a skeleton. See the extended Skeleton Schema documentation for more information.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

