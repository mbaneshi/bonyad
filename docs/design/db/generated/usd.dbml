  file_path text [note: 'An asset path attribute that points to a file on disk. Varying: may carry time samples (animatable). Holds an asset path.; source: asset filePath']
  field_name text [note: 'Name of an individual field within the file specified by the filePath attribute. Varying: may carry time samples (animatable).; source: token fieldName']
  field_index int [note: 'A file can contain multiple fields with the same name. Varying: may carry time samples (animatable).; source: int fieldIndex']
  field_data_type text [note: 'Token which is used to indicate the data type of an individual field. Varying: may carry time samples (animatable).; source: token fieldDataType']
  vector_data_role_hint text [not null, default: 'None', note: 'Optional token which is used to indicate the role of a vector valued field. Varying: may carry time samples (animatable).; source: token vectorDataRoleHint']
  Note: 'VolumeFieldAsset: Base class for volume field primitives defined by an external file.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table usd.field3d_asset {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.field3d_asset']
  field_purpose text [note: 'Optional token which can be used to indicate the purpose or grouping of an individual field. Varying: may carry time samples (animatable).; source: token fieldPurpose']
  Note: 'Field3DAsset: Field3D field primitive. The FieldAsset filePath attribute must specify a file in the Field3D format on disk.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.generative_procedural {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.generative_procedural']
  procedural_system text [note: 'The name or convention of the system responsible for evaluating the procedural. Varying: may carry time samples (animatable).; source: token proceduralSystem']
  Note: 'GenerativeProcedural: Represents an abstract generative procedural prim which delivers its input parameters via properties (including relationships) within the "primvars:" namespace. It does not itself have any awareness or participation in the execution of the procedural but rather serves as a means of delivering a procedural\'s definition and input parameters.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.geom_model_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.geom_model_api']
  model_draw_mode text [not null, default: 'inherited', note: 'Alternate imaging mode; applied to this prim or child prims where model:applyDrawMode is true, or where the prim has kind component and model:applyDrawMode is not authored. Uniform: one value, not time-sampled.; source: uniform token model:drawMode']
  model_apply_draw_mode boolean [not null, default: false, note: 'If true, and the resolved value of model:drawMode is non-default, apply an alternate imaging mode to this prim. Uniform: one value, not time-sampled.; source: uniform bool model:applyDrawMode']
  model_draw_mode_color_x float8 [not null, default: 0.18, note: 'The base color of imaging prims inserted for alternate imaging modes. Uniform: one value, not time-sampled. (x); source: uniform float3 model:drawModeColor']
  model_draw_mode_color_y float8 [not null, default: 0.18, note: 'The base color of imaging prims inserted for alternate imaging modes. Uniform: one value, not time-sampled. (y); source: uniform float3 model:drawModeColor']
  model_draw_mode_color_z float8 [not null, default: 0.18, note: 'The base color of imaging prims inserted for alternate imaging modes. Uniform: one value, not time-sampled. (z); source: uniform float3 model:drawModeColor']
  model_card_geometry text [not null, default: 'cross', note: 'The geometry to generate for imaging prims inserted for cards imaging mode. Uniform: one value, not time-sampled.; source: uniform token model:cardGeometry']
  model_card_visibility text [not null, default: 'inherited', note: 'When using the cards imaging mode, determines if cards in the upAxis direction should be visible. Uniform: one value, not time-sampled.; source: uniform token model:cardVisibility']
  model_card_texture_x_pos text [note: 'In cards imaging mode, the texture applied to the X+ quad. Varying: may carry time samples (animatable). Holds an asset path.; source: asset model:cardTextureXPos']
  model_card_texture_y_pos text [note: 'In cards imaging mode, the texture applied to the Y+ quad. Varying: may carry time samples (animatable). Holds an asset path.; source: asset model:cardTextureYPos']
  model_card_texture_z_pos text [note: 'In cards imaging mode, the texture applied to the Z+ quad. Varying: may carry time samples (animatable). Holds an asset path.; source: asset model:cardTextureZPos']
  model_card_texture_x_neg text [note: 'In cards imaging mode, the texture applied to the X- quad. Varying: may carry time samples (animatable). Holds an asset path.; source: asset model:cardTextureXNeg']
  model_card_texture_y_neg text [note: 'In cards imaging mode, the texture applied to the Y- quad. Varying: may carry time samples (animatable). Holds an asset path.; source: asset model:cardTextureYNeg']
  model_card_texture_z_neg text [note: 'In cards imaging mode, the texture applied to the Z- quad. Varying: may carry time samples (animatable). Holds an asset path.; source: asset model:cardTextureZNeg']
  Note: 'GeomModelAPI: UsdGeomModelAPI extends the generic UsdModelAPI schema with geometry specific concepts such as cached extents for the entire model, constraint targets, and geometry-inspired extensions to the payload lofting process. As described in GetExtentsHint() below, it is useful to cache extents at the model level.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.geom_subset {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.geom_subset']
  element_type text [not null, default: 'face', note: 'The type of element that the indices target. Uniform: one value, not time-sampled.; source: uniform token elementType']
  indices int[] [note: 'The set of indices identifying elements included in this subset. Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: int[] indices']
  family_name text [not null, default: '', note: 'The name of the family of subsets that this subset belongs to. Uniform: one value, not time-sampled.; source: uniform token familyName']
  Note: 'GeomSubset: Encodes a subset of a piece of geometry (i.e. a UsdGeomImageable) as a set of indices. Currently supports encoding subsets of faces, points, edges, segments, and tetrahedrons.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.geometry_light {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.geometry_light']
  geometry uuid [note: 'Relationship to the geometry to use as the light source. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel geometry']
  light_shader_id text [not null, default: 'GeometryLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  Note: 'GeometryLight: Light emitted outward from a geometric prim (UsdGeomGprim), which is typically a mesh.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.gprim_primvars_display_color {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (color3f), RGB colour stored as x=r, y=g, z=b. Varying: may carry time samples (animatable). (x); source: color3f[] primvars:displayColor']
  value_y float8 [not null, note: 'Element value (color3f), RGB colour stored as x=r, y=g, z=b. Varying: may carry time samples (animatable). (y); source: color3f[] primvars:displayColor']
  value_z float8 [not null, note: 'Element value (color3f), RGB colour stored as x=r, y=g, z=b. Varying: may carry time samples (animatable). (z); source: color3f[] primvars:displayColor']
  Note: 'Gprim.primvars:displayColor: One element of the ordered color3f[] array primvars:displayColor of Gprim. It is useful to have an "official" colorSet that can be used as a display or modeling color, even in the absence of any specified shader for a gprim.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.hermite_curves {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.hermite_curves']
  Note: 'HermiteCurves: This schema specifies a cubic hermite interpolated curve batch as sometimes used for defining guides for animation. While hermite curves can be useful because they interpolate through their control points, they are not well supported by high-end renderers for imaging.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.hermite_curves_tangents {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (x); source: vector3f[] tangents']
  value_y float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (y); source: vector3f[] tangents']
  value_z float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (z); source: vector3f[] tangents']
  Note: 'HermiteCurves.tangents: One element of the ordered vector3f[] array tangents of HermiteCurves. Defines the outgoing trajectory tangent for each point.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.hydra_generative_procedural_api {
