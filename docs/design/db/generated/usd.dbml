  }
}

Table usd.physics_limit_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_limit_api']
  physics_low float8 [note: 'Lower limit. Varying: may carry time samples (animatable). Fallback value is -inf.; source: float limit:<instanceName>:physics:low']
  physics_high float8 [note: 'Upper limit. Varying: may carry time samples (animatable). Fallback value is inf.; source: float limit:<instanceName>:physics:high']
  Note: 'PhysicsLimitAPI: The PhysicsLimitAPI can be applied to a PhysicsJoint and will restrict the movement along an axis. PhysicsLimitAPI is a multipleApply schema: The PhysicsJoint can be restricted along "transX", "transY", "transZ", "rotX", "rotY", "rotZ", "distance".'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.physics_mass_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_mass_api']
  physics_mass float8 [not null, default: 0, note: 'If non-zero, directly specifies the mass of the object. Varying: may carry time samples (animatable).; source: float physics:mass']
  physics_density float8 [not null, default: 0, note: 'If non-zero, specifies the density of the object. Varying: may carry time samples (animatable).; source: float physics:density']
  physics_center_of_mass_x float8 [note: 'Center of mass in the prim\'s local space. Varying: may carry time samples (animatable). (x); source: point3f physics:centerOfMass']
  physics_center_of_mass_y float8 [note: 'Center of mass in the prim\'s local space. Varying: may carry time samples (animatable). (y); source: point3f physics:centerOfMass']
  physics_center_of_mass_z float8 [note: 'Center of mass in the prim\'s local space. Varying: may carry time samples (animatable). (z); source: point3f physics:centerOfMass']
  physics_diagonal_inertia_x float8 [not null, default: 0, note: 'If non-zero, specifies diagonalized inertia tensor along the principal axes. Varying: may carry time samples (animatable). (x); source: float3 physics:diagonalInertia']
  physics_diagonal_inertia_y float8 [not null, default: 0, note: 'If non-zero, specifies diagonalized inertia tensor along the principal axes. Varying: may carry time samples (animatable). (y); source: float3 physics:diagonalInertia']
  physics_diagonal_inertia_z float8 [not null, default: 0, note: 'If non-zero, specifies diagonalized inertia tensor along the principal axes. Varying: may carry time samples (animatable). (z); source: float3 physics:diagonalInertia']
  physics_principal_axes float8[] [note: 'Orientation of the inertia tensor\'s principal axes in the prim\'s local space. (quaternion, four floats) Varying: may carry time samples (animatable). Fallback value in schema.usda: [0,0,0,0].; source: quatf physics:principalAxes']
  Note: 'PhysicsMassAPI: Defines explicit mass properties (mass, density, inertia etc.). MassAPI can be applied to any object that has a PhysicsCollisionAPI or a PhysicsRigidBodyAPI, and takes effect only while that collider or rigid body is enabled.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.physics_material_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_material_api']
  physics_dynamic_friction float8 [not null, default: 0, note: 'Dynamic friction coefficient. Varying: may carry time samples (animatable).; source: float physics:dynamicFriction']
  physics_static_friction float8 [not null, default: 0, note: 'Static friction coefficient. Varying: may carry time samples (animatable).; source: float physics:staticFriction']
