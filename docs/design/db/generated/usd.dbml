  ui_nodegraph_node_display_color_x float8 [note: 'This hint defines what tint the node should have in the node graph. (RGB colour stored as x=r, y=g, z=b) Uniform: one value, not time-sampled. (x); source: uniform color3f ui:nodegraph:node:displayColor']
  ui_nodegraph_node_display_color_y float8 [note: 'This hint defines what tint the node should have in the node graph. (RGB colour stored as x=r, y=g, z=b) Uniform: one value, not time-sampled. (y); source: uniform color3f ui:nodegraph:node:displayColor']
  ui_nodegraph_node_display_color_z float8 [note: 'This hint defines what tint the node should have in the node graph. (RGB colour stored as x=r, y=g, z=b) Uniform: one value, not time-sampled. (z); source: uniform color3f ui:nodegraph:node:displayColor']
  ui_nodegraph_node_icon text [note: 'This points to an image that should be displayed on the node. Uniform: one value, not time-sampled. Holds an asset path.; source: uniform asset ui:nodegraph:node:icon']
  ui_nodegraph_node_expansion_state text [note: 'The current expansionState of the node in the ui. Uniform: one value, not time-sampled.; source: uniform token ui:nodegraph:node:expansionState']
  ui_nodegraph_node_size_x float8 [note: 'Optional size hint for a node in a node graph. Uniform: one value, not time-sampled. (x); source: uniform float2 ui:nodegraph:node:size']
  ui_nodegraph_node_size_y float8 [note: 'Optional size hint for a node in a node graph. Uniform: one value, not time-sampled. (y); source: uniform float2 ui:nodegraph:node:size']
