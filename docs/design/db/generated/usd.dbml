  physics_upper_limit float8 [note: 'Upper limit. Varying: may carry time samples (animatable). Fallback value is inf.; source: float physics:upperLimit']
  Note: 'PhysicsPrismaticJoint: Predefined prismatic joint type (translation along prismatic joint axis is permitted.)'
