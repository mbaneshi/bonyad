    (entity_id, revision_id) [pk]
  }
}

Table usd.dome_light {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.dome_light']
  light_shader_id text [not null, default: 'DomeLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  inputs_texture_file text [note: 'A color texture to use on the dome, such as an HDR (high dynamic range) texture intended for IBL (image based lighting). Varying: may carry time samples (animatable). Holds an asset path.; source: asset inputs:texture:file']
  inputs_texture_format text [not null, default: 'automatic', note: 'Specifies the parameterization of the color map file. Varying: may carry time samples (animatable).; source: token inputs:texture:format']
  portals uuid [note: 'Optional portals to guide light sampling. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel portals']
  guide_radius float8 [not null, default: 100000, note: 'The radius of guide geometry to use to visualize the dome light. Varying: may carry time samples (animatable).; source: float guideRadius']
  Note: 'DomeLight: Light emitted inward from a distant external environment, such as a sky or IBL light probe. In this version of the dome light, the dome\'s default orientation is such that its top pole is aligned with the world\'s +Y axis.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.dome_light_1 {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.dome_light_1']
  light_shader_id text [not null, default: 'DomeLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  inputs_texture_file text [note: 'A color texture to use on the dome, such as an HDR (high dynamic range) texture intended for IBL (image based lighting). Varying: may carry time samples (animatable). Holds an asset path.; source: asset inputs:texture:file']
  inputs_texture_format text [not null, default: 'automatic', note: 'Specifies the parameterization of the color map file. Varying: may carry time samples (animatable).; source: token inputs:texture:format']
  portals uuid [note: 'Optional portals to guide light sampling. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel portals']
  guide_radius float8 [not null, default: 100000, note: 'The radius of guide geometry to use to visualize the dome light. Varying: may carry time samples (animatable).; source: float guideRadius']
  pole_axis text [not null, default: 'scene', note: 'A token which indicates the starting alignment of the dome light\'s top pole. Uniform: one value, not time-sampled.; source: uniform token poleAxis']
  Note: 'DomeLight_1: Light emitted inward from a distant external environment, such as a sky or IBL light probe. In this version of the dome light, the dome\'s default orientation is determined by its *poleAxis* property.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.volume_field_asset {
