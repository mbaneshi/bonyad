  inputs_angle float8 [not null, default: 0.53, note: 'Angular diameter of the light in degrees. Varying: may carry time samples (animatable).; source: float inputs:angle']
  inputs_intensity float8 [not null, default: 50000, note: 'Scales the brightness of the light linearly. Varying: may carry time samples (animatable).; source: float inputs:intensity']
  Note: 'DistantLight: Light emitted from a distant source along the -Z axis. Also known as a directional light.'
