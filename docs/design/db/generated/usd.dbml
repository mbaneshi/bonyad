Table usd.accessibility_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.accessibility_api']
  label text [note: 'A short label to concisely describe the prim. Varying: may carry time samples (animatable).; source: string accessibility:<instanceName>:label']
  description text [note: 'An extended description of the prim to provide more details. Varying: may carry time samples (animatable).; source: string accessibility:<instanceName>:description']
  priority text [not null, default: 'standard', note: 'A hint to the accessibility runtime of how to prioritize this instance\'s label and description, relative to others. Varying: may carry time samples (animatable).; source: token accessibility:<instanceName>:priority']
  Note: 'AccessibilityAPI: This API describes Accessibility information on a Prim that may be surfaced to a given runtime\'s accessibility frameworks. This information may be used by assistive tooling such as voice controls or screen readers.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.asset_previews_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.asset_previews_api']
  Note: 'AssetPreviewsAPI: AssetPreviewsAPI is the interface for authoring and accessing precomputed, lightweight previews of assets. It is an applied schema, which means that an arbitrary number of prims on a stage can have the schema applied and therefore can contain previews; however, to access a stage\'s "default" previews, one consults the stage\'s defaultPrim.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.authorship_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.authorship_api']
  software_package text [note: 'The tool or system that most directly wrote the USD data for this prim. Uniform: one value, not time-sampled.; source: uniform string authorship:<instanceName>:softwarePackage']
  software_version text [note: 'The version of the softwarePackage that created this record, not of the asset. Uniform: one value, not time-sampled.; source: uniform string authorship:<instanceName>:softwareVersion']
  digital_source_type text [note: 'A URI describing the nature of the creative process, such as whether the content is human-made or AI-generated. Uniform: one value, not time-sampled.; source: uniform string authorship:<instanceName>:digitalSourceType']
  creator text[] [note: 'Human-readable names of the artists, studios, or services that contributed to this authoring step. Uniform: one value, not time-sampled.; source: uniform string[] authorship:<instanceName>:creator']
  description text [note: 'Free-form description of how the prim was created. Uniform: one value, not time-sampled.; source: uniform string authorship:<instanceName>:description']
  inputs text[] [note: 'The inputs that shaped this authoring step, as flattened (name, value) pairs. Uniform: one value, not time-sampled.; source: uniform string[] authorship:<instanceName>:inputs']
  created text [note: 'An ISO 8601 timestamp indicating when this authoring step occurred (e.g., 2025-02-16T12:03:17+01:00), which may differ from the original creation time of the asset. Uniform: one value, not time-sampled.; source: uniform string authorship:<instanceName>:created']
  instance_id text [note: 'A unique identifier for this run\'s output, such as a single generative AI result. Uniform: one value, not time-sampled.; source: uniform string authorship:<instanceName>:instanceID']
  usage_terms text [note: 'The license or usage terms for this asset. Uniform: one value, not time-sampled.; source: uniform string authorship:<instanceName>:usageTerms']
  copyright_owner text[] [note: 'Entities holding copyright in this content, which may differ from creator (e.g., a studio owning an artist\'s work). Uniform: one value, not time-sampled.; source: uniform string[] authorship:<instanceName>:copyrightOwner']
  contact text[] [note: 'Contact information for inquiries about this asset, such as an email address, support URL, or licensing page. Uniform: one value, not time-sampled.; source: uniform string[] authorship:<instanceName>:contact']
  Note: 'AuthorshipAPI: Records who or what authored a prim. Each record describes one authoring step, such as a generative AI run, an export from a DCC, or a manual cleanup session.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

