Table usd.physics_rigid_body_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.physics_rigid_body_api']
  physics_rigid_body_enabled boolean [not null, default: true, note: 'Determines if this PhysicsRigidBodyAPI is enabled. Varying: may carry time samples (animatable).; source: bool physics:rigidBodyEnabled']
  physics_kinematic_enabled boolean [not null, default: false, note: 'Determines whether the body is kinematic or not. Varying: may carry time samples (animatable).; source: bool physics:kinematicEnabled']
  physics_simulation_owner uuid [note: 'Single PhysicsScene that will simulate this body. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel physics:simulationOwner']
  physics_starts_asleep boolean [not null, default: false, note: 'Determines if the body is asleep when the simulation starts. Uniform: one value, not time-sampled.; source: uniform bool physics:startsAsleep']
  physics_velocity_x float8 [not null, default: 0, note: 'Linear velocity in the same space as the node\'s xform. Varying: may carry time samples (animatable). (x); source: vector3f physics:velocity']
  physics_velocity_y float8 [not null, default: 0, note: 'Linear velocity in the same space as the node\'s xform. Varying: may carry time samples (animatable). (y); source: vector3f physics:velocity']
  physics_velocity_z float8 [not null, default: 0, note: 'Linear velocity in the same space as the node\'s xform. Varying: may carry time samples (animatable). (z); source: vector3f physics:velocity']
