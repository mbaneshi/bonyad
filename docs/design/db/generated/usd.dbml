  ui_nodegraph_node_pos_x float8 [note: 'Declared relative position to the parent in a node graph. Uniform: one value, not time-sampled. (x); source: uniform float2 ui:nodegraph:node:pos']
  ui_nodegraph_node_pos_y float8 [note: 'Declared relative position to the parent in a node graph. Uniform: one value, not time-sampled. (y); source: uniform float2 ui:nodegraph:node:pos']
