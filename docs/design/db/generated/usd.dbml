  revision_id bigint [not null]
  kind text [not null, default: 'usd.hydra_generative_procedural_api']
  primvars_hd_gp_procedural_type text [note: 'The registered name of a HdGpGenerativeProceduralPlugin to be executed. Varying: may carry time samples (animatable).; source: token primvars:hdGp:proceduralType']
  procedural_system text [not null, default: 'hydraGenerativeProcedural', note: 'This value should correspond to a configured instance of HdGpGenerativeProceduralResolvingSceneIndex which will evaluate the procedural. Varying: may carry time samples (animatable).; source: token proceduralSystem']
  Note: 'HydraGenerativeProceduralAPI: This API extends and configures the core UsdProcGenerativeProcedural schema defined within usdProc for use with hydra generative procedurals as defined within hdGp.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

