}

Table usd.point_instancer {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.point_instancer']
  prototypes uuid [note: 'Required property . Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel prototypes']
  proto_indices int[] [note: 'Required property . Varying: may carry time samples (animatable).; source: int[] protoIndices']
  ids bigint[] [note: 'Ids are optional; if authored, the ids array should be the same length as the protoIndices array, specifying (at each timeSample if instance identities are changing) the id of each instance. Varying: may carry time samples (animatable).; source: int64[] ids']
  invisible_ids bigint[] [note: 'A list of id\'s to make invisible at the evaluation time. Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: int64[] invisibleIds']
  Note: 'PointInstancer: Encodes vectorized instancing of multiple, potentially animated, prototypes (object/instance masters), which can be arbitrary prims/subtrees on a UsdStage. PointInstancer is a "multi instancer", as it allows multiple prototypes to be scattered among its "points".'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.point_instancer_accelerations {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (x); source: vector3f[] accelerations']
  value_y float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (y); source: vector3f[] accelerations']
  value_z float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (z); source: vector3f[] accelerations']
  Note: 'PointInstancer.accelerations: One element of the ordered vector3f[] array accelerations of PointInstancer. If authored, per-instance \'accelerations\' will be used with velocities to compute positions between samples for the \'positions\' attribute rather than interpolating between neighboring \'positions\' samples.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.point_instancer_angular_velocities {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (x); source: vector3f[] angularVelocities']
  value_y float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (y); source: vector3f[] angularVelocities']
  value_z float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (z); source: vector3f[] angularVelocities']
  Note: 'PointInstancer.angularVelocities: One element of the ordered vector3f[] array angularVelocities of PointInstancer. If authored, per-instance angular velocity vector to be used for interoplating orientations.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.point_instancer_orientations {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value float8[] [not null, note: 'Element value (quath), quaternion, four floats. Varying: may carry time samples (animatable).; source: quath[] orientations']
  Note: 'PointInstancer.orientations: One element of the ordered quath[] array orientations of PointInstancer. If authored, per-instance orientation of each instance about its prototype\'s origin, represented as a unit length quaternion, which allows us to encode it with sufficient precision in a compact GfQuath.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.point_instancer_orientationsf {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value float8[] [not null, note: 'Element value (quatf), quaternion, four floats. Varying: may carry time samples (animatable).; source: quatf[] orientationsf']
  Note: 'PointInstancer.orientationsf: One element of the ordered quatf[] array orientationsf of PointInstancer. If authored, per-instance orientation of each instance about its prototype\'s origin, represented as a unit length quaternion, encoded as a GfQuatf to support higher precision computations.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.point_instancer_positions {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (point3f). Varying: may carry time samples (animatable). (x); source: point3f[] positions']
  value_y float8 [not null, note: 'Element value (point3f). Varying: may carry time samples (animatable). (y); source: point3f[] positions']
  value_z float8 [not null, note: 'Element value (point3f). Varying: may carry time samples (animatable). (z); source: point3f[] positions']
  Note: 'PointInstancer.positions: One element of the ordered point3f[] array positions of PointInstancer. Required property .'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.point_instancer_scales {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (float3). Varying: may carry time samples (animatable). (x); source: float3[] scales']
  value_y float8 [not null, note: 'Element value (float3). Varying: may carry time samples (animatable). (y); source: float3[] scales']
  value_z float8 [not null, note: 'Element value (float3). Varying: may carry time samples (animatable). (z); source: float3[] scales']
  Note: 'PointInstancer.scales: One element of the ordered float3[] array scales of PointInstancer. If authored, per-instance scale to be applied to each instance, before any rotation is applied.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.point_instancer_velocities {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (x); source: vector3f[] velocities']
  value_y float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (y); source: vector3f[] velocities']
  value_z float8 [not null, note: 'Element value (vector3f). Varying: may carry time samples (animatable). (z); source: vector3f[] velocities']
  Note: 'PointInstancer.velocities: One element of the ordered vector3f[] array velocities of PointInstancer. If provided, per-instance \'velocities\' will be used to compute positions between samples for the \'positions\' attribute, rather than interpolating between neighboring \'positions\' samples.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table usd.points {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.points']
  widths float8[] [note: 'Widths are defined as the diameter of the points, in object space. Varying: may carry time samples (animatable).; source: float[] widths']
  ids bigint[] [note: 'Ids are optional; if authored, the ids array should be the same length as the points array, specifying (at each timesample if point identities are changing) the id of each point. Varying: may carry time samples (animatable).; source: int64[] ids']
  Note: 'Points: Points are analogous to the RiPoints spec . Points can be an efficient means of storing and rendering particle effects comprised of thousands or millions of small particles.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.portal_light {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.portal_light']
  light_shader_id text [not null, default: 'PortalLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  inputs_width float8 [not null, default: 1, note: 'Width of the portal rectangle in the local X axis. Varying: may carry time samples (animatable).; source: float inputs:width']
  inputs_height float8 [not null, default: 1, note: 'Height of the portal rectangle in the local Y axis. Varying: may carry time samples (animatable).; source: float inputs:height']
  Note: 'PortalLight: A rectangular portal in the local XY plane that guides sampling of a dome light. Transmits light in the -Z direction.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.primvars_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.primvars_api']
  Note: 'PrimvarsAPI: UsdGeomPrimvarsAPI encodes geometric "primitive variables", as UsdGeomPrimvar, which interpolate across a primitive\'s topology, can override shader inputs, and inherit down namespace. Which Method to Use to Retrieve Primvars While creating primvars is unambiguous (CreatePrimvar()), there are quite a few methods available for retrieving primvars, making it potentially confusing ...'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.rect_light {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.rect_light']
  light_shader_id text [not null, default: 'RectLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  inputs_width float8 [not null, default: 1, note: 'Width of the rectangle, in the local X axis. Varying: may carry time samples (animatable).; source: float inputs:width']
  inputs_height float8 [not null, default: 1, note: 'Height of the rectangle, in the local Y axis. Varying: may carry time samples (animatable).; source: float inputs:height']
  inputs_texture_file text [note: 'A color texture to use on the rectangle. Varying: may carry time samples (animatable). Holds an asset path.; source: asset inputs:texture:file']
  Note: 'RectLight: Light emitted from one side of a rectangle. The rectangle is centered in the XY plane and emits light along the -Z axis.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.render_pass {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.render_pass']
  pass_type text [note: 'A string used to categorize differently structured or executed types of passes within a customized pipeline. Uniform: one value, not time-sampled.; source: uniform token passType']
  command text[] [note: 'The command to run in order to generate renders for this pass. Uniform: one value, not time-sampled.; source: uniform string[] command']
  render_source uuid [note: 'The source prim to render from. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel renderSource']
  input_passes uuid [note: 'The set of other Passes that this Pass depends on in order to be constructed properly. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel inputPasses']
  file_name text [note: 'The asset that contains the rendering prims or other information needed to render this pass. Uniform: one value, not time-sampled. Holds an asset path.; source: uniform asset fileName']
  collection_render_visibility_include_root boolean [not null, default: true, note: 'Property collection:renderVisibility:includeRoot (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform bool collection:renderVisibility:includeRoot']
  collection_camera_visibility_include_root boolean [not null, default: true, note: 'Property collection:cameraVisibility:includeRoot (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform bool collection:cameraVisibility:includeRoot']
  Note: 'RenderPass: A RenderPass prim encapsulates necessary information to generate multi-pass renders. In a multi-pass render, multiple invocations ("passes") of the rendering process are used to generate products using potentially distinct configurations of the stage and renderer.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.render_settings_base {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: usd.render_product, usd.render_settings']
  camera uuid [note: 'The camera relationship specifies the primary camera to use in a render. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel camera']
  resolution int[] [note: 'The image pixel resolution, corresponding to the camera\'s screen window. (fixed length 2) Uniform: one value, not time-sampled. Fallback value in schema.usda: [2048,1080].; source: uniform int2 resolution']
  pixel_aspect_ratio float8 [not null, default: 1, note: '. Uniform: one value, not time-sampled.; source: uniform float pixelAspectRatio']
  aspect_ratio_conform_policy text [not null, default: 'expandAperture', note: 'Indicates the policy to use to resolve an aspect ratio mismatch between the camera aperture and image settings. Uniform: one value, not time-sampled.; source: uniform token aspectRatioConformPolicy']
  data_window_ndc float8[] [note: 'dataWindowNDC specifies the axis-aligned rectangular region in the adjusted aperture window within which the renderer should produce data. (fixed length 4) Uniform: one value, not time-sampled. Fallback value in schema.usda: [0,0,1,1].; source: uniform float4 dataWindowNDC']
  instantaneous_shutter boolean [not null, default: false, note: 'Deprecated - use disableMotionBlur instead. Uniform: one value, not time-sampled.; source: uniform bool instantaneousShutter']
  disable_motion_blur boolean [not null, default: false, note: 'Disable all motion blur by setting the shutter interval of the targeted camera to [0,0] - that is, take only one sample, namely at the current time code. Uniform: one value, not time-sampled.; source: uniform bool disableMotionBlur']
  disable_depth_of_field boolean [not null, default: false, note: 'Disable all depth of field by setting F-stop of the targeted camera to infinity. Uniform: one value, not time-sampled.; source: uniform bool disableDepthOfField']
  Note: 'RenderSettingsBase: Abstract base class that defines render settings that can be specified on either a RenderSettings prim or a RenderProduct prim.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table usd.render_product {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.render_product']
  product_type text [not null, default: 'raster', note: 'The type of output to produce. Uniform: one value, not time-sampled.; source: uniform token productType']
  product_name text [not null, default: '', note: 'Specifies the name that the output/display driver should give the product. Varying: may carry time samples (animatable).; source: token productName']
  ordered_vars uuid [note: 'Specifies the RenderVars that should be consumed and combined into the final product. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel orderedVars']
  Note: 'RenderProduct: A UsdRenderProduct describes an image or other file-like artifact produced by a render. A RenderProduct combines one or more RenderVars into a file or interactive buffer.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.render_settings {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.render_settings']
  products uuid [note: 'The set of RenderProducts the render should produce. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel products']
  included_purposes text[] [note: 'The list of UsdGeomImageable purpose values that should be included in the render. Uniform: one value, not time-sampled. Fallback value in schema.usda: ["default","render"].; source: uniform token[] includedPurposes']
  material_binding_purposes text[] [note: 'Ordered list of material purposes to consider when resolving material bindings in the scene. Uniform: one value, not time-sampled. Fallback value in schema.usda: ["full",""].; source: uniform token[] materialBindingPurposes']
  rendering_color_space text [note: 'Describes a renderer\'s working (linear) colorSpace where all the renderer/shader math is expected to happen. Uniform: one value, not time-sampled.; source: uniform token renderingColorSpace']
  Note: 'RenderSettings: A UsdRenderSettings prim specifies global settings for a render process, including an enumeration of the RenderProducts that should result, and the UsdGeomImageable purposes that should be rendered.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.render_var {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.render_var']
  data_type text [not null, default: 'color3f', note: 'The type of this channel, as a USD attribute type. Uniform: one value, not time-sampled.; source: uniform token dataType']
  source_name text [not null, default: '', note: 'The renderer should look for an output of this name as the computed value for the RenderVar. Uniform: one value, not time-sampled.; source: uniform string sourceName']
  source_type text [not null, default: 'raw', note: 'Indicates the type of the source. Uniform: one value, not time-sampled.; source: uniform token sourceType']
  Note: 'RenderVar: A UsdRenderVar describes a custom data variable for a render to produce. The prim describes the source of the data, which can be a shader output or an LPE (Light Path Expression), and also allows encoding of (generally renderer-specific) parameters that configure the renderer for computing the variable.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.ri_material_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.ri_material_api']
  outputs_ri_surface text [note: 'Property outputs:ri:surface (no description in schema.usda). Varying: may carry time samples (animatable).; source: token outputs:ri:surface']
  outputs_ri_displacement text [note: 'Property outputs:ri:displacement (no description in schema.usda). Varying: may carry time samples (animatable).; source: token outputs:ri:displacement']
  outputs_ri_volume text [note: 'Property outputs:ri:volume (no description in schema.usda). Varying: may carry time samples (animatable).; source: token outputs:ri:volume']
  Note: 'RiMaterialAPI: Materials should use UsdShadeMaterial instead. This schema will be removed in a future release.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.ri_spline_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.ri_spline_api']
  Note: 'RiSplineAPI: This API schema will be removed in a future release. RiSplineAPI is a general purpose API schema used to describe a named spline stored as a set of attributes on a prim.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.scene_graph_prim_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.scene_graph_prim_api']
  ui_display_name text [note: 'When publishing a nodegraph or a material, it can be useful to provide an optional display name, for readability. Uniform: one value, not time-sampled.; source: uniform token ui:displayName']
  ui_display_group text [note: 'When publishing a nodegraph or a material, it can be useful to provide an optional display group, for organizational purposes and readability. Uniform: one value, not time-sampled.; source: uniform token ui:displayGroup']
  Note: 'SceneGraphPrimAPI: Utility schema for display properties of a prim'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.scope {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.scope']
  Note: 'Scope: Scope is the simplest grouping primitive, and does not carry the baggage of transformability. Note that transforms should inherit down through a Scope successfully - it is just a guaranteed no-op from a transformability perspective.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.semantics_labels_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.semantics_labels_api']
  semantics_labels text[] [note: 'Array of labels specified directly at this prim. Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: token[] semantics:labels:<instanceName>:__INSTANCE_NAME__']
  Note: 'SemanticsLabelsAPI: Application of labels for a prim for a taxonomy specified by the schema\'s instance name. See UsdSemanticsLabelsQuery for more information about computations and inheritance of semantics.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.shader {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.shader']
  Note: 'Shader: Base class for all USD shaders. Shaders are the building blocks of shading networks.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.shadow_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.shadow_api']
  inputs_shadow_enable boolean [not null, default: true, note: 'Enables shadows to be cast by this light. Varying: may carry time samples (animatable).; source: bool inputs:shadow:enable']
  inputs_shadow_color_x float8 [not null, default: 0, note: 'The color of shadows cast by the light. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (x); source: color3f inputs:shadow:color']
  inputs_shadow_color_y float8 [not null, default: 0, note: 'The color of shadows cast by the light. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (y); source: color3f inputs:shadow:color']
  inputs_shadow_color_z float8 [not null, default: 0, note: 'The color of shadows cast by the light. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (z); source: color3f inputs:shadow:color']
  inputs_shadow_distance float8 [not null, default: -1, note: 'The maximum distance shadows are cast. Varying: may carry time samples (animatable).; source: float inputs:shadow:distance']
  inputs_shadow_falloff float8 [not null, default: -1, note: 'The size of the shadow falloff zone within the shadow max distance, which can be used to hide the hard cut-off for shadows seen stretching past the max distance. Varying: may carry time samples (animatable).; source: float inputs:shadow:falloff']
  inputs_shadow_falloff_gamma float8 [not null, default: 1, note: 'A gamma (i.e., exponential) control over shadow strength with linear distance within the falloff zone. Varying: may carry time samples (animatable).; source: float inputs:shadow:falloffGamma']
  Note: 'ShadowAPI: Controls to refine a light\'s shadow behavior. These are non-physical controls that are valuable for visual lighting work.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.shaping_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.shaping_api']
  inputs_shaping_focus float8 [not null, default: 0, note: 'A control to shape the spread of light. Varying: may carry time samples (animatable).; source: float inputs:shaping:focus']
  inputs_shaping_focus_tint_x float8 [not null, default: 0, note: 'Off-axis color tint. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (x); source: color3f inputs:shaping:focusTint']
  inputs_shaping_focus_tint_y float8 [not null, default: 0, note: 'Off-axis color tint. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (y); source: color3f inputs:shaping:focusTint']
  inputs_shaping_focus_tint_z float8 [not null, default: 0, note: 'Off-axis color tint. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (z); source: color3f inputs:shaping:focusTint']
  inputs_shaping_cone_angle float8 [not null, default: 90, note: 'Angular limit off the primary axis to restrict the light spread, in degrees. Varying: may carry time samples (animatable).; source: float inputs:shaping:cone:angle']
  inputs_shaping_cone_softness float8 [not null, default: 0, note: 'Controls the cutoff softness for cone angle. Varying: may carry time samples (animatable).; source: float inputs:shaping:cone:softness']
  inputs_shaping_ies_file text [note: 'An IES (Illumination Engineering Society) light profile describing the angular distribution of light. Varying: may carry time samples (animatable). Holds an asset path.; source: asset inputs:shaping:ies:file']
  inputs_shaping_ies_angle_scale float8 [not null, default: 0, note: 'Rescales the angular distribution of the IES profile. Varying: may carry time samples (animatable).; source: float inputs:shaping:ies:angleScale']
  inputs_shaping_ies_normalize boolean [not null, default: false, note: 'Normalizes the IES profile so that it affects the shaping of the light while preserving the overall energy output. Varying: may carry time samples (animatable).; source: bool inputs:shaping:ies:normalize']
  Note: 'ShapingAPI: Controls for shaping a light\'s emission.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

