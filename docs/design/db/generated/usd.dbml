  }
}

Table usd.nurbs_curves {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.nurbs_curves']
  "order" int[] [note: 'Order of the curve. Varying: may carry time samples (animatable). Fallback value in schema.usda: [].; source: int[] order']
  knots float8[] [note: 'Knot vector providing curve parameterization. Varying: may carry time samples (animatable).; source: double[] knots']
  point_weights float8[] [note: 'Optionally provides "w" components for each control point, thus must be the same length as the points attribute. Varying: may carry time samples (animatable).; source: double[] pointWeights']
  Note: 'NurbsCurves: This schema is analagous to NURBS Curves in packages like Maya and Houdini, often used for interchange of rigging and modeling curves. Unlike Maya, this curve spec supports batching of multiple curves into a single prim, widths, and normals in the schema.'
  indexes {
