  kind text [not null, default: 'usd.hydra_render_pass_api']
  hydra_renderer_name text [note: 'The name of the Hydra renderer to use if the user does not otherwise specify one to the application. Uniform: one value, not time-sampled.; source: uniform token hydra:rendererName']
  Note: 'HydraRenderPassAPI: Provides Hydra-specific properties for UsdRenderPass.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.light_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.light_api']
  collection_light_link_include_root boolean [not null, default: true, note: 'Property collection:lightLink:includeRoot (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform bool collection:lightLink:includeRoot']
  collection_shadow_link_include_root boolean [not null, default: true, note: 'Property collection:shadowLink:includeRoot (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform bool collection:shadowLink:includeRoot']
  light_shader_id text [not null, default: '', note: 'Default ID for the light\'s shader. Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  light_material_sync_mode text [not null, default: 'noMaterialResponse', note: 'For a LightAPI applied to geometry that has a bound Material, which is entirely or partly emissive, this specifies the relationship of the Material response to the lighting response. Uniform: one value, not time-sampled.; source: uniform token light:materialSyncMode']
  inputs_intensity float8 [not null, default: 1, note: 'Scales the brightness of the light linearly. Varying: may carry time samples (animatable).; source: float inputs:intensity']
  inputs_exposure float8 [not null, default: 0, note: 'Scales the brightness of the light exponentially as a power of 2 (similar to an F-stop control over exposure). Varying: may carry time samples (animatable).; source: float inputs:exposure']
  inputs_diffuse float8 [not null, default: 1, note: 'A multiplier for the effect of this light on the diffuse response of materials. Varying: may carry time samples (animatable).; source: float inputs:diffuse']
  inputs_specular float8 [not null, default: 1, note: 'A multiplier for the effect of this light on the specular response of materials. Varying: may carry time samples (animatable).; source: float inputs:specular']
  inputs_normalize boolean [not null, default: false, note: 'Normalizes the emission such that the power of the light remains constant while altering the size of the light, by dividing the luminance by the world-space surface area of the light. Varying: may carry time samples (animatable).; source: bool inputs:normalize']
  inputs_color_x float8 [not null, default: 1, note: 'The color of emitted light, in the rendering color space. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (x); source: color3f inputs:color']
  inputs_color_y float8 [not null, default: 1, note: 'The color of emitted light, in the rendering color space. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (y); source: color3f inputs:color']
  inputs_color_z float8 [not null, default: 1, note: 'The color of emitted light, in the rendering color space. (RGB colour stored as x=r, y=g, z=b) Varying: may carry time samples (animatable). (z); source: color3f inputs:color']
  inputs_enable_color_temperature boolean [not null, default: false, note: 'Enables using colorTemperature. Varying: may carry time samples (animatable).; source: bool inputs:enableColorTemperature']
  inputs_color_temperature float8 [not null, default: 6500, note: 'Color temperature, in degrees Kelvin, representing the white point. Varying: may carry time samples (animatable).; source: float inputs:colorTemperature']
  light_filters uuid [note: 'Relationship to the light filters that apply to this light. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel light:filters']
  Note: 'LightAPI: API schema that imparts the quality of being a light onto a prim. A light is any prim that has this schema applied to it.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.light_filter {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: usd.light_filter, usd.plugin_light_filter']
  collection_filter_link_include_root boolean [not null, default: true, note: 'Property collection:filterLink:includeRoot (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform bool collection:filterLink:includeRoot']
  light_filter_shader_id text [not null, default: '', note: 'Default ID for the light filter\'s shader. Uniform: one value, not time-sampled.; source: uniform token lightFilter:shaderId']
  Note: 'LightFilter: A light filter modifies the effect of a light. Lights refer to filters via relationships so that filters may be shared.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table usd.light_list_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.light_list_api']
  light_list uuid [note: 'Relationship to lights in the scene. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel lightList']
  light_list_cache_behavior text [note: 'Controls how the lightList should be interpreted. Varying: may carry time samples (animatable).; source: token lightList:cacheBehavior']
  Note: 'LightListAPI: API schema to support discovery and publishing of lights in a scene. Discovering Lights via Traversal To motivate this API, consider what is required to discover all lights in a scene.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.list_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.list_api']
  light_list uuid [note: 'Relationship to lights in the scene. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel lightList']
  light_list_cache_behavior text [note: 'Controls how the lightList should be interpreted. Varying: may carry time samples (animatable).; source: token lightList:cacheBehavior']
  Note: 'ListAPI: Use LightListAPI instead'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.lod_heuristic {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: usd.lod_distance_heuristic, usd.lod_screen_size_heuristic']
  lod_domain text [note: 'The "domain" of this heuristic. Uniform: one value, not time-sampled.; source: uniform token lod:domain']
  Note: 'LODHeuristic: Base class for LOD Heuristics. Due to the varying nature of the inputs, and potentially outputs, of each heuristic, the method of using the heuristic and the type of value that it returns may be different for each type of heuristic.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table usd.lod_distance_heuristic {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.lod_distance_heuristic']
  center_x float8 [not null, default: 0, note: 'The center point of this LOD Root in local coordinates. Varying: may carry time samples (animatable). (x); source: point3f center']
  center_y float8 [not null, default: 0, note: 'The center point of this LOD Root in local coordinates. Varying: may carry time samples (animatable). (y); source: point3f center']
  center_z float8 [not null, default: 0, note: 'The center point of this LOD Root in local coordinates. Varying: may carry time samples (animatable). (z); source: point3f center']
  bounding_volume uuid [note: 'Optional relationship to a Boundable prim that defines the bounding volume for this LOD Root, the prim\'s extent will be used for distance calculation if it is valid (not empty). Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel boundingVolume']
  thresholds float8[] [note: 'This defines the distance thresholds for LOD transitions in ascending order. Uniform: one value, not time-sampled. Fallback value in schema.usda: [].; source: uniform float[] thresholds']
  blend_thresholds float8[] [note: 'This defines distance thresholds for LOD transitions in ascending order. Uniform: one value, not time-sampled. Fallback value in schema.usda: [].; source: uniform float[] blendThresholds']
  Note: 'LODDistanceHeuristic: This LOD heuristic selects LOD children on the basis of distance from the view point to the LOD root. The LOD child selected is determined by the comparing the computed distance with the values in thresholds and blendThresholds.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.lod_override_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.lod_override_api']
  lod_override_mode text [not null, default: 'inherited', note: 'How to apply override to LOD decisions. Varying: may carry time samples (animatable).; source: token lod:override:mode']
  lod_override_index float8 [not null, default: 0, note: 'The index value to use when lod:override:mode is "indexedLOD". Varying: may carry time samples (animatable).; source: float lod:override:index']
  Note: 'LODOverrideAPI: API for overriding Level of Detail (LOD) choices. This API schema defines an LOD override for namespace descendents.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.lod_root_api {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.lod_root_api']
  lod_default_index int [not null, default: 0, note: 'The LOD item child to use if none of the heuristics are understood by the renderer or if none return a usable LOD. Varying: may carry time samples (animatable).; source: int lod:default:index']
  lod_heuristics uuid [note: 'Relationship targeting all the heuristic prims that could be used for this particular LOD root. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel lod:heuristics']
  Note: 'LODRootAPI: API for configuring Level of Detail (LOD) facilities on a prim. This API schema marks a prim as the root of an LOD selection hierarchy.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.lod_screen_size_heuristic {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.lod_screen_size_heuristic']
  bounding_volume uuid [note: 'Optional relationship to a Boundable prim that defines the bounding volume for this LOD Root, used for size calculation if the referenced prim has a valid extent. Relationship: targets are prim or property paths and USD allows several.; ref to any; source: rel boundingVolume']
  projection_method text [not null, default: 'projectedSphere', note: 'Defines how screen size is calculated. Uniform: one value, not time-sampled.; source: uniform token projectionMethod']
  thresholds float8[] [note: 'The screen size thresholds for LOD transitions in descending order as a fraction of the viewport size. Uniform: one value, not time-sampled. Fallback value in schema.usda: [].; source: uniform float[] thresholds']
  blend_thresholds float8[] [note: 'This defines screen size thresholds for LOD transitions in descending order. Uniform: one value, not time-sampled. Fallback value in schema.usda: [].; source: uniform float[] blendThresholds']
  Note: 'LODScreenSizeHeuristic: This LOD heuristic selects LOD children on the basis of the fraction of the viewplane would be covered by the extent. The LOD child selected is determined by the comparing the computed screen size with the values in thresholds and blendThresholds.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.lod_screen_size_heuristic_extent {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  value_x float8 [not null, note: 'Element value (float3). Varying: may carry time samples (animatable). (x); source: float3[] extent']
  value_y float8 [not null, note: 'Element value (float3). Varying: may carry time samples (animatable). (y); source: float3[] extent']
  value_z float8 [not null, note: 'Element value (float3). Varying: may carry time samples (animatable). (z); source: float3[] extent']
  Note: 'LODScreenSizeHeuristic.extent: One element of the ordered float3[] array extent of LODScreenSizeHeuristic. The extent of this LOD Root in local coordinates.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

