Table usd.cylinder_light {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.cylinder_light']
  light_shader_id text [not null, default: 'CylinderLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  inputs_length float8 [not null, default: 1, note: 'Length of the cylinder, in the local X axis. Varying: may carry time samples (animatable).; source: float inputs:length']
  inputs_radius float8 [not null, default: 0.5, note: 'Radius of the cylinder. Varying: may carry time samples (animatable).; source: float inputs:radius']
  treat_as_line boolean [not null, default: false, note: 'A hint that this light can be treated as a \'line\' light (effectively, a zero-radius cylinder) by renderers that benefit from non-area lighting. Varying: may carry time samples (animatable).; source: bool treatAsLine']
  Note: 'CylinderLight: Light emitted outward from a cylinder. The cylinder is centered at the origin and has its major axis on the X axis.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.disk_light {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.disk_light']
  light_shader_id text [not null, default: 'DiskLight', note: 'Property light:shaderId (no description in schema.usda). Uniform: one value, not time-sampled.; source: uniform token light:shaderId']
  inputs_radius float8 [not null, default: 0.5, note: 'Radius of the disk. Varying: may carry time samples (animatable).; source: float inputs:radius']
  Note: 'DiskLight: Light emitted from one side of a circular disk. The disk is centered in the XY plane and emits light along the -Z axis.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.distant_light {
  entity_id uuid [not null]
  revision_id bigint [not null]
