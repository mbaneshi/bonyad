Table usd.capsule {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.capsule']
  height float8 [not null, default: 1, note: 'The length of the capsule\'s spine along the specified axis excluding the size of the two half spheres, i.e. the length of the cylinder portion of the capsule. Varying: may carry time samples (animatable).; source: double height']
  radius float8 [not null, default: 0.5, note: 'The radius of the capsule. Varying: may carry time samples (animatable).; source: double radius']
  axis text [not null, default: 'Z', note: 'The axis along which the spine of the capsule is aligned Uniform: one value, not time-sampled.; source: uniform token axis']
  Note: 'Capsule: Defines a primitive capsule, i.e. a cylinder capped by two half spheres, centered at the origin, whose spine is along the specified axis. The spherical cap heights (sagitta) of the two endcaps are a function of the relative radii of the endcaps, such that cylinder tangent and sphere tangent are coincident and maintain C1 continuity.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table usd.capsule_1 {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'usd.capsule_1']
  height float8 [not null, default: 1, note: 'The length of the capsule\'s spine along the specified axis excluding the size of the two half spheres, i.e. the length of the cylinder portion of the capsule. Varying: may carry time samples (animatable).; source: double height']
  radius_top float8 [not null, default: 0.5, note: 'The radius of the capping sphere at the top of the capsule - i.e. the sphere in the direction of the positive axis. Varying: may carry time samples (animatable).; source: double radiusTop']
  radius_bottom float8 [not null, default: 0.5, note: 'The radius of the capping sphere at the bottom of the capsule - i.e. the sphere located in the direction of the negative axis. Varying: may carry time samples (animatable).; source: double radiusBottom']
  axis text [not null, default: 'Z', note: 'The axis along which the spine of the capsule is aligned Uniform: one value, not time-sampled.; source: uniform token axis']
  Note: 'Capsule_1: Defines a primitive capsule, i.e. a cylinder capped by two half spheres, with potentially different radii, centered at the origin, and whose spine is along the specified axis. The spherical cap heights (sagitta) of the two endcaps are a function of the relative radii of the endcaps, such that cylinder tangent and sphere tangent are coincident and maintain C1 continuity.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

