  md_file_id uuid [not null, note: 'gpkg_metadata table id column value for the metadata to which this gpkg_metadata_reference applies.; ref to gis.gpkg_metadata; source: gpkg_metadata_reference.md_file_id INTEGER -> gpkg_metadata.id']
  md_parent_id uuid [note: 'gpkg_metadata table id column value for the hierarchical parent gpkg_metadata for the gpkg_metadata to which this gpkg_metadata_reference applies, or NULL if md_file_id forms the root of a metadata hierarchy.; ref to gis.gpkg_metadata; source: gpkg_metadata_reference.md_parent_id INTEGER -> gpkg_metadata.id']
  Note: 'gpkg_metadata_reference: Metadata extension: links a gpkg_metadata document to the whole file, a table, a column, a row or a row/column cell, optionally with a hierarchical parent.'
