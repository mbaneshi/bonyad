  Note: 'gpkg_data_columns: Schema extension: human-readable name, title, description, MIME type and value constraint for a column of a content table.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.gpkg_extensions {
  entity_id uuid [not null]
