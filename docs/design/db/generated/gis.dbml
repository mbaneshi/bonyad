  mime_type text [not null, default: 'text/xml', note: 'MIME encoding of metadata.; source: gpkg_metadata.mime_type TEXT']
  metadata text [not null, default: '', note: 'metadata.; source: gpkg_metadata.metadata TEXT']
  Note: 'gpkg_metadata: Metadata extension: one metadata document (for example ISO 19115 XML) with its scope, standard URI and MIME type.'
