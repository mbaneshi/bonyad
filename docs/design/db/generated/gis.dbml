  kind text [not null, default: 'gis.ogr_feature_defn']
  feature_class_name text [not null, note: 'Feature class name, normally used as the layer name.; source: OGRFeatureDefn::pszFeatureClassName']
  geometry_type text [not null, default: 'wkbUnknown', note: 'Geometry type allowed for the features (OGRFeatureDefn::GetGeomType); wkbUnknown means any type. The Z, M and ZM variants are this code plus 1000, 2000 or 3000 and are not separate values here.; source: OGRFeatureDefn::GetGeomType, OGRwkbGeometryType']
  Note: 'OGRFeatureDefn: The schema of a feature class: its name, allowed geometry type, and (through child rows) the attribute fields and geometry fields shared by all its features.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.ogr_field_defn {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  name text [not null, note: 'Field name.; source: OGRFieldDefn::pszName']
  alternative_name text [note: 'Alternative name (alias) of the field, for display.; source: OGRFieldDefn::pszAlternativeName']
  field_type text [not null, note: 'Field type from OGRFieldType.; source: OGRFieldDefn::eType']
  field_subtype text [not null, default: 'OFSTNone', note: 'Restriction hint on the field type (for example OFTInteger with OFSTBoolean).; source: OGRFieldDefn::eSubType']
  justify text [not null, default: 'OJUndefined', note: 'Display justification of the field values.; source: OGRFieldDefn::eJustify']
  width int [not null, default: 0, note: 'Maximum width of the formatted value; zero means variable.; source: OGRFieldDefn::nWidth (\'Zero is variable\')']
  precision int [not null, default: 0, note: 'Number of decimal digits for real fields.; source: OGRFieldDefn::nPrecision']
  default_value text [note: 'Default value expression used when a value is not specified.; source: OGRFieldDefn::pszDefault']
  nullable boolean [not null, default: true, note: 'Whether the field may be null.; source: OGRFieldDefn::bNullable']
  is_unique boolean [not null, default: false, note: 'Whether values must be unique within the layer.; source: OGRFieldDefn::bUnique']
  is_generated boolean [not null, default: false, note: 'Whether the field is a generated (computed) column; tracked by drivers such as GPKG.; source: OGRFieldDefn::m_bGenerated']
  domain uuid [note: 'The single field domain constraining the values, if any; the domain belongs to the dataset.; ref to gis.ogr_field_domain; source: OGRFieldDefn::m_osDomainName']
  comment text [note: 'Free-text field comment.; source: OGRFieldDefn::m_osComment']
  tz_flag int [not null, default: 0, note: 'Time-zone flag of date-time fields: 0 unknown, 1 local time, 2 mixed time zones, 100 UTC, other values encode the offset in 15-minute steps (UTC offset = (flag - 100) * 15 minutes).; source: OGR_TZFLAG_* in ogr_core.h; OGRFieldDefn::m_nTZFlag']
  Note: 'OGRFieldDefn: Definition of one attribute field of a feature class: type, subtype, width and precision, nullability, uniqueness, default and optional field domain. Order within the feature definition is the child position.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table gis.ogr_geom_field_defn {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  name text [not null, note: 'Geometry field name (may be empty for formats with a single anonymous geometry).; source: OGRGeomFieldDefn::pszName']
  geometry_type text [not null, default: 'wkbUnknown', note: 'Geometry type allowed in this field; all values possible except wkbNone. Z/M variants are carried by the code offsets 1000/2000/3000.; source: OGRGeomFieldDefn::eGeomType']
  spatial_reference uuid [note: 'Spatial reference system of the field; null when unknown.; ref to gis.spatial_reference; source: OGRGeomFieldDefn::poSRS']
  nullable boolean [not null, default: true, note: 'Whether the geometry may be null.; source: OGRGeomFieldDefn::bNullable']
  xy_resolution float8 [note: 'Resolution of the X and Y coordinates in the units of the SRS X/Y axes (1e-3 on a metre CRS is 1 mm); null when unknown (the header uses 0 for unknown).; source: OGRGeomCoordinatePrecision::dfXYResolution']
  z_resolution float8 [note: 'Resolution of the Z coordinate in the units of the SRS Z axis; null when unknown.; source: OGRGeomCoordinatePrecision::dfZResolution']
  m_resolution float8 [note: 'Resolution of the M coordinate; null when unknown.; source: OGRGeomCoordinatePrecision::dfMResolution']
  Note: 'OGRGeomFieldDefn: Definition of one geometry field of a feature class: allowed geometry type, spatial reference system, nullability and coordinate precision.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table gis.ogr_glob_field_domain {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'gis.ogr_glob_field_domain']
  glob text [not null, note: 'The glob pattern the values must match.; source: OGRGlobFieldDomain::m_osGlob']
  Note: 'OGRGlobFieldDomain: A domain that constrains values to those matching a glob pattern (used by GeoPackage).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.ogr_layer {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'gis.ogr_layer']
  dataset uuid [not null, note: 'The dataset that owns the layer.; ref to gis.gdal_dataset; source: vector_data_model.rst: layers are owned by their GDALDataset']
  definition uuid [not null, note: 'The feature definition (schema) of the layer; the relationship is one-to-one.; ref to gis.ogr_feature_defn; source: vector_data_model.rst: \'always has a one-to-one relationship to an OGRFeatureDefn\'']
  Note: 'OGRLayer: A layer of features inside a dataset; all its features share one OGRFeatureDefn.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.ogr_range_field_domain {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'gis.ogr_range_field_domain']
  min_value text [note: 'Lower bound as text (the header stores it in a union typed by the field type); absent when unbounded.; source: OGRRangeFieldDomain::m_sMin']
  min_is_inclusive boolean [not null, default: true, note: 'Whether the lower bound itself is allowed.; source: OGRRangeFieldDomain::m_bMinIsInclusive']
  max_value text [note: 'Upper bound as text; absent when unbounded.; source: OGRRangeFieldDomain::m_sMax']
  max_is_inclusive boolean [not null, default: true, note: 'Whether the upper bound itself is allowed.; source: OGRRangeFieldDomain::m_bMaxIsInclusive']
  Note: 'OGRRangeFieldDomain: A domain that constrains numeric or date values to a range with optionally inclusive bounds.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.point {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'gis.point']
  x float8 [not null, note: 'X coordinate (easting or longitude) in the units of the geometry\'s CRS; not converted to radians because the unit belongs to the CRS axis, not to the geometry.; source: SFA 6.1.4 Point.X()']
  y float8 [not null, note: 'Y coordinate (northing or latitude) in the units of the geometry\'s CRS.; source: SFA 6.1.4 Point.Y()']
  z float8 [note: 'Z coordinate (typically altitude or elevation); present only when the owning geometry has_z is true.; source: SFA 6.1.4 Point.Z(), NIL if absent']
  m float8 [note: 'M coordinate (a measurement); present only when the owning geometry has_m is true.; source: SFA 6.1.4 Point.M(), NIL if absent']
  Note: 'Point: A single location in coordinate space with x and y and optionally z and m.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.polygon {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: gis.polygon, gis.triangle']
  Note: 'Polygon: A planar surface defined by one exterior boundary and zero or more interior boundaries, each a LinearRing (closed simple LineString).'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table gis.polyhedralsurface {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: gis.polyhedralsurface, gis.tin']
  Note: 'PolyhedralSurface: A contiguous collection of Polygon patches that share common boundary segments; if closed it bounds a solid.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table gis.polyhedralsurface_patch {
  entity_id uuid [not null]
  revision_id bigint [not null]
  position int [not null]
  patch uuid [not null, note: 'The polygon forming this patch; a Triangle when the parent is a TIN.; ref to gis.polygon; source: SFA 6.1.12.1']
  Note: 'PolyhedralSurface patch: One Polygon patch of a PolyhedralSurface or TIN, in order.'
  indexes {
    (entity_id, revision_id, position) [pk]
  }
}

Table gis.prime_meridian {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'gis.prime_meridian']
  name text [not null, note: 'Prime meridian name, for example Greenwich.; source: WKT2 <prime meridian name>']
  longitude float8 [not null, note: 'Longitude of the meridian relative to Greenwich, in radians (converted from the WKT angle unit, degrees by default).; source: WKT2 <irm longitude>; PROJ prime_meridian.longitude']
  authority_name text [note: 'Authority that defines this prime meridian, for example EPSG.; source: WKT2 <identifier> ID[authority, code] (7.3.4)']
  authority_code text [note: 'Code of this prime meridian within the authority; text because authorities use both numbers and strings.; source: WKT2 <identifier> ID[authority, code]; PROJ code INTEGER_OR_TEXT']
  Note: 'PrimeMeridian: The meridian from which longitudes are counted, given as a longitude relative to Greenwich.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.spatial_reference {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'gis.spatial_reference']
  name text [not null, note: 'CRS name, for example WGS 84 / UTM zone 32N.; source: WKT2 <crs name>']
  crs_type text [not null, note: 'Kind of CRS (the WKT2 keyword).; source: WKT2 clauses 8-17 keywords; PROJ geodetic_crs.type']
  datum uuid [note: 'Datum of the CRS; absent for projected and compound CRSs, which take it from their base.; ref to gis.datum; source: WKT2 DATUM / TRF; PROJ geodetic_crs.datum_*']
  coordinate_system uuid [note: 'Coordinate system with axes (axis order and units).; ref to gis.coordinate_system; source: WKT2 CS[..]; PROJ *_crs.coordinate_system_*']
  base_crs uuid [note: 'Base CRS of a projected or derived CRS (BASEGEOGCRS).; ref to gis.spatial_reference; source: WKT2 BASEGEOGCRS (9.2); PROJ projected_crs.geodetic_crs_*']
  projection uuid [note: 'Map projection of a projected CRS.; ref to gis.map_projection; source: WKT2 CONVERSION (9.3); PROJ projected_crs.conversion_*']
  horizontal_crs uuid [note: 'Horizontal component of a compound CRS.; ref to gis.spatial_reference; source: WKT2 COMPOUNDCRS (16)']
  vertical_crs uuid [note: 'Vertical component of a compound CRS.; ref to gis.spatial_reference; source: WKT2 COMPOUNDCRS (16)']
  coordinate_epoch float8 [note: 'Epoch to which coordinates are referenced, for a dynamic CRS.; source: WKT2 3.1.6 coordinate epoch; 9.4 / 18 COORDEPOCH']
  axis_mapping_strategy text [not null, default: 'authority_compliant', note: 'How GDAL maps the order of data axes (x,y) to the CRS axis order. Stored coordinates are x,y regardless; this says how to read the CRS.; source: OSRAxisMappingStrategy in ogr_srs_api.h']
  wkt text [note: 'The full WKT2 text of the CRS, as stored by GeoPackage definition_12_063 or read by GDAL; a verbatim copy for exchange, not a replacement for the structured columns.; source: WKT2 7.2; GeoPackage gpkg_spatial_ref_sys.definition_12_063']
  authority_name text [note: 'Authority that defines this CRS, for example EPSG.; source: WKT2 <identifier> ID[authority, code] (7.3.4)']
  authority_code text [note: 'Code of this CRS within the authority; text because authorities use both numbers and strings.; source: WKT2 <identifier> ID[authority, code]; PROJ code INTEGER_OR_TEXT']
  scope text [note: 'Description of the purpose for which the CRS is suitable.; source: WKT2 7.3.3 SCOPE']
  area_description text [note: 'Text description of the area of use.; source: WKT2 7.3.3 AREA']
  Note: 'OGRSpatialReference: A coordinate reference system: how coordinates of a geometry relate to the Earth. It names the datum, the coordinate system with axis order and units, and (for projected CRSs) the map projection.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.tin {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'gis.tin']
  Note: 'TIN: A triangulated irregular network: a PolyhedralSurface consisting only of Triangle patches.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table gis.triangle {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'gis.triangle']
  Note: 'Triangle: A Polygon with three distinct, non-collinear vertices and no interior boundary.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

