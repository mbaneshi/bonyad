  reference_scope text [not null, note: 'Lowercase scope of the target this metadata reference applies to.; source: gpkg_metadata_reference.reference_scope TEXT']
  table_name text [note: 'Name of the table to which this metadata reference applies, or NULL for reference_scope of \'geopackage\'.; source: gpkg_metadata_reference.table_name TEXT']
  column_name text [note: 'For reference_scope of \'column\' or \'row/col\', name of the column to which this metadata reference applies (NULL otherwise).; source: gpkg_metadata_reference.column_name TEXT']
  row_id_value int [note: 'For reference_scope of \'row\' or \'row/col\', the rowid of a row record in the table referenced by table_name (NULL otherwise).; source: gpkg_metadata_reference.row_id_value INTEGER']
