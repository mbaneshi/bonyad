  z text [not null, note: 'Whether z values are prohibited (0), mandatory (1) or optional (2).; source: gpkg_geometry_columns.z TINYINT']
  m text [not null, note: 'Whether m values are prohibited (0), mandatory (1) or optional (2).; source: gpkg_geometry_columns.m TINYINT']
