  srs_id int [not null, note: 'Unique identifier of the SRS within this GeoPackage; the key used by gpkg_contents, gpkg_geometry_columns, gpkg_tile_matrix_set and the GeoPackageBinary header. Reserved: 4326 (WGS-84), -1 (undefined Cartesian), 0 (undefined geographic).; source: gpkg_spatial_ref_sys.srs_id INTEGER (primary key)']
  organization text [not null, note: 'Case-insensitive name of the defining organization e.g. EPSG or epsg.; source: gpkg_spatial_ref_sys.organization TEXT']
  organization_coordsys_id int [not null, note: 'Numeric ID of the Spatial Reference System assigned by the organization.; source: gpkg_spatial_ref_sys.organization_coordsys_id INTEGER']
  definition text [not null, note: 'Well-known Text Representation of the Spatial Reference System.; source: gpkg_spatial_ref_sys.definition TEXT']
  description text [note: 'Human readable description of this SRS.; source: gpkg_spatial_ref_sys.description TEXT']
  definition_12_063 text [note: 'Well-known Text or Representation of the Spatial Reference System.; source: gpkg_spatial_ref_sys_cols_crs_wkt (CRS WKT extension) TEXT']
  epoch float8 [note: 'Coordinate epoch as per https://docs.opengeospatial.org/as/18-005r4/18-005r4.html#68.; source: gpkg_spatial_ref_sys_cols_crs_wkt (CRS WKT extension) DOUBLE']
  Note: 'gpkg_spatial_ref_sys: One spatial reference system (CRS) definition available inside a GeoPackage file; features, tiles and contents point to it by srs_id.'
