  normal_y float8 [not null, default: 0, note: 'Normal. (y); source: group codes 210, 220, 230; no description in the sources']
  normal_z float8 [not null, default: 1, note: 'Normal. (z); source: group codes 210, 220, 230; no description in the sources']
  pattern_name text [not null, note: 'Name for this pattern.; source: group code 2']
  pattern_angle float8 [not null, note: 'Hatch pattern angle (pattern fill only). Radians here; DXF stores degrees.; source: group code 52']
  pattern_scale float8 [not null, note: 'Hatch pattern scale or spacing(pattern fill only).; source: group code 41']
  pattern_type text [not null, note: 'Hatch pattern type; source: group code 76']
  pixel_size float8 [not null, note: 'Pixel size used to determine the density to perform various intersection and ray casting operations in hatch pattern computation for associative hatches and hatches created with the Flood method of hatching; source: group code 47']
  style text [not null, default: 'Normal', note: 'Hatch style.; source: group code 75']
  Note: 'HATCH: The HATCH entity fills a closed area defined by one or more boundary paths by a hatch pattern, a solid fill, or a gradient fill.'
