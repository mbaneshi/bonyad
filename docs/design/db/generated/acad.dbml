  max_extents_y float8 [not null, default: 175.5, note: 'Maximum extents for this layout(defined by EXTMAX while this layout is current). (y); source: group codes 15, 25, 35']
  max_extents_z float8 [not null, default: 0, note: 'Maximum extents for this layout(defined by EXTMAX while this layout is current). (z); source: group codes 15, 25, 35']
  max_limits_x float8 [not null, default: 277, note: 'Maximum limits for this layout(defined by LIMMAX while this layout is current). (x); source: group codes 11, 21']
  max_limits_y float8 [not null, default: 202.5, note: 'Maximum limits for this layout(defined by LIMMAX while this layout is current). (y); source: group codes 11, 21']
  min_extents_x float8 [not null, default: 25.7, note: 'Minimum extents for this layout(defined by EXTMIN while this layout is current). (x); source: group codes 14, 24, 34']
  min_extents_y float8 [not null, default: 19.5, note: 'Minimum extents for this layout(defined by EXTMIN while this layout is current). (y); source: group codes 14, 24, 34']
  min_extents_z float8 [not null, default: 0, note: 'Minimum extents for this layout(defined by EXTMIN while this layout is current). (z); source: group codes 14, 24, 34']
