  y_axis_z float8 [not null, default: 0, note: 'UCS Y-axis. (z); source: group codes 17, 27, 37']
  Note: 'LAYOUT: LAYOUT entity is part of a modelspace or paperspace layout definitions.'
  indexes {
    (entity_id, revision_id) [pk]
