  elevation_x float8 [not null, default: 0, note: 'Z value represents the elevation height of the OCS. (float). (x); source: group codes 10, 20, 30; ezdxf attribute dxf.elevation']
  elevation_y float8 [not null, default: 0, note: 'Z value represents the elevation height of the OCS. (float). (y); source: group codes 10, 20, 30; ezdxf attribute dxf.elevation']
  elevation_z float8 [not null, default: 0, note: 'Z value represents the elevation height of the OCS. (float). (z); source: group codes 10, 20, 30; ezdxf attribute dxf.elevation']
  extrusion_x float8 [not null, default: 0, note: 'Extrusion. (x); source: group codes 210, 220, 230; ezdxf attribute dxf.extrusion; no description in the sources']
  extrusion_y float8 [not null, default: 0, note: 'Extrusion. (y); source: group codes 210, 220, 230; ezdxf attribute dxf.extrusion; no description in the sources']
  extrusion_z float8 [not null, default: 1, note: 'Extrusion. (z); source: group codes 210, 220, 230; ezdxf attribute dxf.extrusion; no description in the sources']
  pattern_name text [not null, default: '', note: 'Pattern name as string.; source: group code 2; ezdxf attribute dxf.pattern_name']
  fill_color int [note: 'Solid fill color as ACI.; source: group code 63; ezdxf attribute dxf.fill_color']
  solid_fill int [not null, default: 0, note: '=== ========================================================== 1 solid fill, better use: MPolygon.set_solid_fill 0 pattern fill, better use: MPolygon.set_pattern_fill === ==========================================================.; source: group code 71; ezdxf attribute dxf.solid_fill']
  hatch_style int [note: 'Hatch style tag is not supported for MPOLYGON!? I don\'t know in which order this tag has to be exported. TrueView does not accept this tag in any place! BricsCAD supports this tag!.; source: group code 75; ezdxf attribute dxf.hatch_style']
  pattern_type int [not null, note: '=== =================== 0 user 1 predefined 2 custom === ===================.; source: group code 76; ezdxf attribute dxf.pattern_type']
  pattern_angle float8 [not null, default: 0, note: 'Actual pattern angle in degrees (float). Changing this value does not rotate the pattern, use MPolygon.set_pattern_angle for this task. Radians here; DXF stores degrees.; source: group code 52; ezdxf attribute dxf.pattern_angle']
  pattern_scale float8 [not null, default: 1, note: 'Actual pattern scaling factor (float). Changing this value does not scale the pattern use MPolygon.set_pattern_scale for this task.; source: group code 41; ezdxf attribute dxf.pattern_scale']
  annotated_boundary int [not null, default: 0, note: 'MPolygon: Boundary annotation flag: 0 = boundary is not an annotated boundary 1 = boundary is an annotated boundary.; source: group code 73; ezdxf attribute dxf.annotated_boundary']
  pattern_double int [not null, default: 0, note: '1 = double pattern size else 0. (int).; source: group code 77; ezdxf attribute dxf.pattern_double']
  pixel_size float8 [note: 'See ... HATCH.; source: group code 47; ezdxf attribute dxf.pixel_size']
  n_seed_points int [not null, default: 0, note: 'N seed points.; source: group code 98; ezdxf attribute dxf.n_seed_points; no description in the sources']
  offset_vector_x float8 [not null, note: 'MPolygon: offset vector in OCS ???. (x); source: group codes 11, 21; ezdxf attribute dxf.offset_vector']
  offset_vector_y float8 [not null, note: 'MPolygon: offset vector in OCS ???. (y); source: group codes 11, 21; ezdxf attribute dxf.offset_vector']
  degenerated_loops int [not null, default: 0, note: 'MPolygon: number of degenerate boundary paths (loops), where a degenerate boundary path is a border that is ignored by the hatch:.; source: group code 99; ezdxf attribute dxf.degenerated_loops']
  Note: 'MPOLYGON: The MPOLYGON entity is not a core DXF entity and is not supported by all CAD applications and DXF libraries.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

