  hotspot_angle float8 [not null, note: 'Hotspot angle. Radians here; DXF stores degrees.; source: group code 50; ezdxf attribute dxf.hotspot_angle; no description in the sources']
  falloff_angle float8 [not null, note: 'Falloff angle. Radians here; DXF stores degrees.; source: group code 51; ezdxf attribute dxf.falloff_angle; no description in the sources']
