Table acad.dimstyle {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'acad.dimstyle']
  flags int [not null, note: 'Standard flags. Bit-coded: 16 XrefDependent, 32 XrefResolved, 64 Referenced.; source: group code 70']
  name text [not null, note: 'Specifies the name of the object; source: group code 2']
  alternate_dimensioning_suffix text [not null, default: '', note: 'Specifies a text prefix or suffix (or both) to the alternate dimension measurement for all types of dimensions except angular (see DIMAPOST System Variable).; source: group code 4']
  alternate_unit_decimal_places int [not null, default: 3, note: 'Controls the number of decimal places in alternate units (see DIMALTD System Variable).; source: group code 171']
  alternate_unit_dimensioning boolean [not null, default: false, note: 'Controls the display of alternate units in dimensions (see DIMALT System Variable).; source: group code 170']
  alternate_unit_format text [not null, default: 'Decimal', note: 'Gets or sets the units format for alternate units of all dimension sub-styles except Angular (see DIMALTU System Variable).; source: group code 273; first in R2000 (ezdxf)']
  alternate_unit_rounding float8 [not null, default: 0, note: 'Rounds off the alternate dimension units (see DIMALTRND System Variable).; source: group code 148; first in R2000 (ezdxf)']
  alternate_unit_scale_factor float8 [not null, default: 25.4, note: 'Controls the multiplier for alternate units (see DIMALTF System Variable).; source: group code 143']
  alternate_unit_tolerance_decimal_places int [not null, default: 3, note: 'Gets or sets the number of decimal places for the tolerance values in the alternate units of a dimension (see DIMALTTD System Variable).; source: group code 274; first in R2000 (ezdxf)']
  alternate_unit_tolerance_zero_handling text [not null, default: 'SuppressZeroFeetAndInches', note: 'Controls suppression of zeros in tolerance values (see DIMALTTZ System Variable).; source: group code 286; first in R2000 (ezdxf)']
  alternate_unit_zero_handling text [not null, default: 'SuppressZeroFeetAndInches', note: 'Controls the suppression of zeros for alternate unit dimension values (see DIMALTZ System Variable).; source: group code 285; first in R2000 (ezdxf)']
  angular_decimal_places int [not null, default: 0, note: 'Controls the number of precision places displayed in angular dimensions (see DIMADEC System Variable).; source: group code 179; first in R2000 (ezdxf)']
  angular_unit text [not null, default: 'DecimalDegrees', note: 'Gets or sets the units format for angular dimensions (see DIMAUNIT System Variable).; source: group code 275; first in R2000 (ezdxf)']
  angular_zero_handling text [not null, default: 'DisplayAll', note: 'Suppresses zeros for angular dimensions (see DIMAZIN System Variable).; source: group code 79; first in R2000 (ezdxf)']
  arc_length_symbol_position text [not null, default: 'BeforeDimensionText', note: 'Controls display of the arc symbol in an arc length dimension (see DIMARCSYM System Variable).; source: group code 90; first in R2000 (ezdxf)']
  arrow_block_id uuid [note: 'Gets or sets the arrowhead block displayed at the ends of dimension lines (see DIMBLK System Variable). Reference; DXF stores the handle.; ref to acad.block_record; source: group code 342 (stored as a handle); first in R2000 (ezdxf)']
  arrow_size float8 [not null, note: 'Controls the size of dimension line and leader line arrowheads. Also controls the size of hook lines (see DIMASZ System Variable).; source: group code 41']
  center_mark_size float8 [not null, default: 0.09, note: 'Controls drawing of circle or arc center marks and centerlines by the DIMCENTER, DIMDIAMETER, and DIMRADIUS commands (see DIMCEN System Variable).; source: group code 141']
  cursor_update boolean [not null, default: false, note: 'Controls options for user-positioned text (see DIMUPT System Variable).; source: group code 288; first in R2000 (ezdxf)']
  decimal_places int [not null, default: 2, note: 'Gets or sets the number of decimal places displayed for the primary units of a dimension (see DIMDEC System Variable).; source: group code 271; first in R2000 (ezdxf)']
  decimal_separator text [not null, note: 'Specifies a single-character decimal separator to use when creating dimensions whose unit format is decimal (see DIMDSEP System Variable).; source: group code 278; first in R2000 (ezdxf)']
  dim_arrow1_id uuid [note: 'Gets or sets the arrowhead for the first end of the dimension line when SeparateArrowBlocks is on (true) (see DIMBLK1 System Variable). Reference; DXF stores the handle.; ref to acad.block_record; source: group code 343 (stored as a handle); first in R2000 (ezdxf)']
  dim_arrow2_id uuid [note: 'Gets or sets the arrowhead for the first end of the dimension line when SeparateArrowBlocks is on (true) (see DIMBLK2 System Variable). Reference; DXF stores the handle.; ref to acad.block_record; source: group code 344 (stored as a handle); first in R2000 (ezdxf)']
  dimension_fit int [not null, note: 'Determines how dimension text and arrows are arranged when space is not sufficient to place both within the extension lines. (see DIMFIT System Variable).; source: group code 287']
  dimension_line_color int [note: 'Gets or sets colors to dimension lines, arrowheads, and dimension leader lines (see DIMCLRD System Variable). as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 176']
  dimension_line_extension float8 [not null, default: 0, note: 'Sets the distance the dimension line extends beyond the extension line when oblique strokes are drawn instead of arrowheads. (see DIMDLE System Variable).; source: group code 46']
  dimension_line_gap float8 [not null, default: 0.625, note: 'Gets or sets the distance around the dimension text when the dimension line breaks to accommodate dimension text (see DIMGAP System Variable).; source: group code 147']
  dimension_line_increment float8 [not null, default: 3.75, note: 'Controls the spacing of the dimension lines in baseline dimensions (see DIMDLI System Variable).; source: group code 43']
  dimension_line_weight text [not null, default: 'ByBlock', note: 'Assigns line weight to dimension lines (see DIMLWD System Variable).; source: group code 371; first in R2000 (ezdxf)']
  dimension_text_arrow_fit text [not null, default: 'BestFit', note: 'Determines how dimension text and arrows are arranged when space is not sufficient to place both within the extension lines. (see DIMATFIT System Variable).; source: group code 289; first in R2000 (ezdxf)']
  dimension_unit int [not null, default: 2, note: 'DIMUNIT (obsolete, now use DIMLUNIT AND DIMFRAC); source: group code 270']
  extension_line_color int [note: 'Gets or sets colors to extension lines, center marks, and centerlines (see DIMCLRE System Variable). as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 177']
  extension_line_extension float8 [not null, default: 1.25, note: 'Specifies how far to extend the extension line beyond the dimension line (see DIMEXE System Variable).; source: group code 44']
  extension_line_offset float8 [not null, default: 0.625, note: 'Specifies how far extension lines are offset from origin points (see DIMEXO System Variable).; source: group code 42']
  extension_line_weight text [not null, default: 'ByBlock', note: 'Assigns line weight to extension lines (see DIMLWE System Variable).; source: group code 372; first in R2000 (ezdxf)']
  fixed_extension_line_length float8 [not null, default: 1, note: 'Sets the total length of the extension lines starting from the dimension line toward the dimension origin (see DIMFXL System Variable).; source: group code 49; first in R2007 (ezdxf)']
  fraction_format text [not null, default: 'Horizontal', note: 'Gets or sets the fraction format when LinearUnitFormat is set to 4 (Architectural) or 5 (Fractional). (see DIMFRAC System Variable).; source: group code 276; first in R2000 (ezdxf)']
  generate_tolerances boolean [not null, default: false, note: 'Appends tolerances to dimension text (see DIMTOL System Variable).; source: group code 71']
  is_extension_line_length_fixed boolean [not null, default: false, note: 'Controls whether extension lines are set to a fixed length (see DIMFXLON System Variable).; source: group code 290; first in R2007 (ezdxf)']
  jogged_radius_dimension_transverse_segment_angle float8 [not null, note: 'Determines the angle of the transverse segment of the dimension line in a jogged radius dimension in radians. (see DIMJOGANG System Variable). Radians here; DXF stores degrees.; source: group code 50; first in R2007 (ezdxf)']
  leader_arrow_id uuid [note: 'Specifies the arrow type for leaders (see DIMLDRBLK System Variable). Reference; DXF stores the handle.; ref to acad.block_record; source: group code 341 (stored as a handle); first in R2000 (ezdxf)']
  limits_generation boolean [not null, default: false, note: 'Generates dimension limits as the default text (see DIMLIM System Variable).; source: group code 72']
  linear_scale_factor float8 [not null, default: 1, note: 'Sets a scale factor for linear dimension measurements (see DIMLFAC System Variable).; source: group code 144']
  linear_unit_format text [not null, default: 'Decimal', note: 'Gets or sets units for all dimension types except Angular (see DIMLUNIT System Variable).; source: group code 277; first in R2000 (ezdxf)']
  line_type_id uuid [note: 'Line type for the main line of the dimension. Reference; DXF stores the handle.; ref to acad.linetype; source: group code 345 (stored as a handle); first in R2007 (ezdxf)']
  line_type_ext1_id uuid [note: 'Line type for the extension line 1. Reference; DXF stores the handle.; ref to acad.linetype; source: group code 346 (stored as a handle); first in R2007 (ezdxf)']
  line_type_ext2_id uuid [note: 'Line type for the extension line 2. Reference; DXF stores the handle.; ref to acad.linetype; source: group code 347 (stored as a handle); first in R2007 (ezdxf)']
  minus_tolerance float8 [not null, default: 0, note: 'Gets or sets the minimum (or lower) tolerance limit for dimension text when GenerateTolerances or LimitsGeneration is on (true). (see DIMTM System Variable).; source: group code 48']
  plus_tolerance float8 [not null, default: 0, note: 'Gets or sets the maximum (or upper) tolerance limit for dimension text when GenerateTolerances or LimitsGeneration is on (true) (see DIMTP System Variable).; source: group code 47']
  post_fix text [not null, default: '', note: 'Specifies a text prefix or suffix (or both) to the dimension measurement (see DIMPOST System Variable).; source: group code 3']
  rounding float8 [not null, default: 0, note: 'Rounds all dimensioning distances to the specified value (see DIMRND System Variable).; source: group code 45']
  scale_factor float8 [not null, note: 'Gets or sets the overall scale factor applied to dimensioning variables that specify sizes, distances, or offsets (see DIMSCALE System Variable).; source: group code 40']
  separate_arrow_blocks boolean [not null, note: 'Controls the display of dimension line arrowhead blocks (see DIMSAH System Variable).; source: group code 173']
  style_id uuid [note: 'Specifies the text style of the dimension (see DIMTXSTY System Variable). Reference; DXF stores the handle.; ref to acad.style; source: group code 340 (stored as a handle); first in R2000 (ezdxf)']
  suppress_first_dimension_line boolean [not null, default: false, note: 'Controls suppression of the first dimension line and arrowhead (see DIMSD1 System Variable).; source: group code 281; first in R2000 (ezdxf)']
  suppress_first_extension_line boolean [not null, default: false, note: 'Suppresses display of the first extension line (see DIMSE1 System Variable).; source: group code 75']
  suppress_outside_extensions boolean [not null, default: false, note: 'Suppresses arrowheads if not enough space is available inside the extension lines (see DIMSOXD System Variable).; source: group code 175']
  suppress_second_dimension_line boolean [not null, default: false, note: 'Controls suppression of the second dimension line and arrowhead (see DIMSD2 System Variable).; source: group code 282; first in R2000 (ezdxf)']
  suppress_second_extension_line boolean [not null, default: false, note: 'Suppresses display of the second extension line (see DIMSE2 System Variable).; source: group code 76']
  text_background_fill_mode text [not null, default: 'NoBackground', note: 'Controls the background of dimension text (see DIMTFILL System Variable).; source: group code 69; first in R2007 (ezdxf)']
  text_color int [note: 'Assigns colors to dimension text (see DIMCLRT System Variable). as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 178']
  text_direction text [not null, default: 'LeftToRight', note: 'Specifies the reading direction of the dimension text (see DIMTXTDIRECTION System Variable).; source: group code 295']
  text_height float8 [not null, note: 'Specifies the height of dimension text, unless the current text style has a fixed height (see DIMTXT System Variable).; source: group code 140']
  text_horizontal_alignment text [not null, default: 'Centered', note: 'Controls the horizontal positioning of dimension text (see DIMJUST System Variable).; source: group code 280; first in R2000 (ezdxf)']
  text_inside_extensions boolean [not null, default: false, note: 'Draws text between extension lines (see DIMTIX System Variable).; source: group code 174']
  text_inside_horizontal boolean [not null, default: false, note: 'Controls the position of dimension text inside the extension lines for all dimension types except Ordinate. (see DIMTIH System Variable).; source: group code 73']
  text_movement text [not null, default: 'MoveLineWithText', note: 'Sets dimension text movement rules (see DIMTMOVE System Variable).; source: group code 279; first in R2000 (ezdxf)']
  text_outside_extensions boolean [not null, note: 'Controls whether a dimension line is drawn between the extension lines even when the text is placed outside. (see DIMTOFL System Variable).; source: group code 172']
  text_outside_horizontal boolean [not null, default: false, note: 'Controls the position of dimension text outside the extension lines (see DIMTOH System Variable).; source: group code 74']
  text_vertical_alignment text [not null, default: 'Above', note: 'Controls the vertical position of text in relation to the dimension line (see DIMTAD System Variable).; source: group code 77']
  text_vertical_position float8 [not null, default: 0, note: 'Controls the vertical position of dimension text above or below the dimension line (see DIMTVP System Variable).; source: group code 145']
  tick_size float8 [not null, default: 0, note: 'Specifies the size of oblique strokes drawn instead of arrowheads for linear, radius, and diameter dimensioning (see DIMTSZ System Variable).; source: group code 142']
  tolerance_alignment text [not null, default: 'Bottom', note: 'Gets or sets the vertical justification for tolerance values relative to the nominal dimension text. (see DIMTOLJ System Variable).; source: group code 283; first in R2000 (ezdxf)']
  tolerance_decimal_places int [not null, default: 2, note: 'Gets or sets the number of decimal places to display in tolerance values for the primary units in a dimension (see DIMTDEC System Variable).; source: group code 272; first in R2000 (ezdxf)']
  tolerance_scale_factor float8 [not null, default: 1, note: 'Specifies a scale factor for the text height of fractions and tolerance values relative to the dimension text height, as set by TextHeight (see DIMTFAC System Variable).; source: group code 146']
  tolerance_zero_handling text [not null, default: 'SuppressDecimalTrailingZeroes', note: 'Controls the suppression of zeros in tolerance values (see DIMTZIN System Variable).; source: group code 284; first in R2000 (ezdxf)']
  zero_handling text [not null, default: 'SuppressDecimalTrailingZeroes', note: 'Controls the suppression of zeros in the primary unit value (see DIMZIN System Variable).; source: group code 78']
  Note: 'DIMSTYLE: Represents a DimensionStyle table entry.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

