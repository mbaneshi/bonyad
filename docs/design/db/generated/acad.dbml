  gradient_color_color_tint float8 [not null, note: 'Color tint value used by dialog code (default = 0, 0; range is 0.0 to 1.0). The color tint value is a gradient color and controls the degree of tint in the dialog when the Hatch group code 452 is set to 1.; source: group code 462']
  gradient_color_name text [not null, note: 'Name of the gradient; source: group code 470']
  is_associative boolean [not null, note: 'Associativity flag.; source: group code 71']
  is_double boolean [not null, note: 'Hatch pattern double flag (pattern fill only); source: group code 77']
  is_solid boolean [not null, note: 'Solid fill flag; source: group code 70']
