  axis_base_point_x float8 [not null, default: 0, note: 'The base point of the helix axis (Vec3). (x); source: group codes 10, 20, 30; ezdxf attribute dxf.axis_base_point']
  axis_base_point_y float8 [not null, default: 0, note: 'The base point of the helix axis (Vec3). (y); source: group codes 10, 20, 30; ezdxf attribute dxf.axis_base_point']
  axis_base_point_z float8 [not null, default: 0, note: 'The base point of the helix axis (Vec3). (z); source: group codes 10, 20, 30; ezdxf attribute dxf.axis_base_point']
  start_point_x float8 [not null, note: 'The starting point of the helix curve (Vec3). This also defines the base radius as the distance from the start point to the axis base point. (x); source: group codes 11, 21, 31; ezdxf attribute dxf.start_point']
  start_point_y float8 [not null, note: 'The starting point of the helix curve (Vec3). This also defines the base radius as the distance from the start point to the axis base point. (y); source: group codes 11, 21, 31; ezdxf attribute dxf.start_point']
  start_point_z float8 [not null, note: 'The starting point of the helix curve (Vec3). This also defines the base radius as the distance from the start point to the axis base point. (z); source: group codes 11, 21, 31; ezdxf attribute dxf.start_point']
  axis_vector_x float8 [not null, default: 0, note: 'Defines the direction of the helix axis (Vec3). (x); source: group codes 12, 22, 32; ezdxf attribute dxf.axis_vector']
  axis_vector_y float8 [not null, default: 0, note: 'Defines the direction of the helix axis (Vec3). (y); source: group codes 12, 22, 32; ezdxf attribute dxf.axis_vector']
  axis_vector_z float8 [not null, default: 1, note: 'Defines the direction of the helix axis (Vec3). (z); source: group codes 12, 22, 32; ezdxf attribute dxf.axis_vector']
  radius float8 [not null, default: 1, note: 'Defines the top radius of the helix (float).; source: group code 40; ezdxf attribute dxf.radius']
  turns float8 [not null, default: 1, note: 'The count of helix turns (float).; source: group code 41; ezdxf attribute dxf.turns']
  turn_height float8 [not null, default: 1, note: 'Defines the pitch (height if one helix turn) of the helix (float).; source: group code 42; ezdxf attribute dxf.turn_height']
  handedness boolean [not null, default: true, note: 'Helix orientation (int).; source: group code 290; ezdxf attribute dxf.handedness']
  constrain int [not null, default: 1, note: '=== ========================= 0 constrain turn height (pitch) 1 constrain count of turns 2 constrain total height === =========================.; source: group code 280; ezdxf attribute dxf.constrain']
  Note: 'HELIX: The HELIX entity.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

