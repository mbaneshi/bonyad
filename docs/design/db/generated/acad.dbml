  major_axis_end_point_y float8 [not null, default: 0, note: 'Endpoint of major axis, relative to the center (in WCS). (y); source: group codes 11, 21, 31']
  major_axis_end_point_z float8 [not null, default: 0, note: 'Endpoint of major axis, relative to the center (in WCS). (z); source: group codes 11, 21, 31']
