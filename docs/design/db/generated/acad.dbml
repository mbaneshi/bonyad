Table acad.mleaderstyle {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'acad.mleaderstyle']
  align_space float8 [not null, default: 0, note: 'Align Space; source: group code 46']
  arrowhead_id uuid [note: 'Gets or sets a BlockRecord representing the arrowhead to be displayed with every leader line. Reference; DXF stores the handle.; ref to acad.block_record; source: group code 341 (stored as a handle)']
  arrowhead_size float8 [not null, default: 0.18, note: 'Gests or sets the arrowhead size.; source: group code 44']
  block_content_id uuid [note: 'Gets a BlockRecord containing elements to be drawn as content for the multileader. Reference; DXF stores the handle.; ref to acad.block_record; source: group code 343 (stored as a handle)']
  block_content_color int [note: 'Gets or sets the block-content color. as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 94']
  block_content_connection text [not null, note: 'Gets or sets a value indicating whether the multileader connects to the content-block extents or to the content-block base point.; source: group code 177']
  block_content_rotation float8 [not null, default: 0, note: 'Gets or sets the block content rotation. Radians here; DXF stores degrees.; source: group code 141']
  block_content_scale_x float8 [not null, note: 'Gets or sets the scale factor along the X-axis for the block content.; source: group code 47']
  block_content_scale_y float8 [not null, note: 'Gets or sets the scale factor applied to the Y-axis of the block content.; source: group code 49']
  block_content_scale_z float8 [not null, note: 'Gets or sets the scale factor along the Z-axis for the block content.; source: group code 140']
  break_gap_size float8 [not null, default: 0.125, note: 'Break Gap Size; source: group code 143']
  content_type text [not null, default: 'MText', note: 'Gets or sets a value indicating the content type for the multileader.; source: group code 170']
  default_text_contents text [not null, default: '', note: 'Gests or sets a default text that is to be set when a mutileader is being created with this MultiLeaderStyle.; source: group code 300']
  description text [not null, default: '', note: 'Gets or sets a text containing the description of this MultiLeaderStyle.; source: group code 3']
  enable_block_content_rotation boolean [not null, note: 'Gets or sets a value indicating whether rotation of the block content is enabled.; source: group code 294']
  enable_block_content_scale boolean [not null, note: 'Gets or sets a value indicating whether scaling of the block content is enabled.; source: group code 293']
  enable_dogleg boolean [not null, default: true, note: 'Gets or sets a value indicating that leader lines are to be drawn with a dogleg.; source: group code 291']
  enable_landing boolean [not null, default: true, note: 'Gets or sets a value indicating whether landing is enabled.; source: group code 290']
  first_segment_angle_constraint float8 [not null, note: 'Gets or sets a snap angle value for the first leader segment when a leader line is being created for the mutileader.; source: group code 40']
  is_annotative boolean [not null, note: 'Is Annotative; source: group code 296']
  landing_distance float8 [not null, default: 0.36, note: 'Gets or sets the landing distance, i.e. the length of the dogleg.; source: group code 43']
  landing_gap float8 [not null, default: 0.09, note: 'Gets or sets the landing gap. This is the distance between the leader end point or, if present, the end of the dogleg and the text label or the content block.; source: group code 42']
  leader_draw_order text [not null, note: 'DrawLeaderOrder Type; source: group code 172']
  leader_line_type_id uuid [note: 'Gets or sets a LineType object specifying line-type properties for the musltileader. This setting applies for all leader lines of the multileader. Reference; DXF stores the handle.; ref to acad.linetype; source: group code 340 (stored as a handle)']
  leader_line_weight text [not null, default: 'ByBlock', note: 'Gets or sets a value specifying the lineweight to be applied to all leader lines of the multileader.; source: group code 92']
  line_color int [note: 'Gets or sets color to be applied all leader lines of the multileader. as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 91']
  max_leader_segments_points int [not null, default: 2, note: 'Gets or sets the max number of segments when a new leader is being created for a multileader.; source: group code 90']
  multi_leader_draw_order text [not null, note: 'DrawMLeaderOrder Type; source: group code 171']
  overwrite_property_value boolean [not null, note: 'Overwrite Property Value; source: group code 295']
  path_type text [not null, note: 'Gets or sets a value indicating whether leaders are to be displayed as polyline, a spline curve or invisible. This setting applies for all leader lines of the multileader.; source: group code 173']
  scale_factor float8 [not null, default: 1, note: 'Gets or sets the scale factor for the ArrowheadSize, LandingDistance, LandingGap, TextHeight, and the elements of BlockContentScale.; source: group code 142']
  second_segment_angle_constraint float8 [not null, note: 'Gets or sets a snap angle value for the second leader segment when a leader line is being created for the mutileader.; source: group code 41']
  text_align_always_left boolean [not null, note: 'Text Align Always Left; source: group code 297']
  text_alignment text [not null, note: 'Gets or sets the text alignment, i.e. the alignment of text lines if the a multiline text label, relative to the TextLocation.; source: group code 176']
  text_angle text [not null, default: 'Horizontal', note: 'Gets or sets a value indicating the text angle.; source: group code 175']
  text_attachment_direction text [not null, note: 'Gets or sets the Text attachment direction for text or block contents, rename? This property defines whether the leaders attach to the left/right of the content block/text, or attach to the top/bottom.; source: group code 271']
  text_bottom_attachment text [not null, note: 'Gets or sets the text bottom attachment type. This value controls the position of the connection point of the leader attached to the bottom of the text label.; source: group code 272']
  text_color int [note: 'Gest or sets the color for the text label of the multileader. as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 93']
  text_frame boolean [not null, note: 'Gets or sets a value indicating that the text label is to be drawn with a frame.; source: group code 292']
  text_height float8 [not null, default: 0.18, note: 'Gets or sets the text height for the text label of the multileader.; source: group code 45']
  text_left_attachment text [not null, note: 'Gets or sets the Text Left Attachment Type. This value controls the position of the connection point of the leader attached to the left side of the text label.; source: group code 174']
  text_right_attachment text [not null, note: 'Gets or sets the Text Right Attachment Type. This value controls the position of the connection point of the leader attached to the right side of the text label.; source: group code 178']
  text_style_id uuid [note: 'Gets or sets the TextStyle to be used to display the text label of the multileader. Reference; DXF stores the handle.; ref to acad.style; source: group code 342 (stored as a handle)']
