  origin_y float8 [not null, default: 0, note: 'UCS origin. (y); source: group codes 13, 23, 33']
  origin_z float8 [not null, default: 0, note: 'UCS origin. (z); source: group codes 13, 23, 33']
  tab_order int [not null, note: 'Tab order. This number is an ordinal indicating this layout\'s ordering in the tab control that is attached to the drawing window. Note that the “Model” tab always appears as the first tab regardless of its tab order.; source: group code 71']
  ucs_id uuid [note: 'UCS Table Record if UCS is a named UCS. Reference; DXF stores the handle.; ref to acad.ucs; source: group code 345 (stored as a handle)']
