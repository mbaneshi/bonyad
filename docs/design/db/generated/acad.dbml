}

Table acad.xrecord {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'acad.xrecord']
  cloning_flags int [not null, note: 'Duplicate record cloning flag (determines how to merge duplicate entries). Bit-coded: 1 KeepExisting, 2 UseClone, 3 XrefName, 4 Name, 5 UnmangleName.; source: group code 280']
  Note: 'XRECORD: Important class for storing application defined data in DXF files.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

