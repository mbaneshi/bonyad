Table acad.mleader {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'acad.mleader']
  arrowhead_id uuid [note: 'Gets or sets a BlockRecord representing the arrowhead (see Arrowhead) to be displayed with every leader line. This property overrides the value from MultiLeaderStyle when the Arrowhead flag is set in the PropertyOverrideFlags property. Reference; DXF stores the handle.; ref to acad.block_record; source: group code 342 (stored as a handle)']
  arrowhead_size float8 [not null, note: 'Gets or sets the arrowhead size (see Arrowhead) for every leader line when the ArrowheadSize flag is set in the PropertyOverrideFlags property.; source: group code 42']
  block_content_id uuid [note: 'Gets a BlockRecord containing elements to be drawn as content for the multileader. This property overrides the value from MultiLeaderStyle when the BlockContent flag is set (see PropertyOverrideFlags property). Reference; DXF stores the handle.; ref to acad.block_record; source: group code 344 (stored as a handle)']
  block_content_color int [note: 'Gets or sets the block-content color. This property overrides the value from MultiLeaderStyle when the BlockContentColor flag is set (see PropertyOverrideFlags property). as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 93']
  block_content_connection text [not null, note: 'Gets or sets a value indicating whether the multileader connects to the content-block extents or to the content-block base point when the BlockContentConnection flag is set in the PropertyOverrideFlags property.; source: group code 176']
  block_content_rotation float8 [not null, note: 'Gets or sets the rotation of the block content of the multileader. Radians here; DXF stores degrees.; source: group code 43']
  block_content_scale_x float8 [not null, note: 'Gets or sets the scale factor for block content. This property overrides the value from MultiLeaderStyle when the BlockContentScale flag is set (see PropertyOverrideFlags property). (x); source: group codes 10, 20, 30']
  block_content_scale_y float8 [not null, note: 'Gets or sets the scale factor for block content. This property overrides the value from MultiLeaderStyle when the BlockContentScale flag is set (see PropertyOverrideFlags property). (y); source: group codes 10, 20, 30']
  block_content_scale_z float8 [not null, note: 'Gets or sets the scale factor for block content. This property overrides the value from MultiLeaderStyle when the BlockContentScale flag is set (see PropertyOverrideFlags property). (z); source: group codes 10, 20, 30']
  content_type text [not null, default: 'None', note: 'Gets or sets a value indicating whether the content of this MultiLeader is a text label, a content block, or a tolerance.; source: group code 172']
  enable_annotation_scale boolean [not null, note: 'Enable Annotation Scale; source: group code 293']
  enable_dogleg boolean [not null, note: 'Gets or sets a value indicating that leader lines of this MultiLeader are to be drawn with a dogleg (see EnableDogleg). This property overrides the value from MultiLeaderStyle when the EnableDogleg flag is set in the PropertyOverrideFlags property.; source: group code 291']
  enable_landing boolean [not null, note: 'Gets or sets a value indicating whether landing is enabled. This property overrides the value from MultiLeaderStyle when the EnableLanding flag is set in the PropertyOverrideFlags property.; source: group code 290']
  extended_to_text boolean [not null, note: 'Leader extended to text; source: group code 295; first in const (ezdxf)']
  landing_distance float8 [not null, note: 'Gets or sets the landing distance, i.e. the length of the dogleg, for this MultiLeader. This property overrides the value from MultiLeaderStyle when the LandingDistance flag is set in the PropertyOverrideFlags property.; source: group code 41']
  leader_line_type_id uuid [note: 'Gets or sets LineType of the leader lines of this MultiLeader (see LeaderLineType). This property overrides the value from MultiLeaderStyle when the LeaderLineType flag is set in the PropertyOverrideFlags property. Reference; DXF stores the handle.; ref to acad.linetype; source: group code 341 (stored as a handle)']
  leader_line_weight text [not null, default: 'ByLayer', note: 'Gets or sets a value specifying the line weight to be applied to all leader lines of this MultiLeader (see LeaderLineWeight). This property overrides the value from MultiLeaderStyle when the LeaderLineWeight flag is set in the PropertyOverrideFlags property.; source: group code 171']
  line_color int [note: 'Gets or sets color of the leader lines of this MultiLeader (see LineColor). This property overrides the value from MultiLeaderStyle when the LineColor flag is set in the PropertyOverrideFlags property. as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 91']
  path_type text [not null, note: 'Gets or sets a value indicating the path type of this MultiLeader (see PathType). This property overrides the value from MultiLeaderStyle when the PathType flag is set in the PropertyOverrideFlags property.; source: group code 170']
  property_override_flags int [not null, note: 'Gets or sets a value containing a list of flags indicating which multileader properties specified by the associated MultiLeaderStyle are to be overridden by properties specified by this MultiLeader or the attached MultiLeaderObjectContextData. Bit-coded: 1 PathType, 2 LineColor, 4 LeaderLineType, 8 LeaderLineWeight, 16 EnableLanding, 32 LandingGap, 64 EnableDogleg, 128 LandingDistance, 256 Arrowhead, 512 ArrowheadSize, 1024 ContentType, 2048 TextStyle, 4096 TextLeftAttachment, 8192 TextAngle, 16384 TextAlignment, 32768 TextColor, 65536 TextHeight, 131072 TextFrame, 262144 EnableUseDefaultMText, 524288 BlockContent, 1048576 BlockContentColor, 2097152 BlockContentScale, 4194304 BlockContentRotation, 8388608 BlockContentConnection, 16777216 ScaleFactor, 33554432 TextRightAttachment, 67108864 TextSwitchAlignmentType, 134217728 TextAttachmentDirection, 268435456 TextTopAttachment, 536870912 TextBottomAttachment.; source: group code 90']
  scale_factor float8 [not null, default: 1, note: 'Gets or sets a scale factor (see ScaleFactor). This property overrides the value from MultiLeaderStyle when the ScaleFactor flag is set (see PropertyOverrideFlags property). The scale factor is applied by AutoCAD.; source: group code 45; first in const (ezdxf)']
  style_id uuid [note: 'Gets a MultiLeaderStyle providing reusable style information for this MultiLeader. Reference; DXF stores the handle.; ref to acad.mleaderstyle; source: group code 340 (stored as a handle)']
  text_alignin_ipe int [not null, note: 'Text Align in IPE (meaning unknown); source: group code 178; first in const (ezdxf)']
  text_alignment text [not null, default: 'Left', note: 'Gets or sets the text alignement type.; source: group code 175']
  text_angle text [not null, default: 'Horizontal', note: 'Gets or sets a value indicating the text angle. This property overrides the value from MultiLeaderStyle when the TextAngle flag is set (see PropertyOverrideFlags property).; source: group code 174']
  text_attachment_direction text [not null, note: 'Gets or sets the Text attachment direction for text or block contents. This property overrides the value from MultiLeaderStyle when the TextAttachmentDirection flag is set in the PropertyOverrideFlags property.; source: group code 271; first in const (ezdxf)']
  text_attachment_point text [not null, note: 'Gets or sets a value indicating the text attachment point.; source: group code 179; first in const (ezdxf)']
  text_bottom_attachment text [not null, note: 'Gets or sets the text bottom attachment type (see TextBottomAttachment). This property override the value from MultiLeaderStyle when the TextBottomAttachment flag is set (see PropertyOverrideFlags property).; source: group code 272; first in const (ezdxf)']
  text_color int [note: 'Gets or sets the color for the display of the text label. This property overrides the value from MultiLeaderStyle when the TextColor flag is set (see PropertyOverrideFlags property). as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 92']
  text_direction_negative boolean [not null, note: 'Text Direction Negative; source: group code 294; first in const (ezdxf)']
  text_frame boolean [not null, note: 'Gets or sets a value indicating that the text label is to be drawn with a frame. This property overrides the value from MultiLeaderStyle when the TextFrame flag is set (see PropertyOverrideFlags property).; source: group code 292']
  text_left_attachment text [not null, note: 'Gets or sets the text left attachment type (see TextLeftAttachment). This property overrides the value from MultiLeaderStyle when the TextLeftAttachment flag is set (see PropertyOverrideFlags property).; source: group code 173']
  text_right_attachment text [not null, note: 'Gets or sets the text right attachment type (see TextRightAttachment). This property overrides the value from MultiLeaderStyle when the TextRightAttachment flag is set (see PropertyOverrideFlags property).; source: group code 95']
  text_style_id uuid [note: 'Gets or sets the TextStyle to be used to display the text label of this MultiLeader. This property overrides the value from MultiLeaderStyle when the TextStyle flag is set in the PropertyOverrideFlags property. Reference; DXF stores the handle.; ref to acad.style; source: group code 343 (stored as a handle)']
  text_top_attachment text [not null, note: 'Gets or sets the text top attachment type (see TextTopAttachment). This property override the value from MultiLeaderStyle when the TextTopAttachment flag is set (see PropertyOverrideFlags property).; source: group code 273; first in const (ezdxf)']
  Note: 'MULTILEADER: The MULTILEADER entity represents one or more leaders, made up of one or more vertices (or spline fit points) and an arrowhead.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

