Table acad.vport {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'acad.vport']
  flags int [not null, note: 'Standard flags. Bit-coded: 16 XrefDependent, 32 XrefResolved, 64 Referenced.; source: group code 70']
  name text [not null, note: 'Specifies the name of the object; source: group code 2']
  bottom_left_x float8 [not null, default: 0, note: 'Lower-left corner of viewport (x); source: group codes 10, 20']
  bottom_left_y float8 [not null, default: 0, note: 'Lower-left corner of viewport (y); source: group codes 10, 20']
  top_right_x float8 [not null, default: 1, note: 'Upper-right corner of viewport (x); source: group codes 11, 21']
  top_right_y float8 [not null, default: 1, note: 'Upper-right corner of viewport (y); source: group codes 11, 21']
  center_x float8 [not null, default: 0, note: 'View center point(in DCS) (x); source: group codes 12, 22']
  center_y float8 [not null, default: 0, note: 'View center point(in DCS) (y); source: group codes 12, 22']
  snap_base_point_x float8 [not null, note: 'Snap base point(in DCS) (x); source: group codes 13, 23']
  snap_base_point_y float8 [not null, note: 'Snap base point(in DCS) (y); source: group codes 13, 23']
  snap_spacing_x float8 [not null, default: 0.5, note: 'Snap spacing X and Y (x); source: group codes 14, 24']
  snap_spacing_y float8 [not null, default: 0.5, note: 'Snap spacing X and Y (y); source: group codes 14, 24']
  grid_spacing_x float8 [not null, default: 10, note: 'Grid spacing X and Y (x); source: group codes 15, 25']
  grid_spacing_y float8 [not null, default: 10, note: 'Grid spacing X and Y (y); source: group codes 15, 25']
  direction_x float8 [not null, note: 'View direction from target point(in WCS) (x); source: group codes 16, 26, 36']
  direction_y float8 [not null, note: 'View direction from target point(in WCS) (y); source: group codes 16, 26, 36']
  direction_z float8 [not null, note: 'View direction from target point(in WCS) (z); source: group codes 16, 26, 36']
  target_x float8 [not null, default: 0, note: 'View target point(in WCS) (x); source: group codes 17, 27, 37']
  target_y float8 [not null, default: 0, note: 'View target point(in WCS) (y); source: group codes 17, 27, 37']
  target_z float8 [not null, default: 0, note: 'View target point(in WCS) (z); source: group codes 17, 27, 37']
  aspect_ratio float8 [not null, default: 1, note: 'Aspect ratio; source: group code 41']
  lens_length float8 [not null, default: 50, note: 'Lens length; source: group code 42']
  front_clipping_plane float8 [not null, default: 0, note: 'Front clipping plane(offset from target point); source: group code 43']
  back_clipping_plane float8 [not null, note: 'Back clipping plane(offset from target point); source: group code 44']
  snap_rotation float8 [not null, note: 'Snap rotation angle. Radians here; DXF stores degrees.; source: group code 50']
  twist_angle float8 [not null, note: 'View twist angle. Radians here; DXF stores degrees.; source: group code 51']
  circle_zoom_percent int [not null, default: 1000, note: 'Circle sides; source: group code 72']
  render_mode text [not null, default: 'Optimized2D', note: 'Render mode; source: group code 281; first in R2000 (ezdxf)']
  view_mode int [not null, default: 16, note: 'View mode(see VIEWMODE system variable). Bit-coded: 1 PerspectiveView, 2 FrontClipping, 4 BackClipping, 8 Follow, 16 FrontClippingZ.; source: group code 71']
  ucs_icon_display text [not null, default: 'OnOrigin', note: 'UCSICON setting; source: group code 74']
  snap_on boolean [not null, note: 'Snap on/off; source: group code 75']
  show_grid boolean [not null, default: true, note: 'Grid on/off; source: group code 76']
  isometric_snap boolean [not null, note: 'Snap style; source: group code 77']
  snap_iso_pair int [not null, note: 'Snap style; source: group code 78']
  origin_x float8 [not null, default: 0, note: 'UCS origin (x); source: group codes 110, 120, 130; first in R2000 (ezdxf)']
  origin_y float8 [not null, default: 0, note: 'UCS origin (y); source: group codes 110, 120, 130; first in R2000 (ezdxf)']
  origin_z float8 [not null, default: 0, note: 'UCS origin (z); source: group codes 110, 120, 130; first in R2000 (ezdxf)']
  x_axis_x float8 [not null, default: 1, note: 'UCS X-axis (x); source: group codes 111, 121, 131; first in R2000 (ezdxf)']
  x_axis_y float8 [not null, default: 0, note: 'UCS X-axis (y); source: group codes 111, 121, 131; first in R2000 (ezdxf)']
  x_axis_z float8 [not null, default: 0, note: 'UCS X-axis (z); source: group codes 111, 121, 131; first in R2000 (ezdxf)']
  y_axis_x float8 [not null, default: 0, note: 'UCS Y-axis (x); source: group codes 112, 122, 132; first in R2000 (ezdxf)']
  y_axis_y float8 [not null, default: 1, note: 'UCS Y-axis (y); source: group codes 112, 122, 132; first in R2000 (ezdxf)']
  y_axis_z float8 [not null, default: 0, note: 'UCS Y-axis (z); source: group codes 112, 122, 132; first in R2000 (ezdxf)']
  named_ucs_id uuid [note: 'Named Ucs. Reference; DXF stores the handle.; ref to acad.ucs; source: group code 345 (stored as a handle); first in R2000 (ezdxf)']
  base_ucs_id uuid [note: 'Base Ucs. Reference; DXF stores the handle.; ref to acad.ucs; source: group code 346 (stored as a handle); first in R2000 (ezdxf)']
  orthographic_type text [not null, default: 'None', note: 'Orthographic type of UCS; source: group code 79; first in R2000 (ezdxf)']
  elevation float8 [not null, note: 'Elevation; source: group code 146; first in R2000 (ezdxf)']
  grid_flags int [not null, note: 'Grid flags. Bit-coded: 1 _1, 2 _2, 4 _3, 8 _4.; source: group code 60; first in R2000 (ezdxf)']
  minor_grid_lines_per_major_grid_line int [not null, default: 5, note: 'Major grid lines; source: group code 61; first in R2007 (ezdxf)']
  visual_style_id uuid [note: 'Visual style object (optional). Reference; DXF stores the handle.; ref to acad.visualstyle; source: group code 348 (stored as a handle); first in R2007 (ezdxf)']
  use_default_lighting boolean [not null, default: true, note: 'Default Lighting On flag; source: group code 292; first in R2007 (ezdxf)']
  default_lighting text [not null, default: 'TwoDistantLights', note: 'Default Lighting type; source: group code 282; first in R2007 (ezdxf)']
  brightness float8 [not null, note: 'Brightness; source: group code 141; first in R2000 (ezdxf)']
  contrast float8 [not null, note: 'Contrast; source: group code 142; first in R2000 (ezdxf)']
  ambient_color int [note: 'Ambient color(only output when non-black) as an AutoCAD Color Index (0 ByBlock, 256 ByLayer, 1 to 255 index, negative = off).; source: group code 63; first in R2000 (ezdxf)']
  ambient_color_true int [note: 'Ambient color(only output when non-black) as a 24-bit true colour (0x00RRGGBB); null when an index colour is used.; source: group code 421; first in R2000 (ezdxf)']
  ambient_color_book text [note: 'Ambient color(only output when non-black): name of the colour-book colour, when one is used.; source: group code 431; first in R2000 (ezdxf)']
  Note: 'VPORT: Represents a VPort table entry.'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table acad.wipeout {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'acad.wipeout']
  Note: 'WIPEOUT: The WIPEOUT entity is a polygonal area that masks underlying objects with the current background color.'
