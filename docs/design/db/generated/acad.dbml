  normal_z float8 [not null, default: 1, note: 'The extrusion vector does not establish an OCS, it is just the normal vector of the ellipse plane:. (z); source: group codes 210, 220, 230; wording from ezdxf']
  radius_ratio float8 [not null, note: 'Ratio of minor axis to major axis.; source: group code 40']
  start_parameter float8 [not null, default: 0, note: 'Start parameter.; source: group code 41']
  thickness float8 [not null, default: 0, note: 'Specifies the distance a 2D object is extruded above or below its elevation.; source: group code 39']
  Note: 'ELLIPSE: The ELLIPSE entity is an elliptic 3D curve defined by the DXF attributes center, the major_axis vector and the extrusion vector.'
