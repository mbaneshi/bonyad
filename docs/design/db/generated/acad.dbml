  first_point_y float8 [not null, note: 'First point(in WCS). (y); source: group codes 10, 20, 30']
  first_point_z float8 [not null, note: 'First point(in WCS). (z); source: group codes 10, 20, 30']
  Note: 'XLINE: The XLINE entity is a construction line that extents to infinity in both directions.'
