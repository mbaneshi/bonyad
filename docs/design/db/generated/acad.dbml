  name text [not null, default: '', note: 'Light name.; source: group code 1; ezdxf attribute dxf.name']
  type int [not null, default: 1, note: 'Light type: 1 = distant 2 = point 3 = spot.; source: group code 70; ezdxf attribute dxf.type']
  status boolean [not null, default: true, note: 'Status.; source: group code 290; ezdxf attribute dxf.status; no description in the sources']
  plot_glyph boolean [not null, default: false, note: 'Plot glyph.; source: group code 291; ezdxf attribute dxf.plot_glyph; no description in the sources']
  intensity float8 [not null, default: 1, note: 'Intensity.; source: group code 40; ezdxf attribute dxf.intensity; no description in the sources']
  location_x float8 [not null, note: 'Light position. (x); source: group codes 10, 20, 30; ezdxf attribute dxf.location']
  location_y float8 [not null, note: 'Light position. (y); source: group codes 10, 20, 30; ezdxf attribute dxf.location']
  location_z float8 [not null, note: 'Light position. (z); source: group codes 10, 20, 30; ezdxf attribute dxf.location']
  target_x float8 [not null, note: 'Target location. (x); source: group codes 11, 21, 31; ezdxf attribute dxf.target']
  target_y float8 [not null, note: 'Target location. (y); source: group codes 11, 21, 31; ezdxf attribute dxf.target']
  target_z float8 [not null, note: 'Target location. (z); source: group codes 11, 21, 31; ezdxf attribute dxf.target']
  attenuation_type int [not null, default: 2, note: 'Attenuation type: 0 = None 1 = Inverse Linear 2 = Inverse Square.; source: group code 72; ezdxf attribute dxf.attenuation_type']
  use_attenuation_limits boolean [not null, default: false, note: 'Use attenuation limits.; source: group code 292; ezdxf attribute dxf.use_attenuation_limits; no description in the sources']
  attenuation_start_limits float8 [not null, note: 'Attenuation start limits.; source: group code 41; ezdxf attribute dxf.attenuation_start_limits; no description in the sources']
