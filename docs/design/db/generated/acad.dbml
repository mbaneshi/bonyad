Table acad.dxf_class {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'acad.dxf_class']
  name text [not null, note: 'Class DXF record name; always unique.; source: group code 1; ezdxf attribute dxf.name']
  cpp_class_name text [not null, note: 'C++ class name. Used to bind with software that defines object class behavior; always unique.; source: group code 2; ezdxf attribute dxf.cpp_class_name']
  app_name text [not null, note: 'Application name. Posted in Alert box when a class definition listed in this section is not currently loaded.; source: group code 3; ezdxf attribute dxf.app_name']
  flags int [not null, default: 0, note: 'Proxy capabilities flag. Bit-coded value that indicates the capabilities of this object as a proxy: 0 = No operations allowed (0) 1 = Erase allowed (0x1) 2 = Transform allowed (0x2) 4 = Color change allowed (0x4) 8 = Layer change allowed (0x8) 16 = Linetype change allowed (0x10) 32 = Linetype scale change allowed (0x20) 64 = Visibility change allowed (0x40) 128 = Cloning allowed (0x80) 256 = Lineweight change allowed (0x100) 512 = Plot Style Name change allowed (0x200) 895 = All operations except cloning allowed (0x37F) 1023 = All operations allowed (0x3FF) 1024 = Disables proxy warning dialog (0x400) 32768 = R13 format proxy (0x8000).; source: group code 90; ezdxf attribute dxf.flags']
  instance_count int [not null, default: 0, note: 'Instance count for a custom class.; source: group code 91; first in R2004; ezdxf attribute dxf.instance_count']
  was_a_proxy int [not null, default: 0, note: 'Was-a-proxy flag. Set to 1 if class was not loaded when this DXF file was created, and 0 otherwise.; source: group code 280; ezdxf attribute dxf.was_a_proxy']
  is_an_entity int [not null, default: 0, note: 'Is-an-entity flag. Set to 1 if class was derived from the AcDbEntity class and can reside in the BLOCKS or ENTITIES section. If 0, instances may appear only in the OBJECTS section.; source: group code 281; ezdxf attribute dxf.is_an_entity']
  Note: 'CLASS: Class (DXF CLASS).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

