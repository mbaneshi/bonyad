Table acad.layer {
  entity_id uuid [not null]
  revision_id bigint [not null]
  kind text [not null, default: 'acad.layer']
  name text [not null, note: 'Layer name.; source: group code 2']
  color int [note: 'AutoCAD Color Index of the layer (group 62); in DXF a negative index means the layer is off, which is carried separately in is_off.; source: group code 62']
  linetype_id uuid [note: 'Default linetype of the layer; DXF stores the linetype name.; ref to acad.linetype; source: group code 6']
  lineweight int [note: 'Default lineweight of the layer in 1/100 mm (group 370).; source: group code 370; first in R2000 (ezdxf)']
  is_off boolean [not null, default: false, note: 'True when the layer is switched off; DXF encodes this as a negative colour index (group 62).; source: group code 62 (negative = off), ezdxf acdb_layer_table_record comment; ACadSharp Layer.Color remarks']
  is_frozen boolean [not null, default: false, note: 'True when the layer is frozen (flag bit 1 of group 70).; source: group code 70, bit 1 (LayerFlags.Frozen)']
  is_locked boolean [not null, default: false, note: 'True when the layer is locked (flag bit 4 of group 70).; source: group code 70, bit 4 (LayerFlags.Locked)']
  plot boolean [not null, default: true, note: 'True when the layer is plotted.; source: group code 290; first in R2000 (ezdxf)']
  Note: 'LAYER: A layer: a named visibility, colour, linetype and plot grouping that entities are assigned to (DXF LAYER table entry).'
  indexes {
    (entity_id, revision_id) [pk]
  }
}

Table acad.plotsettings {
  entity_id uuid [not null]
  revision_id bigint [not null]
  type_code text [not null, note: 'one of: acad.layout, acad.plotsettings']
  denominator_scale float8 [not null, note: 'Denominator of custom print scale: drawing units; source: group code 143']
  flags int [not null, note: 'Plot layout flags. Bit-coded: 1 PlotViewportBorders, 2 ShowPlotStyles, 4 PlotCentered, 8 PlotHidden, 16 UseStandardScale, 32 PlotPlotStyles, 64 ScaleLineweights, 128 PrintLineweights, 512 DrawViewportsFirst, 1024 ModelType, 2048 UpdatePaper, 4096 ZoomToPaperOnUpdate, 8192 Initializing, 16384 PrevPlotInit.; source: group code 70']
  numerator_scale float8 [not null, note: 'Numerator of custom print scale: real world(paper) units; source: group code 142']
  page_name text [not null, default: 'none_device', note: 'Page Setup name; source: group code 1']
  paper_height float8 [not null, default: 210, note: 'Physical paper height in millimeters.; source: group code 45']
  paper_image_origin_x float8 [not null, note: 'Paper image origin: X value; source: group code 148']
  paper_image_origin_y float8 [not null, note: 'Paper image origin: Y value; source: group code 149']
  paper_rotation text [not null, note: 'Plot paper rotation.; source: group code 73']
  paper_size text [not null, default: 'ISO_A4_(210.00_x_297.00_MM)', note: 'Paper size; source: group code 4']
  paper_units text [not null, default: 'Millimeters', note: 'Plot paper units.; source: group code 72']
  paper_width float8 [not null, default: 297, note: 'Physical paper width in millimeters.; source: group code 44']
  plot_origin_x float8 [not null, note: 'Plot origin: X value of origin offset in millimeters; source: group code 46']
  plot_origin_y float8 [not null, note: 'Plot origin: Y value of origin offset in millimeters; source: group code 47']
  plot_type text [not null, default: 'DrawingExtents', note: 'Portion of paper space to output to the media; source: group code 74']
  plot_view_name text [note: 'Plot view name; source: group code 6']
  scaled_fit text [not null, note: 'Standard scale type; source: group code 75']
  shade_plot_dpi int [not null, note: 'Shade plot custom DPI.; source: group code 78']
  shade_plot_mode text [not null, default: 'AsDisplayed', note: 'Plot shade mode.; source: group code 76']
  shade_plot_resolution_mode text [not null, default: 'Draft', note: 'Plot resolution.; source: group code 77']
  standard_scale float8 [not null, default: 1, note: 'A floating point scale factor that represents the standard scale value specified in code 75.; source: group code 147']
  style_sheet text [note: 'Current style sheet; source: group code 7']
  system_printer_name text [note: 'Name of system printer or plot configuration file; source: group code 2']
  window_lower_left_x float8 [not null, note: 'Plot window area: X value of lower-left window corner; source: group code 48']
  window_lower_left_y float8 [not null, note: 'Plot window area: Y value of upper-right window corner; source: group code 49']
  window_upper_left_x float8 [not null, note: 'Plot window area: X value of lower-left window corner; source: group code 140']
  window_upper_left_y float8 [not null, note: 'Plot window area: Y value of upper-right window corner; source: group code 141']
  Note: 'PLOTSETTINGS: All PLOTSETTINGS attributes are part of the DXFLayout entity, I don\'t know if this entity also appears as standalone entity.'
  indexes {
    (entity_id, revision_id) [pk]
    (entity_id, revision_id, type_code) [unique]
  }
}

Table acad.layout {
