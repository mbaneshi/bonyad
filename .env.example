# Bonyad-specific settings. Placeholders only: never commit real secrets.
#
# `just env` (scripts/gen-env) builds the real, untracked `.env` from the vendored
# Supabase example (infra/supabase/.env.example), generates every Supabase secret,
# and then appends this file. Edit `.env`, not this file, for local changes.
# Keep one KEY=value per line with no inline comments: the justfile reads these with grep.

# Host ports, all bound to 127.0.0.1 (shifted away from a default Supabase stack
# that may already be running on 5432/8000/3000/6543).

# Studio and the Supabase API gateway.
API_GW_HTTP_PORT=58000
# Direct Postgres.
BONYAD_DB_PORT=55432
BONYAD_POOLER_SESSION_PORT=55433
BONYAD_POOLER_TXN_PORT=55434

# Agent service (later step). Server-side only: never expose to a browser.
# ANTHROPIC_API_KEY=
# BONYAD_MODEL=claude-opus-5-5
